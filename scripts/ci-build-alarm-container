#!/bin/bash
# Run inside the signed ALARM OCI image, where Flatpak can create namespaces.
# CLONE_NEWUSER is refused from a chroot whose root differs from its mount namespace.
set -euo pipefail
[[ $(uname -m) == aarch64 && $(id -u) == 0 ]]
[[ -e /.dockerenv || -e /run/.containerenv ]]
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
package=${1:?package name required}
[[ $package =~ ^[a-z0-9][a-z0-9-]*$ && -f $root/packages/$package/PKGBUILD ]]
pacman-key --init
pacman-key --populate archlinuxarm
pacman -Syu --noconfirm --needed base-devel git sudo python
id builder >/dev/null 2>&1 || useradd -m builder
printf 'builder ALL=(ALL) NOPASSWD: /usr/bin/pacman\n' > /etc/sudoers.d/aurora-builder
mkdir -p /tmp/package-build
cp -a "$root/packages/$package/." /tmp/package-build/
chown -R builder:builder /tmp/package-build
cd /tmp/package-build
runuser -u builder -- makepkg --syncdeps --noconfirm
mkdir -p "$root/out/packages"
for archive in ./*.pkg.tar.*; do
  name=${archive##*/}
  cp "$archive" "$root/out/packages/${name//:/_}"
done
