#!/bin/bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
package=${1:?package name required}
python3 "$root/scripts/fetch-base.py"
# A disposable native container runs this script as root; host devices are not used.
container=$root/out/container
mkdir -p "$container"
tar --exclude='dev/*' -xpf "$root/cache/base/ArchLinuxARM-aarch64.tar.gz" -C "$container"
# Give libalpm a real root mount in the chroot's mount table so its free-space
# checks resolve the package cache correctly.
mount --bind "$container" "$container"
mkdir -p "$container"/{dev,proc,sys,src}
mount --rbind /dev "$container/dev"
mount -t proc proc "$container/proc"
mount --rbind /sys "$container/sys"
mount --bind "$root" "$container/src"
cp --remove-destination -L /etc/resolv.conf "$container/etc/resolv.conf"
chroot "$container" /bin/bash -euo pipefail -c '
  pacman-key --init
  pacman-key --populate archlinuxarm
  pacman -Syu --noconfirm --needed base-devel git sudo python
  id builder >/dev/null 2>&1 || useradd -m builder
  printf "builder ALL=(ALL) NOPASSWD: /usr/bin/pacman\n" > /etc/sudoers.d/aurora-builder
  mkdir -p /tmp/package-build
  case $1 in
    aurora-models|aurora-capture-ns|whisper-cpp-aurora) cp -aL "/src/packages/$1/." /tmp/package-build/ ;;
    *) cp -a "/src/packages/$1/." /tmp/package-build/ ;;
  esac
  chown -R builder:builder /tmp/package-build
  cd /tmp/package-build
  runuser -u builder -- makepkg --syncdeps --noconfirm
  mkdir -p /src/out/packages
  for archive in ./*.pkg.tar.*; do
    name=${archive##*/}
    cp "$archive" "/src/out/packages/${name//:/_}"
  done
' package "$package"
