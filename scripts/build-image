#!/bin/bash
set -euo pipefail
trap 'status=$?; echo "Aurora image failed ($status) at line $LINENO: $BASH_COMMAND" >&2; exit "$status"' ERR
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source "$root/scripts/testlib.sh"
# An image serves every Mac, whichever one builds it.
export AURORA_DEVICE_TREE_COMPATIBLE=/nonexistent
profile=${1:?arch-kde, arch-gnome or arch-minimal required}
tag=${2:?immutable signed Aurora testing snapshot required}
# The update channel the installed system follows afterwards.
channel=${3:-testing}
[[ $profile =~ ^arch-(kde|gnome|minimal)$ && $tag =~ ^testing-[A-Za-z0-9._-]+$ && $channel =~ ^(testing|stable)$ ]]
[[ $(id -u) == 0 && $(uname -m) == aarch64 ]]
python3 "$root/scripts/fetch-base.py"
output=$root/out/$profile
[[ ! -e $output ]]
mkdir -p "$output"
image=$output/aurora.raw
size=6G
[[ $profile == arch-minimal ]] || size=16G
truncate -s "$size" "$image"
printf 'label: gpt\nsector-size: 4096\n\nstart=2048,size=131072,type=U\nsize=262144,type=BC13C2FF-59E6-4262-A352-B275FD6F7172\ntype=B921B045-1DF0-41C3-AF44-4C6F280D3FAE\n' | sfdisk --sector-size 4096 "$image"
loop=''; mountroot=$(mktemp -d)
cleanup() {
  local status=$? clean=1
  trap - EXIT
  if [[ -x $mountroot/usr/bin/gpgconf && -d $mountroot/etc/pacman.d/gnupg ]]; then
    python3 "$root/scripts/stop-image-key-agents.py" "$mountroot" || true
  fi
  if (( status != 0 )); then python3 "$root/scripts/diagnose-image-mounts.py" /tmp; fi
  for path in dev proc sys run boot/efi boot ''; do
    if mountpoint -q "$mountroot${path:+/$path}"; then umount -R "$mountroot${path:+/$path}" || clean=0; fi
  done
  if (( clean )); then
    [[ -z $loop ]] || losetup -d "$loop"
    rmdir "$mountroot"
  else echo "Image mounts remain at $mountroot" >&2; status=1; fi
  exit "$status"
}
trap cleanup EXIT
loop=$(losetup --find --show --partscan --sector-size 4096 "$image")
udevadm settle
mkfs.vfat -F32 -n AURORA_EFI "${loop}p1"
mkfs.ext4 -F -L AURORA_BOOT "${loop}p2"
mkfs.btrfs -f -L AURORA_ROOT -s 4096 -n 16384 "${loop}p3"
mount "${loop}p3" "$mountroot"
btrfs subvolume create "$mountroot/root"
btrfs subvolume create "$mountroot/home"
umount "$mountroot"
mount -o subvol=root,compress=zstd:1 "${loop}p3" "$mountroot"
bsdtar --exclude='dev/*' -xpf "$root/cache/base/ArchLinuxARM-aarch64.tar.gz" -C "$mountroot"
mkdir -p "$mountroot"/{dev,proc,sys,run,boot/efi}
mount "${loop}p2" "$mountroot/boot"
mkdir -p "$mountroot/boot/efi"
mount "${loop}p1" "$mountroot/boot/efi"
mount --rbind /dev "$mountroot/dev"
mount --make-rslave "$mountroot/dev"
mount -t proc proc "$mountroot/proc"
mount --rbind /sys "$mountroot/sys"
mount --make-rslave "$mountroot/sys"
mount -t tmpfs tmpfs "$mountroot/run"
cp --remove-destination -L /etc/resolv.conf "$mountroot/etc/resolv.conf"
cp "$root/keys/asahi-alarm.gpg" "$root/keys/aurora-alarm.asc" "$mountroot/tmp/"
# A new local build master key authenticates the pinned public repository keys.
chroot "$mountroot" pacman-key --init
chroot "$mountroot" pacman-key --populate archlinuxarm
chroot "$mountroot" pacman-key --add /tmp/asahi-alarm.gpg
chroot "$mountroot" pacman-key --lsign-key 12CE6799A94A3F1B5DDFFE88F576553597FB8FEB
chroot "$mountroot" pacman-key --add /tmp/aurora-alarm.asc
chroot "$mountroot" pacman-key --lsign-key "$(cat "$root/keys/fingerprint.txt")"
python3 - "$mountroot/etc/pacman.conf" "$tag" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]);s=p.read_text();at=s.index('[core]')
s=s[:at]+('[aurora]\nSigLevel = Required DatabaseRequired\nServer = https://github.com/aurora-silicon/alarm-aurora/releases/download/'+sys.argv[2]+'\n\n[asahi-alarm]\nServer = https://github.com/asahi-alarm/asahi-alarm/releases/download/$arch\n\n')+s[at:]
p.write_text(s)
PY
packages=(base sudo bash python btrfs-progs cryptsetup networkmanager-aurora bluez bluez-utils wireless-regdb linux-firmware
  asahi-alarm-keyring aurora-keyring linux-aurora aurora-userpages aurora-boot aurora-firstboot aurora-sep libfprint-aurora aurora-firmware aura uboot-aurora
  avd-fw libva-v4l2-request-avd upower-aurora mesa-aurora vulkan-aurora mesa-aurora-fex-guest aurora-flatpak-gl aurora-system-fixes aurora-logos
  aurora-audio alsa-utils-aurora alsa-ucm-conf-aurora aurora-bless aurora-camera-denoise aurora-kbd-light aurora-fido aurora-sep-sk tiny-dfr pipewire-pulse pipewire-alsa openssh)
case $profile in
  arch-kde) packages+=(plasma-meta plasma-workspace-wallpapers kinfocenter plasma-login-manager konsole dolphin plasma-nm firefox xdg-desktop-portal-kde plasma-setup plymouth plymouth-theme-aurora);;
  arch-gnome) packages+=(mutter-aurora gnome-shell gdm gnome-control-center nautilus gnome-terminal gnome-keyring gvfs firefox xdg-desktop-portal-gnome gnome-initial-setup gnome-backgrounds plymouth plymouth-theme-aurora);;
esac
# GitHub release downloads sometimes stall; finished packages stay cached.
attempt=1
until chroot "$mountroot" pacman -Syu --noconfirm --needed "${packages[@]}"; do
  (( attempt++ < 3 ))
  sleep 30
done
# A fresh Arch root generates no locale, so sessions ran in the C locale and
# gnome-terminal refused to start. Generate a UTF-8 default; first-boot
# setup may change the language afterwards.
sed -i 's/^#\(en_US\.UTF-8 UTF-8\)/\1/' "$mountroot/etc/locale.gen"
grep -q '^en_US\.UTF-8 UTF-8' "$mountroot/etc/locale.gen"
chroot "$mountroot" locale-gen
printf 'LANG=en_US.UTF-8\n' > "$mountroot/etc/locale.conf"
# The generic signed base contains its PC kernel; the installed image uses Aurora.
if chroot "$mountroot" pacman -Q linux-aarch64 >/dev/null 2>&1; then
  chroot "$mountroot" pacman -R --noconfirm linux-aarch64
fi
[[ ! -e $mountroot/etc/mkinitcpio.d/linux-aarch64.preset ]]
chroot "$mountroot" pacman -Q linux-aurora aurora-userpages avd-fw libva-v4l2-request-avd upower-aurora openssh
chroot "$mountroot" pacman -Q alsa-utils-aurora aurora-system-fixes aurora-flatpak-gl mesa-aurora-fex-guest
# The camera filter is on for every user; its install script applies the
# package's user preset.
[[ -L $mountroot/etc/systemd/user/pipewire.service.wants/aurora-camera-denoise.service ]]
# The keyboard backlight follows the light sensor; its install script applies
# the package's system preset.
[[ -L $mountroot/etc/systemd/system/multi-user.target.wants/aurora-kbd-light.service ]]
# The Touch ID security key is opt in: installed, never enabled by the image.
chroot "$mountroot" pacman -Q aurora-fido
[[ ! -e $mountroot/etc/systemd/system/multi-user.target.wants/aurora-fido.service ]]
# Fail the image if any graphics package has escaped the host Mesa version.
mesa_version=$(chroot "$mountroot" pacman -Q mesa-aurora | awk '{print $2}')
for package in vulkan-aurora mesa-aurora-fex-guest aurora-flatpak-gl; do
  [[ $(chroot "$mountroot" pacman -Q "$package" | awk '{print $2}') == "$mesa_version" ]]
done
for branch in 25.08 26.08; do
  chroot "$mountroot" flatpak info --system "org.freedesktop.Platform.GL.aurora/aarch64/$branch"
done
# Stock upower is gone; upower-aurora (which provides upower) replaced it.
refute installed "$mountroot" upower
chroot "$mountroot" userdel -r alarm
chroot "$mountroot" usermod -L root
rm -f "$mountroot/etc/ssh/"ssh_host_* "$mountroot/var/lib/systemd/random-seed"
printf 'uninitialized\n' > "$mountroot/etc/machine-id"
# An install's first boot applies every preset (enable-only, as Arch builds
# systemd). Apply them here, so the image already has what they enable.
chroot "$mountroot" systemctl preset-all --preset-mode=enable-only
chroot "$mountroot" systemctl enable NetworkManager.service bluetooth.service aurora-peripherals.service aurora-alarm-keyring.service aurora-fex-mesa.service
# asahi-scripts' generic first-boot rewrites fstab to its @/@home layout and
# randomizes the ESP ID. Aurora seals both filesystem layout and EFI identity.
chroot "$mountroot" systemctl mask first-boot.service
chroot "$mountroot" systemctl disable systemd-networkd.service systemd-networkd.socket systemd-networkd-wait-online.service
# OpenSSH is installed for owners who want remote login, but sshd stays off
# until they enable it. The ALARM base root enables sshd.service, so turn it
# off here; check-basics.py fails the image if any sshd unit is enabled.
chroot "$mountroot" systemctl disable sshd.service
chroot "$mountroot" systemctl enable systemd-resolved.service
install -d -m 0755 "$mountroot/etc/NetworkManager/conf.d"
printf '[main]\ndns=systemd-resolved\n' > "$mountroot/etc/NetworkManager/conf.d/20-aurora-dns.conf"
ln -sfn /run/systemd/resolve/stub-resolv.conf "$mountroot/etc/resolv.conf"
# Desktop first boot: aurora-firstboot asks for the disk password on the boot
# splash, then the desktop's own setup creates the owner account (Plasma Setup
# on KDE; GDM runs GNOME Initial Setup while no user exists). Minimal images
# keep the text wizard on tty1.
case $profile in
  # Plasma Login Manager, as on Fedora 44: its greeter runs on KWin Wayland,
  # so it is drawn at the display's scale. Arch's SDDM greeter runs on Xorg at
  # 96 DPI and came up at 1x on HiDPI panels.
  arch-kde) chroot "$mountroot" systemctl enable plasmalogin.service plasma-setup.service; chroot "$mountroot" systemctl set-default graphical.target;;
  arch-gnome) chroot "$mountroot" systemctl enable gdm; chroot "$mountroot" systemctl set-default graphical.target;;
  *) chroot "$mountroot" systemctl set-default multi-user.target;;
esac
if [[ $profile == arch-kde ]]; then
  # Plasma Setup writes its setup user's autologin for the display manager
  # whose unit is enabled; only Plasma Login may be the KDE display manager.
  [[ $(chroot "$mountroot" systemctl is-enabled plasmalogin.service) == enabled ]]
  [[ $(readlink "$mountroot/etc/systemd/system/display-manager.service") == */plasmalogin.service ]]
  if chroot "$mountroot" systemctl is-enabled --quiet sddm.service 2>/dev/null; then
    echo 'SDDM is enabled beside Plasma Login' >&2; exit 1
  fi
fi
if [[ $profile == arch-kde ]]; then
  # GDM replaces plymouth-quit.service and quits the splash itself; Plasma
  # Login does neither. Give it GDM's role so the splash lasts until the
  # greeter on every boot. The quit is time-bounded, and a failed greeter
  # still runs plymouth-quit.service, so the splash can never stay up.
  install -d -m 0755 "$mountroot/etc/systemd/system/plasmalogin.service.d"
  cat > "$mountroot/etc/systemd/system/plasmalogin.service.d/10-aurora-plymouth.conf" <<'EOF'
[Unit]
# The splash stays up until the greeter starts, as with GDM; if Plasma Login
# fails, plymouth-quit.service still removes it.
Conflicts=plymouth-quit.service
After=plymouth-start.service
OnFailure=plymouth-quit.service

[Service]
ExecStartPre=-/usr/bin/timeout --kill-after=2 20 /usr/bin/plymouth quit
EOF
fi
if [[ $profile != arch-minimal ]]; then
  # The splash theme and hook are set before the initramfs is generated below.
  # The Aurora theme draws aura's logo where aura left it, with the spinner below.
  chroot "$mountroot" plymouth-set-default-theme aurora
  # Read after aurora-boot's 90-aurora.conf, whose hook order it extends, so
  # later changes to that order still reach installed desktops.
  install -d -m 0755 "$mountroot/etc/mkinitcpio.conf.d"
  cat > "$mountroot/etc/mkinitcpio.conf.d/95-aurora-plymouth.conf" <<'EOF'
# Aurora desktop images: Plymouth starts right after systemd, before
# sd-encrypt; every other hook keeps the order from 90-aurora.conf.
[[ ${HOOKS@a} == *a* ]] || read -r -a HOOKS <<< "$HOOKS"
_aurora_hooks=()
for _aurora_hook in "${HOOKS[@]}"; do
  if [[ $_aurora_hook != plymouth ]]; then _aurora_hooks+=("$_aurora_hook"); fi
  if [[ $_aurora_hook == systemd ]]; then _aurora_hooks+=(plymouth); fi
done
HOOKS=("${_aurora_hooks[@]}")
unset _aurora_hook _aurora_hooks
EOF
fi
root_uuid=$(blkid -s UUID -o value "${loop}p3")
boot_uuid=$(blkid -s UUID -o value "${loop}p2")
efi_uuid=$(blkid -s UUID -o value "${loop}p1")
printf 'UUID=%s / btrfs subvol=root,compress=zstd:1 0 0\nUUID=%s /home btrfs subvol=home,compress=zstd:1 0 0\nUUID=%s /boot ext4 defaults 0 2\nUUID=%s /boot/efi vfat umask=0077 0 2\n' "$root_uuid" "$root_uuid" "$boot_uuid" "$efi_uuid" > "$mountroot/etc/fstab"
printf '\nGRUB_CMDLINE_LINUX="rootflags=subvol=root"\n' >> "$mountroot/etc/default/grub"
# Quiet by default: failures still reach the console, and systemd shows
# status only when a unit fails or stalls. Desktop images boot to the splash.
# The console is the display: when a device tree names a serial console,
# Plymouth would otherwise draw its prompt as text there and on the screen.
cmdline='quiet loglevel=3 rd.udev.log_level=3 systemd.show_status=auto console=tty0'
[[ $profile == arch-minimal ]] || cmdline+=' splash'
printf 'GRUB_CMDLINE_LINUX_DEFAULT="%s"\n' "$cmdline" >> "$mountroot/etc/default/grub"
chroot "$mountroot" mkinitcpio -P
chroot "$mountroot" grub-install --target=arm64-efi --efi-directory=/boot/efi --removable --no-nvram
chroot "$mountroot" grub-mkconfig -o /boot/grub/grub.cfg
# aurora-userpages' GRUB drop-in turns per-process 4K userspace pages on.
grep -Eq '^\s*linux\s.*\suser4k=on(\s|$)' "$mountroot/boot/grub/grub.cfg"
mkdir -p "$mountroot/boot/efi/m1n1"
# In the C locale t6040-j616s-tether.dtb sorts before t6040-j616s.dtb, and aura
# boots the last tree of a board, so the board's main tree has to come last.
LC_ALL=C chroot "$mountroot" update-m1n1 /boot/efi/m1n1/boot.bin
# The image gets boot-ctxr.bin only with an aura that has no monitor, the rule
# update-m1n1 follows on an installed Mac. Look for the marker while the root is mounted.
monitor_free=false
if [[ -e $mountroot/usr/share/aura/monitor-free ]]; then monitor_free=true; fi
# Initial assembly is pinned; subsequent installed-system updates use the signed rolling feed.
sed -i "s@https://github.com/aurora-silicon/alarm-aurora/releases/download/$tag@https://aurorasilicon.org/alarm-aurora/$channel/aarch64@" "$mountroot/etc/pacman.conf"
chroot "$mountroot" pacman -Scc --noconfirm
rm -f "$mountroot/tmp/asahi-alarm.gpg" "$mountroot/tmp/aurora-alarm.asc"
# The first boot must find nothing left to change. A unit the image keeps
# off although a preset enables it needs a line in 80-aurora-image.preset.
presets=$(chroot "$mountroot" systemctl preset-all --preset-mode=enable-only 2>&1) || { printf '%s\n' "$presets" >&2; exit 1; }
if grep -E '^(Created symlink|Removed) ' <<<"$presets" >&2; then
  echo 'Units differ from their presets; the first boot would change them' >&2
  exit 1
fi
# Every image ships the basics (locale, terminal, wallpapers, network, lid
# policy); a build that lacks one fails here instead of on a Mac.
python3 "$root/scripts/check-basics.py" --profile "${profile#arch-}" --root "$mountroot"
# Retire only this disposable chroot's key agent before unmounting its devices.
python3 "$root/scripts/stop-image-key-agents.py" "$mountroot"
for path in dev proc sys run boot/efi boot ''; do
  if mountpoint -q "$mountroot${path:+/$path}"; then
    if ! umount -R "$mountroot${path:+/$path}"; then
      python3 "$root/scripts/diagnose-image-mounts.py" "$mountroot"
      exit 1
    fi
  fi
done
losetup -d "$loop";loop=''
# Fetch the same immutable common source used by the firstboot package.
python3 - "$root" <<'PY'
import json,sys,tarfile
from pathlib import Path
root=Path(sys.argv[1]);sys.path.insert(0,str(root/'scripts'))
import updatelib
p=json.loads((root/'sources.json').read_text())['aurora-firstboot']
archive=root/'out/finalizer.tar.gz'
# Verified mirror first, then the pinned URL, retrying rate limits.
updatelib.download([f"https://github.com/aurora-silicon/alarm-aurora/releases/download/source-cache/aurora-firstboot-{p['commit']}.tar.gz",
                    p['source_url']], archive, sha256=p['sha256'])
with tarfile.open(archive) as tar:tar.extractall(root/'out/finalizer',filter='data')
PY
revision=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["aurora-firstboot"]["archive_root"])' "$root/sources.json")
if ! bash "$root/out/finalizer/$revision/images/finalize-image" "$image" "$profile" "$root/out/$profile-installer"; then
  python3 "$root/scripts/diagnose-image-mounts.py" /tmp
  exit 1
fi
# A Stage 1 with the CTXR window chainloads these, on Mach-O Macs.
if $monitor_free; then
  python3 "$root/scripts/prepare-ctxr-stage2.py" "$root/out/$profile-installer/esp/m1n1"
fi
# GRUB finds /boot by UUID on the startup disk only, in the files the
# installer writes.
python3 "$root/scripts/check-basics.py" --profile "${profile#arch-}" --esp "$root/out/$profile-installer/esp" \
  --boot-image "$root/out/$profile-installer/boot.img" --boot-uuid "$boot_uuid"
tar --sparse -C "$root/out/$profile-installer" -cf - . | zstd -T4 -3 -o "$root/out/$profile-filesystems.tar.zst"
sha256sum "$root/out/$profile-filesystems.tar.zst" > "$root/out/$profile-filesystems.tar.zst.sha256"
