#!/bin/bash
# Disposable CI chroot only. Replace stock networkmanager with
# networkmanager-aurora, then go back to stock; the edited NetworkManager.conf
# stays active both ways, as dnf keeps it on Fedora.
set -euo pipefail
[[ $(id -u) == 0 && $(uname -m) == aarch64 && -d /src/.git ]]
packages=${1:?directory containing freshly built packages}
proof=/src/out/networkmanager-upgrade
conf=/etc/NetworkManager/NetworkManager.conf
mkdir -p "$proof"
pacman -S --noconfirm --needed networkmanager
pacman -Q networkmanager | tee "$proof/stock.txt"
candidate=("$packages"/networkmanager-aurora-[0-9]*.pkg.tar.*)
keeper=("$packages"/aurora-keep-config-[0-9]*.pkg.tar.*)
[[ ${#candidate[@]} == 1 && -f ${candidate[0]} && ${#keeper[@]} == 1 && -f ${keeper[0]} ]]
backup_state() { LC_ALL=C pacman -Qii "$1" | grep -Eo "$conf \[[a-z]+\]$" | cut -d' ' -f2; }
[[ $(backup_state networkmanager) == '[unmodified]' ]]
# The owner's settings; the connection profiles are not package files at all.
printf '[main]\nplugins=keyfile\n# upgrade-test-preserved\n' >> "$conf"
sha256sum "$conf" > "$proof/config.sha256"
cp /etc/pacman.conf "$proof/pacman.conf"
sed -i '/^\[options\]$/a LocalFileSigLevel = Optional' "$proof/pacman.conf"
printf 'y\ny\ny\ny\ny\n' | pacman --config "$proof/pacman.conf" -U "${keeper[0]}" "${candidate[0]}" | tee "$proof/swap.log"
pacman -Q networkmanager-aurora | tee "$proof/aurora.txt"
! pacman -Q networkmanager 2>/dev/null
pacman -T 'networkmanager' 'aurora-keep-config'
test -x /usr/bin/NetworkManager
sha256sum --check "$proof/config.sha256"
[[ $(backup_state networkmanager-aurora) == '[modified]' ]]
test -f "$conf.pacnew" && ! grep -Fx '# upgrade-test-preserved' "$conf.pacnew"
test ! -e "$conf.pacsave"
grep -F "keep-config: $conf: kept the edited copy" "$proof/swap.log"
pacman -Dk
printf 'y\ny\ny\ny\ny\n' | pacman -S networkmanager | tee "$proof/rollback.log"
pacman -Q networkmanager | diff -u "$proof/stock.txt" -
! pacman -Q networkmanager-aurora 2>/dev/null
sha256sum --check "$proof/config.sha256"
[[ $(backup_state networkmanager) == '[modified]' ]]
test ! -e "$conf.pacsave"
grep -F "keep-config: $conf: kept the edited copy" "$proof/rollback.log"
pacman -Dk
printf 'PASS: networkmanager-aurora replaces stock networkmanager and rolls back with the edited NetworkManager.conf active\n'
