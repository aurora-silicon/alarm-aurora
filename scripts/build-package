#!/bin/bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
name=${1:?package required}
[[ $name =~ ^[a-z0-9][a-z0-9-]*$ && -f $root/packages/$name/PKGBUILD ]] || exit 2
[[ $(uname -m) == aarch64 ]] || { echo 'A native AArch64 builder is required' >&2; exit 2; }
build=$root/out/build/$name
mkdir -p "$build" "$root/out/packages"
case $name in
  aurora-models|aurora-capture-ns|whisper-cpp-aurora|mil-hwx-compiler) cp -aL "$root/packages/$name/." "$build/" ;;
  *) cp -a "$root/packages/$name/." "$build/" ;;
esac
cd "$build"
PKGDEST="$root/out/packages" makepkg --syncdeps --noconfirm --cleanbuild

# Keep the epoch in .PKGINFO; GitHub artifacts require portable basenames.
for archive in "$root/out/packages/"*:*; do
  [[ -f $archive ]] || continue
  name=${archive##*/}
  mv "$archive" "$root/out/packages/${name//:/_}"
done
