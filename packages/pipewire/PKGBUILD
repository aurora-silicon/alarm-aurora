source=(
  "git+https://gitlab.freedesktop.org/pipewire/pipewire.git#tag=$pkgver"
  pipewire-sysusers.conf
  # AirPlay (RAOP) sender fixes:
  # A HomePod's 403 reply has no CSeq; it was dropped and the sink hung.
  1000-module-raop-match-an-RTSP-reply-without-CSeq-to-the-.patch
  # Warn with the receiver, request and status when a session is refused.
  1001-module-raop-sink-say-why-a-receiver-session-was-drop.patch
  # Default latency is a whole number of packets (no ptime warning).
  1002-module-raop-sink-default-sess.latency.msec-to-whole-.patch
  # Reload a RAOP sink that unloaded itself after a failed session.
  1003-module-raop-discover-reload-a-sink-that-unloaded-its.patch
  # Give up on a session that never reaches RECORD (a firewall dropping timing).
  1004-module-raop-sink-give-up-on-a-session-that-never-rea.patch
  # filter-graph published the latency its plugins reported before they had
  # run (0 or stale) and never updated it, so filter-chain speakers reported
  # the wrong delay to clients that schedule audio by it.
  1005-filter-graph-follow-plugin-latency-after-activation.patch
  # filter-graph let the converter apply the volume a second time in software
  # after an update that repeated the current volume or mute state (a desktop
  # re-sending the slider, an unmute of an unmuted sink), so speakers dropped
  # by the volume again (-31 dB at a 30 % slider) until the next real change.
  1006-filter-graph-keep-the-software-volume-at-unity-on-ev.patch
  # A refused snd_pcm_start (macaudio while speaker protection is not granted,
  # right after a resume) was retried and logged on every write, ~700 in
  # 30 ms: wait one period between attempts, report at most once per 5 s.
  1007-alsa-back-off-a-refused-snd_pcm_start-and-rate-limit.patch
  # A system sleep entered while such starts were refused suspends the PCM
  # before the retry: its -EBADFD after the resume is the normal recovery path.
  1008-alsa-a-start-on-a-suspended-PCM-is-expected-not-an-error.patch
  # Display audio (HDMI/DP) nodes are named after the display, from its ELD,
  # also when it was switched on after the card was set up (upstream efb5aa06).
  1009-alsa-put-the-ELD-product-name-on-HDMI-DP-nodes.patch
  # A start the kernel refused (the speaker PCM without a grant) left the
  # stream marked prepared, so every later start skipped the silence prefill
  # and failed with -EPIPE until PipeWire restarted: prepare it again.
  1010-alsa-prepare-a-stream-again-after-its-start-failed.patch
)
