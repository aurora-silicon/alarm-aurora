pkgname=aurora-speaker-upgrade
pkgver=0.1
pkgrel=0.5
pkgdesc='Move the speakers to speakerguardd v2 with this Mac'"'"'s own tuning (enabled by preset)'
arch=('any')
groups=('aurora-platform-apple-silicon')
url='https://github.com/aurora-silicon/speakerguardd/tree/v2/packaging/upgrade'
license=('MIT')
_commit=65064d88a20150a36d5c670c9d01f49cf9d250a3
makedepends=('git' 'make' 'python' 'python-cryptography')
depends=('python' 'python-cryptography' 'util-linux' 'alsa-utils' 'systemd')
# The switch needs speakerguardd v2; without it the tool refuses and the
# legacy protection keeps the speakers.
optdepends=('speakerguardd-v2: the protection it switches to'
            'lzfse: route 2 (Apple'"'"'s restore image) and LZFSE-compressed macOS files')
install=aurora-speaker-upgrade.install
source=("speakerguardd::git+https://github.com/aurora-silicon/speakerguardd.git#commit=$_commit"
        90-aurora-speaker-upgrade.preset)
sha256sums=('SKIP'
            '6dc0b069087f4e4a84f613bcf0b6df3a0ec320b8959ea327a6598595f19dfdc3')
check() {
  cd speakerguardd
  python3 -I -m unittest discover -s packaging/upgrade/tests
}
package() {
  install -Dm644 90-aurora-speaker-upgrade.preset "$pkgdir/usr/lib/systemd/system-preset/90-aurora-speaker-upgrade.preset"
  cd speakerguardd
  make -C packaging/upgrade install DESTDIR="$pkgdir" PREFIX=/usr UNITDIR=/usr/lib/systemd/system V2UNIT=speakerguardd-v2.service
  # speakerguardd-v2 installs its helpers in /usr/lib/speakerguardd-v2 on Arch
  # (Fedora: /usr/libexec/speakerguardd-v2); without this the tool reports v2
  # as not installed and never switches.
  local up="$pkgdir/usr/lib/aurora-speaker-upgrade/aurora_speaker_upgrade/upgrade.py"
  sed -i 's#^LIBEXEC = ("/usr/libexec/speakerguardd-v2",#LIBEXEC = ("/usr/lib/speakerguardd-v2", "/usr/libexec/speakerguardd-v2",#' "$up"
  grep -q '^LIBEXEC = ("/usr/lib/speakerguardd-v2",' "$up"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
