[Unit]
Description=Check this Mac's pacman trust database and repair it if needed
# Runs on every boot. It changes nothing while the keyring has its master key
# and every trusted key; otherwise it creates or populates what is missing.
After=local-fs.target systemd-random-seed.service
Before=aurora-firstboot.service
[Service]
Type=oneshot
ExecStart=/usr/libexec/aurora/initialize-keyring
[Install]
WantedBy=multi-user.target
