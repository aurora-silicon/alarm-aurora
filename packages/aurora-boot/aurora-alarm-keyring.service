[Unit]
Description=Create this Mac's pacman trust database
# Retried on every boot until it has succeeded once.
ConditionPathExists=!/var/lib/aurora/pacman-keyring-ready
After=local-fs.target systemd-random-seed.service
Before=aurora-firstboot.service
[Service]
Type=oneshot
ExecStart=/usr/libexec/aurora/initialize-keyring
[Install]
WantedBy=multi-user.target
