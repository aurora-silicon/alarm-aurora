pkgname=aurora-boot
pkgver=20261018
pkgrel=24
pkgdesc='Aurora Alarm boot integration'
arch=('any')
license=('MIT')
url='https://github.com/aurora-silicon/alarm-aurora'
source=('90-aurora.conf' 'initialize-keyring' 'aurora-alarm-keyring.service' 'aurora-boot.hook' '80-aurora-image.preset' 'aurora-usb4.install' 'aurora-display.install' 'aurora-early-kms.install' 'aurora-early-kms' 'aurora-early-kms.service' '40-aurora-console.cfg' 'aurora-grub.hook' 'aurora-early-kms-wait' 'aurora-kms-handover.service' '45-aurora-mte.cfg' '10-aurora-kmod-static-nodes.conf')
sha256sums=('9e0d1f9c7f1410ab2d84dce18e4fa4b5b5fc025b778bd567da6e617e7fc5c69a'
            '6acabc8e3aceb74725a82d4488ec81382bf77fe4baa86cb407a4014985837b66'
            'd1abff109369303df4e5ead2977d2642e0c13ce8a43a8841b97f9625aed6b59c'
            '7390bb98858ef1a2634bd846bb760b1d7fdfa43c089a5e6e4395f32c3a739a68'
            '92eddf89ceab1c399a7601d16571d6b22f515b6a7148fd25300dcdb9f4ea6ec2'
            '83c9f4a85658401161aa860544cbf4e4ddeb2e26c0759e2605dc775774d41d2d'
            'c76ddae94811c2b1f55be9a0ec1622c9c66496b929de322e0ea45628f714a710'
            '911b9dc0799ba4e578552d2ce3ead2621e2f805c218ae2897bc01ace08a9bdb8'
            '2f5340c4fcdba96be0e7d3df9089f054b799400f032656de8fcaad483f0a9e56'
            'af791540c692e1d3c4c016e20839252e91ad4701651a4677e3c898808f1626ed'
            '1f82359775d046b787756ca06b6ce274c67b169b0e0bff7578670fea5f9039fe'
            '97c44e78ac06ae3610ce102b4966ae636073e15ffb4723a7ffbe257a4abb947c'
            'c25b8ced2773f7d129d35ef24092355f65fdacb7beed5b29b253638b30dcbb7b'
            'c9c484403313cec79d278d4f2dff226fc876856924fb2c6aa75078b2e8cb3d74'
            '1b50f992e7a6a0c7ddb15ec0f60d6182b29fad8d15b198b00ea44785a56ffd55'
            'a1e727c7b6be0c16dbbefcfe119df2b4b1f25bfcbde0bbe61cd56c560159f43f')
package() {
  # T6050 boots without arm64.nomte (45-aurora-mte.cfg): aura 1.0.0b13 reserves the MTE tag
  # storage, and linux-aurora 7.3.0.aurora1-37 keeps MTE off on an Apple SoC that reserves none.
  depends=('mkinitcpio' 'grub' 'asahi-scripts' 'aura>=1.0.0b13' 'linux-aurora>=7.3.0.aurora1-37' 'uboot-aurora' 'aurora-firmware' 'aurora-firstboot' 'aurora-power-budget' 'aurora-neo-platform-config' 'aurora-m5-platform-config' 'aurora-audio>=4.1.aurora2-19' 'aurora-keyring' 'asahi-alarm-keyring')
  install -Dm644 90-aurora.conf "$pkgdir/etc/mkinitcpio.conf.d/90-aurora.conf"
  install -Dm644 aurora-usb4.install "$pkgdir/usr/lib/initcpio/install/aurora-usb4"
  install -Dm644 aurora-display.install "$pkgdir/usr/lib/initcpio/install/aurora-display"
  install -Dm644 aurora-early-kms.install "$pkgdir/usr/lib/initcpio/install/aurora-early-kms"
  install -Dm755 aurora-early-kms "$pkgdir/usr/libexec/aurora/aurora-early-kms"
  install -Dm644 aurora-early-kms.service "$pkgdir/usr/lib/aurora/initrd/aurora-early-kms.service"
  install -Dm755 aurora-early-kms-wait "$pkgdir/usr/libexec/aurora/aurora-early-kms-wait"
  install -Dm644 aurora-kms-handover.service "$pkgdir/usr/lib/aurora/initrd/aurora-kms-handover.service"
  install -Dm644 10-aurora-kmod-static-nodes.conf "$pkgdir/usr/lib/systemd/system/systemd-tmpfiles-setup-dev.service.d/10-aurora-kmod-static-nodes.conf"
  # Arch's GRUB reads /etc/default/grub.d after /etc/default/grub.
  install -Dm644 40-aurora-console.cfg "$pkgdir/etc/default/grub.d/40-aurora-console.cfg"
  install -Dm644 45-aurora-mte.cfg "$pkgdir/etc/default/grub.d/45-aurora-mte.cfg"
  install -Dm644 aurora-grub.hook "$pkgdir/usr/share/libalpm/hooks/95-aurora-grub.hook"
  install -Dm644 aurora-boot.hook "$pkgdir/usr/share/libalpm/hooks/95-aurora-boot.hook"
  install -Dm755 initialize-keyring "$pkgdir/usr/libexec/aurora/initialize-keyring"
  install -Dm644 aurora-alarm-keyring.service "$pkgdir/usr/lib/systemd/system/aurora-alarm-keyring.service"
  install -Dm644 80-aurora-image.preset "$pkgdir/usr/lib/systemd/system-preset/80-aurora-image.preset"
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system-preset/90-aurora-keyring.preset" <<'EOF'
enable aurora-alarm-keyring.service
EOF
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/aurora-firstboot.service.d/keyring.conf" <<'EOF'
[Unit]
# A keyring failure must not block owner setup; the keyring is checked again next boot.
Wants=aurora-alarm-keyring.service
After=aurora-alarm-keyring.service
EOF
}
