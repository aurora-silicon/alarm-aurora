pkgname=aurora-boot
pkgver=20261018
pkgrel=18
pkgdesc='Aurora Alarm boot integration'
arch=('any')
license=('MIT')
url='https://github.com/aurora-silicon/alarm-aurora'
source=('90-aurora.conf' 'initialize-keyring' 'aurora-alarm-keyring.service' 'aurora-boot.hook' '80-aurora-image.preset' 'aurora-usb4.install' 'aurora-display.install' 'aurora-early-kms.install' 'aurora-early-kms' 'aurora-early-kms.service' '40-aurora-console.cfg' 'aurora-grub.hook' 'aurora-early-kms-wait' 'aurora-kms-handover.service' '45-aurora-mte.cfg' '46-aurora-t8132-display.cfg')
sha256sums=('9e0d1f9c7f1410ab2d84dce18e4fa4b5b5fc025b778bd567da6e617e7fc5c69a' 'fec1107e24cda3e1197d9a803792b79e18ccdd839b5cf78cf862e7ee46a27e5b' 'f358a3db63a0a7d293607e56d519d747158d6ff8bc9704d12c8340745fe0f9e1' '5d60a9aae7c951dbb1de4c9723bed35b03376cb6f6bd74280da10cf48cf025e7' '92eddf89ceab1c399a7601d16571d6b22f515b6a7148fd25300dcdb9f4ea6ec2' '83c9f4a85658401161aa860544cbf4e4ddeb2e26c0759e2605dc775774d41d2d' 'c76ddae94811c2b1f55be9a0ec1622c9c66496b929de322e0ea45628f714a710' '0b7934a61dc95ec594c8558be6547247a87342684203841afdd7e7d8c3d94f6d' '2f5340c4fcdba96be0e7d3df9089f054b799400f032656de8fcaad483f0a9e56' 'af791540c692e1d3c4c016e20839252e91ad4701651a4677e3c898808f1626ed' '1f82359775d046b787756ca06b6ce274c67b169b0e0bff7578670fea5f9039fe' 'e98c678ecd51a036187615c730f1ded05e5524d587b32d6e3fa06f033f246754' 'c25b8ced2773f7d129d35ef24092355f65fdacb7beed5b29b253638b30dcbb7b' 'c9c484403313cec79d278d4f2dff226fc876856924fb2c6aa75078b2e8cb3d74' '574a61ed0ab677e2336d634cca17ab352177d0e4f3394f3c64fe553082279ddc' 'fa298ec6947f9d7b26376867fe1f692ad058f71a29f2b14940a14b2f9491d8f5')
package() {
  # 46-aurora-t8132-display.cfg admits the T8132 native display on every
  # kernel's GRUB entry; kernels before 7.3.0.aurora1-37 lack the G16 probe
  # stack fix (linux 41ee27eb4581) that path needs.
  depends=('linux-aurora>=7.3.0.aurora1-37' 'mkinitcpio' 'grub' 'asahi-scripts' 'aura' 'uboot-aurora' 'aurora-firmware' 'aurora-firstboot' 'aurora-power-budget' 'aurora-neo-platform-config' 'speakersafetyd-aurora-profiles' 'aurora-keyring' 'asahi-alarm-keyring')
  install -Dm644 90-aurora.conf "$pkgdir/etc/mkinitcpio.conf.d/90-aurora.conf"
  install -Dm644 aurora-usb4.install "$pkgdir/usr/lib/initcpio/install/aurora-usb4"
  install -Dm644 aurora-display.install "$pkgdir/usr/lib/initcpio/install/aurora-display"
  install -Dm644 aurora-early-kms.install "$pkgdir/usr/lib/initcpio/install/aurora-early-kms"
  install -Dm755 aurora-early-kms "$pkgdir/usr/libexec/aurora/aurora-early-kms"
  install -Dm644 aurora-early-kms.service "$pkgdir/usr/lib/aurora/initrd/aurora-early-kms.service"
  install -Dm755 aurora-early-kms-wait "$pkgdir/usr/libexec/aurora/aurora-early-kms-wait"
  install -Dm644 aurora-kms-handover.service "$pkgdir/usr/lib/aurora/initrd/aurora-kms-handover.service"
  # Arch's GRUB reads /etc/default/grub.d after /etc/default/grub.
  install -Dm644 40-aurora-console.cfg "$pkgdir/etc/default/grub.d/40-aurora-console.cfg"
  install -Dm644 45-aurora-mte.cfg "$pkgdir/etc/default/grub.d/45-aurora-mte.cfg"
  install -Dm644 46-aurora-t8132-display.cfg "$pkgdir/etc/default/grub.d/46-aurora-t8132-display.cfg"
  install -Dm644 aurora-grub.hook "$pkgdir/usr/share/libalpm/hooks/95-aurora-grub.hook"
  install -Dm644 aurora-boot.hook "$pkgdir/usr/share/libalpm/hooks/95-aurora-boot.hook"
  install -Dm755 initialize-keyring "$pkgdir/usr/libexec/aurora/initialize-keyring"
  install -Dm644 aurora-alarm-keyring.service "$pkgdir/usr/lib/systemd/system/aurora-alarm-keyring.service"
  install -Dm644 80-aurora-image.preset "$pkgdir/usr/lib/systemd/system-preset/80-aurora-image.preset"
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system-preset/90-aurora-keyring.preset" <<'EOF'
enable aurora-alarm-keyring.service
EOF
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/aurora-firstboot.service.d/keyring.conf" <<'EOF'
[Unit]
# A keyring failure must not block owner setup; the keyring retries next boot.
Wants=aurora-alarm-keyring.service
After=aurora-alarm-keyring.service
EOF
}
