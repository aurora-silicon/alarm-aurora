[Trigger]
Operation = Install
Operation = Upgrade
# Also after a removal: a removed kernel, or aurora-userpages' user4k=on fragment,
# must leave grub.cfg too. This package stays installed, so its hook still runs.
Operation = Remove
Type = Path
Target = etc/default/grub.d/40-aurora-console.cfg
Target = etc/default/grub.d/45-aurora-mte.cfg
Target = etc/default/grub.d/50-aurora-user4k.cfg
Target = usr/lib/modules/*/vmlinuz

[Action]
Description = Updating the GRUB configuration...
When = PostTransaction
# Named to run after 90-mkinitcpio-install, which puts the kernel back in /boot.
# Only on a system whose GRUB is set up; an image build runs grub-mkconfig itself.
Exec = /usr/bin/sh -c '[ -f /boot/grub/grub.cfg ] && [ -x /usr/bin/grub-mkconfig ] || exit 0; exec /usr/bin/grub-mkconfig -o /boot/grub/grub.cfg'
