#!/bin/bash
# The display comes up in the initramfs, ahead of the coldplug, as on Fedora
# (91aurora-early-kms): the coldplug queues thousands of uevents and the
# root is ready long before udev reaches the display, so appledrm used to
# load only on the real root and the splash came late.
build() {
  add_module appledrm?
  add_module mux-apple-display-crossbar?
  # The external DCPs' Type-C chain: without it appledrm (which waits for
  # every DCP) registers only on the real root, and the panel is black from
  # the internal DCP's start until then.
  add_module i2c-pasemi-platform?
  add_module phy-apple-atc?
  add_module phy-ti-cd2e22?
  add_module tps6598x?
  add_binary bash
  add_binary udevadm
  add_file /usr/libexec/aurora/aurora-early-kms
  add_file /usr/lib/aurora/initrd/aurora-early-kms.service /usr/lib/systemd/system/aurora-early-kms.service
  add_symlink /usr/lib/systemd/system/sysinit.target.wants/aurora-early-kms.service ../aurora-early-kms.service
  # Wait (bounded) for appledrm's card before the pivot, so Plymouth takes it
  # over while the initramfs udevd runs (aurora-kms-handover.service).
  add_binary sleep
  add_file /usr/libexec/aurora/aurora-early-kms-wait
  add_file /usr/lib/aurora/initrd/aurora-kms-handover.service /usr/lib/systemd/system/aurora-kms-handover.service
  add_symlink /usr/lib/systemd/system/initrd.target.wants/aurora-kms-handover.service ../aurora-kms-handover.service
}
help() { echo 'Coldplug the Apple display and its DRM cards before the other devices in the systemd initrd.'; }
