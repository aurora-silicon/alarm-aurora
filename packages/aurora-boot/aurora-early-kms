#!/bin/bash
# Runs in the initramfs after systemd-udevd starts and before
# systemd-udev-trigger coldplugs every device (aurora-early-kms.service).
#
# Coldplug the Apple display subsystem, its DCPs and their device-link
# suppliers (for example the Type-C PHY that an external DCP drives) first,
# then the DRM devices. udev loads appledrm and the supplier drivers through
# the normal modalias rules, so modprobe.d blacklists still apply, and the
# DRM cards are initialized before the rest of the coldplug queue, so
# Plymouth starts on appledrm instead of waiting for the real root.
set -u
devices=()
for dev in /sys/bus/platform/devices/*; do
  [[ -r $dev/modalias ]] || continue
  read -r alias < "$dev/modalias" || continue
  case $alias in
    *Capple,display-subsystem*|*Capple,dcp*) ;;
    *) continue ;;
  esac
  devices+=("$(cd -P "$dev" && pwd)")
  for link in "$dev"/supplier:*; do
    [[ -e $link/supplier ]] && devices+=("$(cd -P "$link/supplier" && pwd)")
  done
done
(( ${#devices[@]} )) || exit 0
udevadm trigger --action=add --settle "${devices[@]}"
udevadm settle --timeout=5
udevadm trigger --action=add --subsystem-match=drm --settle
