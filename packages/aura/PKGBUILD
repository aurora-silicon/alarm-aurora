# Aurora bootloader; ordinary updates refresh ESP Stage 2, never enroll Stage 1.
pkgname=aura
pkgver=1.0.0b8
pkgrel=1
pkgdesc='Aurora Silicon bootloader for Apple Silicon'
arch=('aarch64')
groups=('aurora-platform-apple-silicon')
url='https://github.com/aurora-silicon/aura'
license=('MIT' 'GPL-2.0-only')
_commit=30e93e890055eb289f544972404ad7b7c4affc3a
# 1 once the pinned source has no monitor (aura#77); prepare() checks it. Such an
# aura moves the kernel into the CTXR window, so it requires a kernel built with
# CONFIG_ARM64_CTXR_EXECMEM, which linux-aurora provides as aurora-ctxr-execmem.
_monitor_free=1
_ctxr_kernel=()
if (( _monitor_free )); then _ctxr_kernel=('aurora-ctxr-execmem'); fi
_compat=1.6.1.aurora19
provides=("m1n1=$_compat" "m1n1-aurora=$_compat" "m1n1-neo=$_compat")
conflicts=('m1n1' 'm1n1-aurora' 'm1n1-neo')
replaces=('m1n1-neo')
makedepends=('git' 'clang' 'lld' 'llvm' 'rustup' 'make' 'python')
options=('!strip' '!debug')
source=("aura::git+$url.git#commit=$_commit" build-qualification.json validate-qualification.py)
sha256sums=('SKIP' '89edceba36030a067ef72d7a408b6280dc370a01f7f74c5183df2c8f22f9d75c' 'd89f89a68105e4663bdf14bf9d4d70f3fad79538a4c566e8fae73c0b40a9be26')
prepare() {
  rustup toolchain install 1.99.0 --profile minimal --target aarch64-unknown-none-softfloat
  [[ $(git -C aura rev-parse HEAD) == "$_commit" ]]
  local found=0
  if [[ -f aura/src/ctxr_exec.c || ! -f aura/src/monitor.c ]]; then found=1; fi
  if (( found != _monitor_free )); then
    echo "aura: set _monitor_free=$found, which the pinned source is" >&2
    return 1
  fi
}
build() {
  cd aura
  export RUSTUP_TOOLCHAIN=1.99.0
  make clean
  make -j"${OMARCHY_BUILD_JOBS:-10}" RELEASE=1 CHAINLOADING=1 USE_CLANG=1 BUILTIN_LOGO=aurora
  install -Dm644 build/aura.bin "$srcdir/stage1/aura-raw.bin"
  install -Dm644 build/aura.macho "$srcdir/stage1/aura.macho"
  install -Dm644 build/aura-boot.macho "$srcdir/stage1/aura-boot.macho"
  make clean
  make -j"${OMARCHY_BUILD_JOBS:-10}" RELEASE=1 CHAINLOADING=1 ESP_STAGE2=1 USE_CLANG=1 BUILTIN_LOGO=aurora
}
package() {
  # Required on the installed system, not to build the bootloader. A Mach-O Mac
  # needs the update-m1n1 that leaves boot.bin alone, or this aura could overwrite it.
  depends=('asahi-scripts>=20260127.1' 'aurora-stage2-ctxr-slot' 'uboot-aurora' "${_ctxr_kernel[@]}")
  # Building a PR candidate does not assert release/hardware qualification.
  install -Dm644 aura/build/aura.bin "$pkgdir/usr/lib/asahi-boot/m1n1.bin"
  install -d "$pkgdir/usr/lib/m1n1-neo"
  ln -s ../asahi-boot/m1n1.bin "$pkgdir/usr/lib/m1n1-neo/m1n1.bin"
  # An aura without the monitor: update-m1n1 then stops writing boot.bin on Mach-O Macs.
  if (( _monitor_free )); then
    install -Dm644 /dev/null "$pkgdir/usr/share/aura/monitor-free"
  fi
  install -Dm644 stage1/aura-raw.bin "$pkgdir/usr/share/aura/stage1/aura-raw.bin"
  install -Dm644 stage1/aura-boot.macho "$pkgdir/usr/share/aura/stage1/aura-boot.macho"
  install -Dm644 stage1/aura.macho "$pkgdir/usr/share/aura/stage1/aura.macho"
  install -Dm644 aura/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -m644 aura/3rdparty_licenses/* "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 "$srcdir/build-qualification.json" "$pkgdir/usr/share/doc/aura/build-qualification.json"
}
