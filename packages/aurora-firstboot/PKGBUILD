pkgname=aurora-firstboot
pkgver=0.1.4
pkgrel=1
pkgdesc='Aurora per-install root encryption and Linux owner setup'
arch=('any')
license=('MIT')
url='https://github.com/aurora-silicon/aurora-platform'
_commit=b0749845fa3830e844d67e744d7dbb7c182d5a84
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/aurora-silicon/aurora-platform/tar.gz/$_commit")
sha256sums=('018f873982eb387662e81b70b8e4ad80ceb9037b51d4fc852599eded93f08a85')
package() {
  depends=('bash' 'cryptsetup>=2.8' 'btrfs-progs' 'util-linux' 'coreutils' 'systemd' 'python' 'shadow' 'sudo' 'kbd' 'mkinitcpio')
  make -C "aurora-platform-$_commit" install-common install-mkinitcpio DESTDIR="$pkgdir" PREFIX=/usr
  install -Dm644 "aurora-platform-$_commit/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system-preset/90-aurora-firstboot.preset" <<'EOF'
enable aurora-firstboot.service
EOF
}
