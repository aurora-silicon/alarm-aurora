# Arch's gnome-settings-daemon 51.1-1 recipe with one Aurora patch: an opt-in
# ambient white point in the colour plugin. The same patch is in
# fedora-aurora's gnome-settings-daemon package.
# Maintainer: Fabian Bornschein <fabiscafe@archlinux.org>
# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgname=gnome-settings-daemon-aurora
_tag=51.1
pkgver=51.1.aurora1
pkgrel=1
pkgdesc="GNOME Settings Daemon"
url="https://gitlab.gnome.org/GNOME/gnome-settings-daemon"
arch=(aarch64)
license=(
  GPL-2.0-or-later
  LGPL-2.0-or-later
)
depends=(
  alsa-lib
  bash
  dconf
  fontconfig
  gcr-4
  geoclue
  geocode-glib-2
  glib2
  glibc
  gnome-desktop-4
  gsettings-desktop-schemas
  gtk4
  libcanberra-pulse
  libcolord
  libcups
  libgcc
  libgudev
  libgweather-4
  libmm-glib
  libnm
  libnotify
  libp11-kit
  libpulse
  libx11
  libxfixes
  polkit
  pulse-native-provider
  systemd-libs
  upower
)
makedepends=(
  docbook-xsl
  git
  glib2-devel
  libxslt
  meson
  python
  usbguard
)
checkdepends=(
  python-dbusmock
  python-gobject
)
optdepends=('usbguard: USB protection support')
groups=(gnome)
provides=("gnome-settings-daemon=$_tag")
conflicts=('gnome-settings-daemon')
replaces=(gnome-settings-daemon)
backup=(etc/xdg/Xwayland-session.d/00-xrdb)
source=(
  "git+https://gitlab.gnome.org/GNOME/gnome-settings-daemon.git#tag=$_tag"
  "git+https://gitlab.gnome.org/GNOME/libgnome-volume-control.git"
  0001-color-ambient-white-point.patch
)
b2sums=('52dd4163a11446ad7de40f0ac736dcbed18d72efbdb164bd790c947c375c840adde0d88a2ad2a920b29ed70611b87cf838c07478c228ccbf8cbde618582853f8'
        'SKIP'
        'cc88b5e361e3d87e26c526c9ec45578be930f99ec228bb49cfce133b5e4df3f84666d853871a0b547aaab5045459b73e8f05608639a00db9e005054ebd40faba')

prepare() {
  cd gnome-settings-daemon
  git apply -v ../0001-color-ambient-white-point.patch

  git submodule init
  git submodule set-url subprojects/gvc "$srcdir/libgnome-volume-control"
  git -c protocol.file.allow=always -c protocol.allow=never submodule update
}

build() {
  arch-meson gnome-settings-daemon build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  # Stock gnome-settings-daemon owns the same backup file.
  depends+=('aurora-keep-config')
  meson install -C build --no-rebuild --destdir "$pkgdir"
}

