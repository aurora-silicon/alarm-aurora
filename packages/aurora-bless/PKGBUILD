pkgbase=aurora-bless
pkgname=('aurora-bless' 'aurora-nvram' 'aurora-btsync' 'aurora-panel-nits')
pkgver=0.4.4.aurora5
pkgrel=1
pkgdesc='Aurora Apple Silicon startup-volume selector with Neo NVRAM support'
arch=('aarch64')
groups=('aurora-platform-apple-silicon')
url='https://github.com/aurora-silicon/aurora-bless'
license=('MIT')
_commit=9b47a17827854588d458b1dcc8018c66f5c3237f
makedepends=('git' 'rust' 'cargo' 'make' 'dbus' 'pkgconf')
source=("aurora-bless::git+$url.git#commit=$_commit")
sha256sums=('SKIP')
_bin() {
  if [[ -n ${CARGO_TARGET:-} ]]; then echo "aurora-bless/target/$CARGO_TARGET/release/$1"; else echo "aurora-bless/target/release/$1"; fi
}
build() {
  cd aurora-bless
  cargo build --locked --release -p asahi-bless -p aurora-nvram -p aurora-btsync -p aurora-panel-nits ${CARGO_TARGET:+--target "$CARGO_TARGET"}
}
check() {
  cd aurora-bless
  cargo test --locked -p asahi-bless -p apple-nvram -p aurora-nvram -p aurora-btsync -p aurora-panel-nits
}
package_aurora-bless() {
  provides=("asahi-bless=$pkgver")
  conflicts=('asahi-bless')
  install -Dm755 "$(_bin asahi-bless)" "$pkgdir/usr/bin/aurora-bless"
  ln -s aurora-bless "$pkgdir/usr/bin/asahi-bless"
  install -Dm644 aurora-bless/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
package_aurora-nvram() {
  pkgdesc='Read and write Apple Silicon NVRAM variables (replaces asahi-nvram)'
  depends=('gcc-libs' 'glibc')
  provides=("asahi-nvram=$pkgver")
  conflicts=('asahi-nvram')
  replaces=('asahi-nvram')
  install -Dm755 "$(_bin aurora-nvram)" "$pkgdir/usr/bin/aurora-nvram"
  ln -s aurora-nvram "$pkgdir/usr/bin/asahi-nvram"
  install -Dm644 aurora-bless/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 aurora-bless/aurora-nvram/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 aurora-bless/NEO.md "$pkgdir/usr/share/doc/$pkgname/NEO.md"
}
package_aurora-btsync() {
  pkgdesc='Use the Bluetooth pairings made in macOS on Linux (replaces asahi-btsync)'
  depends=('bluez' 'dbus' 'systemd' 'gcc-libs' 'glibc')
  provides=("asahi-btsync=$pkgver")
  conflicts=('asahi-btsync')
  replaces=('asahi-btsync')
  install -Dm755 "$(_bin aurora-btsync)" "$pkgdir/usr/bin/aurora-btsync"
  ln -s aurora-btsync "$pkgdir/usr/bin/asahi-btsync"
  install -Dm644 aurora-bless/aurora-btsync/etc/systemd/system/aurora-btsync.service "$pkgdir/usr/lib/systemd/system/aurora-btsync.service"
  ln -s aurora-btsync.service "$pkgdir/usr/lib/systemd/system/asahi-btsync.service"
  install -Dm644 aurora-bless/aurora-btsync/etc/udev/rules.d/96-aurora-btsync.rules "$pkgdir/usr/lib/udev/rules.d/96-aurora-btsync.rules"
  install -Dm644 aurora-bless/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 aurora-bless/aurora-btsync/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
package_aurora-panel-nits() {
  pkgdesc='Built-in panel brightness shared with the boot loader through NVRAM backlight-nits'
  depends=('systemd')
  make -C aurora-bless/aurora-panel-nits install DESTDIR="$pkgdir" PREFIX=/usr BIN="$PWD/$(_bin aurora-panel-nits)"
  install -Dm644 aurora-bless/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 aurora-bless/aurora-panel-nits/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
