pkgname=aurora-firmware
pkgver=20261018
pkgrel=2
pkgdesc='Aurora target-device firmware and peripheral admission'
arch=('any')
license=('MIT')
url='https://github.com/aurora-silicon/alarm-aurora'
source=('aurora-firmware-order.conf' 'aurora-peripheral-firmware.sh' 'aurora-peripherals.service' '90-aurora-peripherals.preset' 'aurora-vendor.install' 'load-vendor-firmware' 'aurora-vendor-firmware.service')
sha256sums=('e6338787cc03c7704589df20f7551ac17bc2ae25aa2f8df3b6d9532a1c5b79f9' 'e3198afcddc743d78288752dd5dcd4404a6f185f3547c1b0b55c4fb7b72a8fa2' 'ddd817f8c70ec4efc4ea62cc5957cb065a11d9c2156f0d31e4113dd6a9f0708f' '39a5034afd1d2cd03475bb1cd46c56c6695e5c315cd027319f2d29017e854db6' 'fd65a4f2968848425bb7604bd6f8c8f56399d3657def67d1b8eb1b3cb4cf2b2f' '8fc748e6bbd761f222fd33dec22f63a849d8d3756d84caa96d3e63f96a7fa63d' '30bb6b24f5267fdd4b985d657738e326c6504abe2aa0866c8d588319fa36a9ce')
package() {
  depends=('bash' 'asahi-scripts' 'kmod' 'wireless-regdb' 'cpio' 'util-linux')
  install -Dm644 aurora-firmware-order.conf "$pkgdir/usr/lib/modprobe.d/aurora-firmware-order.conf"
  install -Dm755 aurora-peripheral-firmware.sh "$pkgdir/usr/libexec/aurora/peripheral-firmware"
  install -Dm644 aurora-peripherals.service "$pkgdir/usr/lib/systemd/system/aurora-peripherals.service"
  install -Dm644 90-aurora-peripherals.preset "$pkgdir/usr/lib/systemd/system-preset/90-aurora-peripherals.preset"
  install -Dm644 aurora-vendor.install "$pkgdir/usr/lib/initcpio/install/aurora-vendor"
  install -Dm755 load-vendor-firmware "$pkgdir/usr/libexec/aurora/load-vendor-firmware"
  install -Dm644 aurora-vendor-firmware.service "$pkgdir/usr/lib/aurora/initrd/aurora-vendor-firmware.service"
}
