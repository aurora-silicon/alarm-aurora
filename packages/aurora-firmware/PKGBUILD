pkgname=aurora-firmware
pkgver=20261018
pkgrel=8
pkgdesc='Aurora target-device firmware and peripheral admission'
arch=('any')
license=('MIT')
url='https://github.com/aurora-silicon/alarm-aurora'
source=('aurora-firmware-order.conf' 'aurora-peripheral-firmware.sh' 'aurora-peripherals.service' '90-aurora-peripherals.preset' 'aurora-vendor.install' 'load-vendor-firmware' 'aurora-vendor-firmware.service' 'aurora-firmware.hook')
sha256sums=('4ce5526d55069561200e5f08eca3330a9536aaaaf88691f65fe2f236d0364c3a' 'e41282d9c6498009f6e4df45f63681b5e54b222d71ac6297a1f6319b44c05ec9' 'ddd817f8c70ec4efc4ea62cc5957cb065a11d9c2156f0d31e4113dd6a9f0708f' '39a5034afd1d2cd03475bb1cd46c56c6695e5c315cd027319f2d29017e854db6' 'b596859014b9ec8a4ddfac646778e69a4d758dd75384acc4b07ccfb4f44794f6' '6b5858a1909bb9eb9893eef31e286593334c36ee8e8a3a5a24855f67dde3400f' '104d8c2a41051a6628ee76188e499bcf7eebc7a0849325c9b49bf408d36d625d' 'e3dc341f45bad5ba93579da22ea7564be3c2d14abcefb7388b68879fcc3d3dd5')
package() {
  depends=('bash' 'asahi-scripts' 'kmod' 'wireless-regdb' 'cpio' 'util-linux')
  install -Dm644 aurora-firmware-order.conf "$pkgdir/usr/lib/modprobe.d/aurora-firmware-order.conf"
  install -Dm755 aurora-peripheral-firmware.sh "$pkgdir/usr/libexec/aurora/peripheral-firmware"
  install -Dm644 aurora-peripherals.service "$pkgdir/usr/lib/systemd/system/aurora-peripherals.service"
  install -Dm644 90-aurora-peripherals.preset "$pkgdir/usr/lib/systemd/system-preset/90-aurora-peripherals.preset"
  install -Dm644 aurora-vendor.install "$pkgdir/usr/lib/initcpio/install/aurora-vendor"
  install -Dm755 load-vendor-firmware "$pkgdir/usr/libexec/aurora/load-vendor-firmware"
  install -Dm644 aurora-vendor-firmware.service "$pkgdir/usr/lib/aurora/initrd/aurora-vendor-firmware.service"
  install -Dm644 aurora-firmware.hook "$pkgdir/usr/share/libalpm/hooks/95-aurora-firmware.hook"
}
