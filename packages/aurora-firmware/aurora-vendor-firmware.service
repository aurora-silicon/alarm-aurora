[Unit]
Description=Extract this Mac's firmware before Aurora peripheral admission
DefaultDependencies=no
Wants=systemd-udevd.service systemd-udev-trigger.service systemd-udev-settle.service
After=systemd-udevd.service systemd-udev-trigger.service systemd-udev-settle.service
Before=sysroot.mount cryptsetup-pre.target aurora-initrd-root.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/aurora/load-vendor-firmware
