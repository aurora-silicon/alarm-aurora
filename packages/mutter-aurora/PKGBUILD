# Arch's mutter 51.1-1 recipe (Jan Alexander Steffens, Fabian Bornschein) with
# Aurora VRR preference and the upstream touch null-focus crash fix.
# The same patch is in fedora-aurora's mutter package.
pkgname=mutter-aurora
_tag=51.1
pkgver=51.1.aurora1
pkgrel=4
pkgdesc="Window manager and compositor for GNOME, defaulting VRR-capable displays to variable refresh rate"
url="https://gitlab.gnome.org/GNOME/mutter"
arch=(aarch64)
license=(GPL-2.0-or-later)
provides=("mutter=$_tag" libmutter-51.so)
conflicts=(mutter)
replaces=(mutter)
depends=(
  at-spi2-core
  cairo
  colord
  dconf
  egl-wayland
  fontconfig
  fribidi
  gdk-pixbuf2
  glib2
  glibc
  glycin
  gnome-desktop-4
  gnome-settings-daemon
  graphene
  'gsettings-desktop-schemas>=51'
  gtk4
  harfbuzz
  iio-sensor-proxy
  lcms2
  libcanberra
  libcolord
  libdisplay-info
  libdrm
  libei
  libgcc
  libgirepository
  libglvnd
  libgudev
  'libinput>=1.31.0'
  'libpipewire>=1.6.0'
  libsysprof-capture
  libwacom
  libx11
  libxau
  libxcb
  libxcomposite
  libxcursor
  libxdamage
  libxext
  libxfixes
  libxi
  libxinerama
  libxkbcommon
  libxrandr
  mesa
  pango
  pipewire
  pixman
  python
  python-argcomplete
  python-dbus
  python-gobject
  startup-notification
  systemd-libs
  'wayland>=1.26'
  xorg-xwayland
)
makedepends=(
  gtk3
  libevdev
  python-dbusmock
  umockdev
  xorg-server-xvfb
  xorg-xauth
  ttf-dejavu
  bash-completion
  git
  glib2-devel
  gobject-introspection
  meson
  python-docutils
  sysprof
  'wayland-protocols>=1.48'
)
source=(
  "https://download.gnome.org/sources/mutter/51/mutter-$_tag.tar.xz"
  0001-wayland-touch-Do-not-crash-on-empty-focus-surface.patch
  0001-native-output-kms-Prefer-variable-refresh-rate-on-VRR-capable-outputs.patch
  0002-input-capture-disable-on-eis-disconnect.patch
  0003-x11-assign-frame-counters-on-actor-views.patch
)
sha256sums=('0d311d87901dbcb94518fb89304febe30852ce5d8a4befa9f87e85c68eceefde'
            'c68c274af7ead7f811c7fce0557752ed983dbe9aef90918f0c91177e861fbd1e'
            'd4606ed010fe9633ef0f3d2fcf79bd6f7ef2712c98d1b009592772b142ab34fe'
            '996105591388ef3eaf0194db3a39ad9ded37253ab6997ac20c89d19f5c7f5a8c'
            '5629798d50d63a77c902c3683c136e548eacfad710719c7befe5421ebac37b4e'
)

prepare() {
  cd "mutter-$_tag"
  git apply -v "../0001-wayland-touch-Do-not-crash-on-empty-focus-surface.patch"
  git apply -v "../0001-native-output-kms-Prefer-variable-refresh-rate-on-VRR-capable-outputs.patch"
  git apply -v "../0002-input-capture-disable-on-eis-disconnect.patch"
  git apply -v "../0003-x11-assign-frame-counters-on-actor-views.patch"
}

build() {
  local meson_options=(
    -D docs=false
    -D installed_tests=false
    -D tests=enabled
  )

  CFLAGS="${CFLAGS/-O2/-O3} -fno-semantic-interposition"
  LDFLAGS+=" -Wl,-Bsymbolic-functions"

  arch-meson "mutter-$_tag" build "${meson_options[@]}"
  meson compile -C build -j8
}

check() {
  export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe
  export XDG_RUNTIME_DIR="$srcdir/runtime"
  mkdir -p "$XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR"
  xvfb-run -a meson test -C build --print-errorlogs
}

package() {
  optdepends=('bash-completion: Bash completions for gdctl')

  meson install -C build --no-rebuild --destdir "$pkgdir"

  # The development kit stays in ALARM's mutter-devkit, which this package
  # satisfies through its mutter provide.
  rm -r "$pkgdir"/usr/lib/mutter-devkit
  rm "$pkgdir"/usr/share/applications/org.gnome.Mutter.Mdk.desktop
  rm "$pkgdir"/usr/share/icons/hicolor/scalable/apps/org.gnome.Mutter.Mdk.Devel.svg
  rm "$pkgdir"/usr/share/icons/hicolor/scalable/apps/org.gnome.Mutter.Mdk.svg
  rm "$pkgdir"/usr/share/icons/hicolor/symbolic/apps/org.gnome.Mutter.Mdk-symbolic.svg
  find "$pkgdir"/usr/share -depth -type d -empty -delete
}
