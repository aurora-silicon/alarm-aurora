# Arch's mutter 51.1-1 recipe (Jan Alexander Steffens, Fabian Bornschein) with
# six Aurora patches: a VRR-capable output defaults to variable refresh rate,
# a panel that scales PQ with its backlight (PQ_REFERENCE_LUMINANCE) keeps
# its backlight and gets its reference white in BT.2100 mode, a built-in
# panel in a variable refresh rate mode uses it on its whole desktop, the
# renderer drops its power save page flip onscreens on dispose, so gnome-shell
# does not crash at shutdown while outputs are in power save, and the fixed
# refresh rate scheduler updates right away when even its minimum estimate is
# too late, so clients drawing every frame keep the full refresh rate, and
# touchpad finger scrolling follows the touchpad scroll-speed setting. The
# same patches are in fedora-aurora's mutter package.
pkgname=mutter-aurora
_tag=51.1
pkgver=51.1.aurora7
pkgrel=1
pkgdesc="Window manager and compositor for GNOME, defaulting VRR-capable displays to variable refresh rate"
url="https://gitlab.gnome.org/GNOME/mutter"
arch=(aarch64)
license=(GPL-2.0-or-later)
provides=("mutter=$_tag" libmutter-51.so)
conflicts=(mutter)
replaces=(mutter)
depends=(
  at-spi2-core
  cairo
  colord
  dconf
  egl-wayland
  fontconfig
  fribidi
  gdk-pixbuf2
  glib2
  glibc
  glycin
  gnome-desktop-4
  gnome-settings-daemon
  graphene
  gsettings-desktop-schemas
  gtk4
  harfbuzz
  iio-sensor-proxy
  lcms2
  libcanberra
  libcolord
  libdisplay-info
  libdrm
  libei
  libgcc
  libgirepository
  libglvnd
  libgudev
  libinput
  libpipewire
  libsysprof-capture
  libwacom
  libx11
  libxau
  libxcb
  libxcomposite
  libxcursor
  libxdamage
  libxext
  libxfixes
  libxi
  libxinerama
  libxkbcommon
  libxrandr
  mesa
  pango
  pipewire
  pixman
  python
  python-argcomplete
  python-dbus
  python-gobject
  startup-notification
  systemd-libs
  wayland
  xorg-xwayland
)
makedepends=(
  bash-completion
  git
  glib2-devel
  gobject-introspection
  meson
  python-docutils
  sysprof
  wayland-protocols
)
source=(
  # Mutter tags use SSH signatures which makepkg doesn't understand
  "git+$url.git#tag=$_tag"
  "git+https://gitlab.gnome.org/GNOME/gvdb.git#commit=b54bc5da25127ef416858a3ad92e57159ff565b3"
  0001-native-output-kms-Prefer-variable-refresh-rate-on-VRR-capable-outputs.patch
  0002-backends-Take-the-PQ-reference-white-from-PQ_REFERENCE_LUMINANCE.patch
  0003-onscreen-native-Use-variable-refresh-rate-on-the-whole-desktop-of-built-in-panels.patch
  0004-renderer-native-Drop-power-save-page-flip-onscreens-on-dispose.patch
  0005-clutter-frame-clock-Update-now-when-even-the-minimum-estimate-is-too-late.patch
  0006-backends-native-Apply-the-touchpad-scroll-speed-sett.patch
  0007-backends-backlight-sysfs-Perceptual-CIE-1931-scale-for-linear-backlights.patch
)
