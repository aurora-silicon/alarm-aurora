# Based on the Arch Linux iwd 3.12-2 package (AndyRTR, Christian Rebischke,
# Levente Polyak). Aurora adds OWE on FullMAC devices that offload it.

pkgname=iwd-aurora
_pkgname=iwd
pkgver=3.12
pkgrel=2
pkgdesc='Internet Wireless Daemon, with OWE on FullMAC devices that offload it (Neo MT7932)'
arch=('aarch64')
url='https://git.kernel.org/cgit/network/wireless/iwd.git/'
license=('LGPL-2.1-or-later')
provides=("iwd=$pkgver")
conflicts=('iwd')
depends=('glibc' 'readline' 'libreadline.so' 'ell' 'libgcc')
makedepends=('python-docutils' 'dbus' 'systemd')
optdepends=('qrencode: for displaying QR code after DPP is started')
# The tarball is pinned by its sha256 (the same as Arch's iwd 3.12-2); this
# repository's build root carries no upstream PGP keys.
source=(https://www.kernel.org/pub/linux/network/wireless/iwd-${pkgver}.tar.xz
        0001-use-network-group-for-unprivileged-access.diff
        0001-rrm-fix-stack-buffer-overflow-in-rrm_report_beacon_r.patch
        0002-ie-fix-off-by-one-in-HE-Capabilities-Channel-Width-S.patch
        0003-ft-fix-mde_equal-self-comparison-and-type-mismatch.patch
        0004-ie-fix-uint8_t-underflow-in-FTE-sub-element-parser.patch
        0101-linux-update-nl80211.h-for-the-OWE-offload-ext-features.patch
        0102-netdev-support-OWE-on-FullMAC-devices-that-offload-it.patch)
sha256sums=('d89a5e45c7180170e19be828f9e944a768c593758094fc57a358d0e7c4cb1a49'
            'd5fb4fb864b7a0632117aa2039df535ab5c1d024ae618a1f09e34dfab8ee0cc7'
            'db5e63cf8e7d2071b0048f134e4aebed1f46e0b191cad5530ce99c07b1157b13'
            'cdd07a19f831c5f207817cdf8398a790bb5b233e32bb0e7d7998eb41a1a61763'
            'c160d0c3c7c0219ceff7cf107f8c24c33163c92cee3fc2573c26b1515bd05f22'
            '42dba8b8f2b0d39036df71f4b1887db5915e25ca3575e841d3f5352dfb0d514a'
            '0f9cbd3742ca95e5e6422ecf0efe4936e509ba185f5c9e1a64b800780342f1b1'
            'ae6c4e5f71fb228c42c4215bc81b121d646715dba3332859c7a576d0015526f2')
options=('!lto')

prepare() {
  cd ${_pkgname}-${pkgver}
  # Arch: the existing "network" group for unprivileged access
  patch -Np1 -i ../0001-use-network-group-for-unprivileged-access.diff
  # Arch: oss-security 2026/08/02 fixes
  patch -Np1 -i ../0001-rrm-fix-stack-buffer-overflow-in-rrm_report_beacon_r.patch
  patch -Np1 -i ../0002-ie-fix-off-by-one-in-HE-Capabilities-Channel-Width-S.patch
  patch -Np1 -i ../0003-ft-fix-mde_equal-self-comparison-and-type-mismatch.patch
  patch -Np1 -i ../0004-ie-fix-uint8_t-underflow-in-FTE-sub-element-parser.patch
  # Aurora: OWE through NL80211_EXT_FEATURE_OWE_OFFLOAD
  patch -Np1 -i ../0101-linux-update-nl80211.h-for-the-OWE-offload-ext-features.patch
  patch -Np1 -i ../0102-netdev-support-OWE-on-FullMAC-devices-that-offload-it.patch
  # Arch: needs AES_CTR, which the build root does not have
  sed -i "s:unit/test-storage::" Makefile.am
  autoreconf -vfi
}

build() {
  cd ${_pkgname}-${pkgver}
  dbus-run-session ./configure --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --libexecdir=/usr/lib/iwd \
    --enable-external-ell \
    --enable-wired \
    --enable-ofono \
    --enable-hwsim \
    --disable-tools
  make
}

check() {
  cd ${_pkgname}-${pkgver}
  make check
}

package() {
  cd ${_pkgname}-${pkgver}
  make install DESTDIR="${pkgdir}"
  install -Dm 644 README -t "${pkgdir}/usr/share/doc/${_pkgname}"
}
