pkgname=aurora-xart
pkgver=0.1.0
pkgrel=1
pkgdesc='Inspect and manage the Linux side of the Secure Enclave and xART state on Apple silicon Macs'
arch=('any')
groups=('aurora-platform-apple-silicon')
url='https://github.com/aurora-silicon/aurora-xart'
license=('MIT')
_commit=83ae1899d0a70e84cb464b8443a3458408b2d28e
depends=('python')
# reset-touchid opens the sensor through fprintd-list.
optdepends=('fprintd-aurora: open the Touch ID sensor before judging a stored keybag')
makedepends=('make')
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/aurora-silicon/aurora-xart/tar.gz/$_commit")
sha256sums=('1d91de60345f0c0633d00402aaec60de3ab52c8c560ae5d7a1ffc82909d7bdda')

check() {
  make -C "aurora-xart-$_commit" check
}

package() {
  make -C "aurora-xart-$_commit" install DESTDIR="$pkgdir" PREFIX=/usr
  install -Dm644 "aurora-xart-$_commit/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
