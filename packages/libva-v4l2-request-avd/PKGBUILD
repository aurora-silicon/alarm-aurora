pkgname=libva-v4l2-request-avd
pkgver=1.3.r11
pkgrel=4
pkgdesc='VA-API driver for the AVD V4L2 Request decoder'
arch=('aarch64')
groups=('aurora-platform-apple-silicon')
url='https://github.com/omacom/libva-v4l2_request'
license=('GPL-3.0-or-later')
_commit=4f60c51f7841dd74bb61c94a4ad31e630bbdab01
depends=('glibc' 'libdrm' 'libva')
makedepends=('meson' 'ninja' 'pkgconf' 'linux-api-headers')
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/omacom/libva-v4l2_request/tar.gz/$_commit"
        '0001-offline-test-portability.patch'
        '0002-av1-chrome.patch'
        '0003-av1-multitile.patch'
        '0004-driver-offer-H.264-High-10-to-libavcodec-clients-by-default.patch'
        '0005-surface-decode-10-bit-into-P010-surfaces-when-the-de.patch')
sha256sums=('826fda7396374daea1c39c08e2057dd2b4775cf0205c59bce2d30ce2bfd212a4'
            '8fbf69cf1d3d6275f4594f8b7212800be75cf7014116eb460017992b4b22b51e'
            '920074a8585dbdb9edeb4a75704c9e924cbd397fe6adf35b6a2b40db66bd28b1'
            'd592e9240506b406cb931fdc0c5f75b5b333d5e0ed9d4aed3e3d8494f9fd1b70'
            '37564727bc5d5c5da032802d395315734fad8b805bfa3d610b74fb2c371edcd8'
            'c578ed00aca3ab4baad777e942df1bc80b15cc9b64b4556ba2936b0987a9bea3')

prepare() {
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0001-offline-test-portability.patch"
  # Chrome AV1 on AVD: omacom/libva-v4l2_request#114, as nixos-aurora carries it, until it merges.
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0002-av1-chrome.patch"
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0003-av1-multitile.patch"
  # H.264 High 10 for ffmpeg/mpv without LIBVA_V4L2_H264_HIGH10: FFmpeg's VA-API biases pic_init_qp by
  # 6*(depth-8), which the kernel cannot undo, so the driver applies FFmpeg's convention when libavcodec is mapped.
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0004-driver-offer-H.264-High-10-to-libavcodec-clients-by-default.patch"
  # 10-bit into P010 surfaces when the decoder writes P010 (Apple AVD): with the Apple scaler exposed as a converter,
  # 10-bit configs only had NV12 surfaces and every HEVC Main10 / AV1 10-bit / VP9 p2 decode failed.
  patch -d "libva-v4l2_request-$_commit" -Np1 -i "$srcdir/0005-surface-decode-10-bit-into-P010-surfaces-when-the-de.patch"
}

build() {
  arch-meson "libva-v4l2_request-$_commit" build \
    --libdir=lib \
    -Ddriverdir=/usr/lib/dri \
    -Dstrip=false \
    -Dcodec_h264=enabled \
    -Dcodec_hevc=enabled \
    -Dcodec_vp9=enabled \
    -Dcodec_av1=enabled
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs --num-processes 4
}

package() {
  meson install -C build --destdir "$pkgdir"
  ln -s v4l2_request_drv_video.so "$pkgdir/usr/lib/dri/asahi_drv_video.so"
  # Aurora kernels name the AGX render node driver "aurora".
  ln -s v4l2_request_drv_video.so "$pkgdir/usr/lib/dri/aurora_drv_video.so"
  install -Dm644 "libva-v4l2_request-$_commit/COPYING" \
    "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 "libva-v4l2_request-$_commit/docs/SUPPORT.md" \
    "$pkgdir/usr/share/doc/$pkgname/SUPPORT.md"
}
