pkgname=speakerguardd
pkgver=0.1.13rc2
pkgrel=1
pkgdesc='Apple speaker protection: feed-forward with V/I sense guard, for every qualified Mac'
arch=('aarch64')
groups=('aurora-platform-apple-silicon')
url='https://github.com/aurora-silicon/speakerguardd'
license=('MIT')
# speakerguardd PR 27 (0.1.13-rc.2): do not merge before it is qualified and merged.
_commit=add7f9610d68b3ff898275d3e7d1cdcd8587c47c
makedepends=('git' 'rust' 'cargo' 'python' 'alsa-lib' 'pkgconf')
depends=('glibc' 'gcc-libs' 'alsa-lib')
# One speaker protection daemon. Removing speakersafetyd is safe: until
# speakerguardd takes a card's volume lock the kernel keeps it at its safe level.
conflicts=('speakersafetyd' 'speakersafetyd-aurora-profiles')
replaces=('speakersafetyd' 'speakersafetyd-aurora-profiles')
source=("speakerguardd::git+$url.git#commit=$_commit" 96-speakerguardd-aurora.rules)
sha256sums=('SKIP' 'bb78b7a9617c526c044e82423be8e9434a519f0bcc929dc60f2f8b68f02ec4b5')
build() {
  cd speakerguardd
  # The binary names its source in -V and the journal.
  SPEAKERGUARDD_COMMIT=${_commit::12} cargo build --locked --release ${CARGO_TARGET:+--target "$CARGO_TARGET"}
}
check() {
  cd speakerguardd
  cargo test --locked
}
package() {
  local binary=speakerguardd/target/release/speakerguardd
  if [[ -n ${CARGO_TARGET:-} ]]; then binary=speakerguardd/target/$CARGO_TARGET/release/speakerguardd; fi
  install -Dm755 "$binary" "$pkgdir/usr/bin/speakerguardd"
  install -d "$pkgdir/usr/share"
  cp -a speakerguardd/conf "$pkgdir/usr/share/speakerguardd"
  install -Dm644 speakerguardd/speakerguardd.service "$pkgdir/usr/lib/systemd/system/speakerguardd.service"
  install -Dm644 speakerguardd/95-speakerguardd.rules "$pkgdir/usr/lib/udev/rules.d/95-speakerguardd.rules"
  install -Dm755 speakerguardd/tools/preserve-recordings "$pkgdir/usr/lib/speakerguardd/preserve-recordings"
  install -Dm644 96-speakerguardd-aurora.rules "$pkgdir/usr/lib/udev/rules.d/96-speakerguardd-aurora.rules"
  install -Dm644 speakerguardd/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
