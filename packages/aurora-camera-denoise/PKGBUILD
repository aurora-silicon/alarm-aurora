pkgname=aurora-camera-denoise
pkgver=0.1.0
pkgrel=3
pkgdesc='PipeWire filter that denoises the built-in camera on Apple silicon laptops, like macOS'
arch=('aarch64')
groups=('aurora-platform-apple-silicon')
url='https://github.com/aurora-silicon/camera-denoise'
license=('MIT')
_commit=77e35ccbfd2f2b5c16a48caf501dd850c9430302
depends=('glibc' 'pipewire')
makedepends=('meson' 'ninja' 'systemd')
install=aurora-camera-denoise.install
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/aurora-silicon/camera-denoise/tar.gz/$_commit")
sha256sums=('bd3c92b0272e98e8651283a7848164e04faaa6d69feae3f699b61415c65f576b')

build() {
  # The binary looks for backends in $prefix/$libdir/aurora-camera-denoise, so
  # libdir is set here rather than left to meson's guess.
  arch-meson "camera-denoise-$_commit" build \
    --libdir=lib \
    -Ddaemon=enabled \
    -Dsystemduserunitdir=/usr/lib/systemd/user
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  # Backends such as the Neural Engine one install here later; the filter
  # falls back to the built-in CPU backend while it is empty.
  install -dm755 "$pkgdir/usr/lib/aurora-camera-denoise"
  # On by default for every user, like the camera filtering on macOS. A user
  # turns it off in denoise.conf or with systemctl --user mask.
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user-preset/80-aurora-camera-denoise.preset" <<'PRESET'
enable aurora-camera-denoise.service
PRESET
  install -Dm644 "camera-denoise-$_commit/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
