pkgname=aurora-sep
pkgver=1
pkgrel=17
pkgdesc='SEP trusted-key and fingerprint integration for Aurora'
arch=('any')
groups=('aurora-platform-apple-silicon')
license=('GPL-2.0-only')
url='https://github.com/aurora-silicon/linux'
install=aurora-sep.install
# Touch ID's polkit and sudo stacks are written by touchid-pam (see there), and
# the Plasma power-button default is the owner's to edit.
backup=('etc/xdg/powerdevilrc')
# The loader, its units and the Touch ID setup come from the kernel tree's
# tools/aurora-sep (sources.json "aurora-sep"); only the README and the PAM
# integration are kept here.
_commit=afbac7c1a27de3e07c455fad819021d9d99a5813
source=("linux-${_commit}.tar.gz::https://codeload.github.com/aurora-silicon/linux/tar.gz/${_commit}"
        'README.md'
        'touchid-pam'
        'aurora-sep-touchid-pam.hook')
sha256sums=('db8fa8945b2cff1af20e6b647fd543859e2a49e031910fc8bc84b0e71c457438'
            '08ecac0ecf885cb7f7547df1eb3d373849162778d60d838c4ecc58a45fdfe576'
            '553f85d5836315dae874f73d54b56b437a828151cb37d37f7ea4a12027f6b567'
            '6abed047c5402bb752823878ac8dbcd47982b79156ed4c8233bd9c94438ae5bc')
noextract=("linux-${_commit}.tar.gz")

prepare() {
  rm -rf sep
  mkdir sep
  bsdtar -xf "linux-${_commit}.tar.gz" -C sep --strip-components 3 "linux-${_commit}/tools/aurora-sep"
}

package() {
  depends=('coreutils' 'fprintd-aurora>=1.94.5' 'keyutils' 'kmod' 'python' 'util-linux' 'grep' 'gawk' 'systemd' 'libfprint-aurora>=1.94.100-3')
  optdepends=('glib2-devel: fingerprint at the GNOME login screen (aurora-sep-greeter-fingerprint.service)')
  # Holds a packaged linux-aurora to one with the module-based SEP driver and
  # leaves a kernel from outside pacman alone; the units skip a kernel without
  # a loadable apple_sep.
  conflicts=('linux-aurora<7.2.10-4')
  cd sep
  install -Dm755 load-driver "$pkgdir/usr/libexec/aurora-sep-load"
  install -Dm755 aurora-sep-ready "$pkgdir/usr/libexec/aurora-sep-ready"
  install -Dm755 aurora-sep-greeter-fingerprint "$pkgdir/usr/libexec/aurora-sep-greeter-fingerprint"
  install -Dm755 sensor-present "$pkgdir/usr/libexec/aurora-sep-sensor-present"
  install -Dm755 touchid-setup-needed "$pkgdir/usr/libexec/aurora-touchid-setup-needed"
  install -Dm755 aurora-touchid-setup "$pkgdir/usr/bin/aurora-touchid-setup"
  install -Dm755 aurora-sep-policy-change "$pkgdir/usr/bin/aurora-sep-policy-change"
  install -Dm755 sep-bio-identities "$pkgdir/usr/bin/sep-bio-identities"
  install -Dm755 extract-mesa-calibration.py "$pkgdir/usr/libexec/aurora/extract-mesa-calibration"
  for name in aurora-sep.service aurora-sep-ready.service aurora-sep.timer aurora-sep-greeter-fingerprint.service \
              aurora-sep-greeter-refresh.service aurora-touchid-setup.service; do
    install -Dm644 "$name" "$pkgdir/usr/lib/systemd/system/$name"
  done
  install -Dm644 fprintd-aurora.conf "$pkgdir/usr/lib/systemd/system/fprintd.service.d/aurora-sep.conf"
  # The units name their helpers under /usr/local/sbin.
  sed -i -e 's|^\(Exec[A-Za-z]*=\)/usr/local/sbin/aurora-touchid-setup |\1/usr/bin/aurora-touchid-setup |' \
    -e 's|^\(Exec[A-Za-z]*=\)/usr/local/sbin/|\1/usr/libexec/|' \
    "$pkgdir"/usr/lib/systemd/system/*.service "$pkgdir/usr/lib/systemd/system/fprintd.service.d/aurora-sep.conf"
  ! grep -rq /usr/local "$pkgdir/usr/lib/systemd"
  install -Dm644 aurora-sep-load.conf "$pkgdir/usr/lib/modprobe.d/aurora-sep-load.conf"
  sed 's|@FPRINTD@|/usr/lib/fprintd|' fprintd-no-timeout.conf.in > fprintd-no-timeout.conf
  install -Dm644 fprintd-no-timeout.conf "$pkgdir/usr/lib/systemd/system/fprintd.service.d/50-aurora-sep-no-timeout.conf"
  # The greeter unit is not listed, so it stays off until enabled.
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system-preset/80-aurora-sep.preset" <<'EOF'
enable aurora-sep.timer
EOF
  for name in XART-SAFETY.md OS-IDENTITY.md; do
    install -Dm644 "$name" "$pkgdir/usr/share/doc/aurora-sep/$name"
  done
  # A short press of the power button (the Touch ID sensor) suspends.
  install -Dm644 logind-aurora-sep.conf "$pkgdir/usr/lib/systemd/logind.conf.d/50-aurora-sep.conf"
  install -Dm644 powerdevilrc "$pkgdir/etc/xdg/powerdevilrc"
  cd ..
  install -Dm644 README.md "$pkgdir/usr/share/doc/aurora-sep/README.md"
  install -Dm755 touchid-pam "$pkgdir/usr/libexec/aurora/touchid-pam"
  install -Dm644 aurora-sep-touchid-pam.hook "$pkgdir/usr/share/libalpm/hooks/aurora-sep-touchid-pam.hook"
}
