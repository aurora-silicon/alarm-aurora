pkgname=aurora-sep
pkgver=1
pkgrel=6
pkgdesc='SEP trusted-key and fingerprint integration for Aurora'
arch=('any')
groups=('aurora-platform-apple-silicon')
license=('GPL-2.0-only')
url='https://github.com/aurora-silicon/linux'
source=('load-driver' 'aurora-sep.service' 'fprintd-aurora.conf' 'README.md' 'XART-SAFETY.md' 'aurora-sep-ready' 'aurora-sep-ready.service' 'fprintd-no-timeout.conf.in' 'prepare-sep-calibration' 'extract-mesa-calibration' 'aurora-sep.timer' 'aurora-sep-load.conf' 'sensor-present' 'provenance.json' )
sha256sums=('98d88d028d4a1e703cc9a3bb20d3248d9cd33899288b51bd17fa6af4d71e56df'
