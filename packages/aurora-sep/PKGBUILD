pkgname=aurora-sep
pkgver=1
pkgrel=19
pkgdesc='SEP trusted-key and fingerprint integration for Aurora'
arch=('any')
groups=('aurora-platform-apple-silicon')
license=('GPL-2.0-only')
url='https://github.com/aurora-silicon/linux'
install=aurora-sep.install
# Touch ID's polkit and sudo stacks are written by touchid-pam (see there), and
# the Plasma power-button default is the owner's to edit.
backup=('etc/xdg/powerdevilrc')
source=('load-driver' 'aurora-sep.service' 'fprintd-aurora.conf' 'README.md' 'XART-SAFETY.md' 'OS-IDENTITY.md' 'aurora-sep-ready' 'aurora-sep-ready.service' 'fprintd-no-timeout.conf.in' 'aurora-touchid-setup' 'extract-mesa-calibration' 'aurora-sep.timer' 'aurora-sep-load.conf' 'sensor-present' 'aurora-sep-greeter-fingerprint' 'aurora-sep-greeter-fingerprint.service' 'logind-aurora-sep.conf' 'provenance.json' 'aurora-touchid-setup.service' 'touchid-setup-needed' 'touchid-pam' 'aurora-sep-touchid-pam.hook' 'powerdevilrc' 'aurora-sep-modprobe.conf')
