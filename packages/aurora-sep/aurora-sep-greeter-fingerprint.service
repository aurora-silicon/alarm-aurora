[Unit]
Description=Offer fingerprint at the GNOME login screen
Documentation=file:///usr/share/doc/aurora-sep/README.md
# Generate the overlays before the greeter reads its resources. SEP activation
# and template restore proceed independently; the overlay watches readiness.
Before=gdm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/aurora-sep-greeter-fingerprint
ExecStop=/usr/local/sbin/aurora-sep-greeter-fingerprint stop

[Install]
WantedBy=gdm.service
