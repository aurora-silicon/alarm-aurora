pkgname=aurora-fido
pkgver=0.2.0
pkgrel=1
pkgdesc='Touch ID as a FIDO2/U2F security key for WebAuthn, SSH, pam_u2f (opt in: sudo aurora-fido enable)'
arch=('aarch64')
groups=('aurora-platform-apple-silicon')
url='https://github.com/aurora-silicon/aurora-sep-userspace'
license=('MIT')
_commit=d579a030e7a1d392f1f78ea686c4fb814e6c037a
makedepends=('gcc' 'make' 'pkgconf' 'json-c')
checkdepends=('python' 'python-cryptography')
optdepends=('libnotify: the "Touch ID to sign in to <site>" notification'
            'libfido2: fido2-token and friends'
            'pam-u2f: sudo and login with the security key')
backup=('etc/aurora-fido/aurora-fido.conf')
source=("aurora-sep-userspace-$_commit.tar.gz::https://codeload.github.com/aurora-silicon/aurora-sep-userspace/tar.gz/$_commit")
sha256sums=('7fbb9a7c32efc38142fb8945ea0e34c19a72ca08e87f780c477c0ab75c7f8a1b')

build() {
  make -C "aurora-sep-userspace-$_commit/fido" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS" \
    LIBEXECDIR=/usr/lib/aurora-fido
}

check() {
  # Unit tests: software stand-ins, no root, no hardware.
  make -C "aurora-sep-userspace-$_commit/fido" check
}

package() {
  # Runtime dependencies here, as in aurora-boot: aurora-sep comes from the
  # Aurora repository, which the build root does not have.
  depends=('python' 'python-cryptography' 'aurora-sep' 'json-c' 'systemd')
  # Installed off: no install script enables it. `sudo aurora-fido enable` turns it on.
  make -C "aurora-sep-userspace-$_commit/fido" install DESTDIR="$pkgdir" PREFIX=/usr \
    LIBEXECDIR=/usr/lib/aurora-fido
  install -Dm644 "aurora-sep-userspace-$_commit/LICENSES/MIT.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
