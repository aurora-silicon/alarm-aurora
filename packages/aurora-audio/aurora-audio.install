# aurora-audio post-install/upgrade hook: migrate default installs to
# speakerguardd v2 while preserving an explicit user opt-out in
# /etc/aurora/speaker-stack.conf.
post_install() {
  /usr/bin/aurora-speaker-stack migrate --on-upgrade || :
}
post_upgrade() {
  /usr/bin/aurora-speaker-stack migrate --on-upgrade || :
}
