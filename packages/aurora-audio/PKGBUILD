pkgname=aurora-audio
pkgver=4.1.aurora2
pkgrel=19
pkgdesc='Aurora Apple Silicon PipeWire/WirePlumber microphone, jack and card profiles (speakers: speakerguardd v2)'
arch=('any')
groups=('aurora-platform-apple-silicon')
url='https://github.com/aurora-silicon/asahi-audio'
license=('MIT')
_commit=a8c68c27c448ff39c915b46b8d33c53f2c56b705
makedepends=('make' 'patch')
provides=("asahi-audio=$pkgver" "asahi-audio-aurora=$pkgver")
# speakerguardd v2 is the speaker stack of every install: this package, which
# every install has, retires the Asahi stack (speakersafetyd, its Aurora
# profiles and speakerguardd 0.1) on the upgrade. speakersafetyd is replaced
# only up to the builds this repository shipped (2.0.1-1.2, profiles 1-2) and
# never conflicted, so a speakersafetyd a user later installs and selects on
# purpose is not replaced again by the next pacman -Syu. The v2 preview builds
# up to RC7 (1.0.0alpha.1-25) stay replaced.
conflicts=('asahi-audio' 'asahi-audio-aurora' 'speakerguardd-v2<=1.0.0alpha.1-25' 'speakerguardd<0.2')
replaces=('asahi-audio-aurora' 'speakerguardd-v2<=1.0.0alpha.1-25'
          'speakersafetyd<2.0.1-2' 'speakersafetyd-aurora-profiles<1-3' 'speakerguardd<0.2')
backup=('etc/mkinitcpio.conf.d/90-aurora-audio.conf')
# speakerguardd v2 drives every Mac's speakers from the Mac's own tuning: no
# speaker graph, speaker FIR or raw speaker volume lock is installed.
source=("aurora-audio-${_commit}.tar.gz::https://codeload.github.com/aurora-silicon/asahi-audio/tar.gz/$_commit"
        90-aurora-audio.conf aurora-audio.hook 0001-install-no-speaker-graphs.patch
        99-aurora-speaker-irq.conf)
sha256sums=('d054fa799500ec845b8dbb7cc18d653d836cda9dd3780da76f71a4aa1bb71a96' '51aa32a5520783b65c972e9721a571a7a47b802f0b278b5c9a3ff9fbc4885fa7' 'a39355d15c1cfd16372d0921313c80def045c6524b6938d3c041551a322e7953'
            '4c146c48cd15ad0c22bc7465c98b42751ec213a920286de8cdb37b31482de4c8' '643cf124571214174d84a8b78ffb3e61edaffc12246890eeb00dd3437fc830a4')
prepare() {
  patch -d "asahi-audio-$_commit" -Np1 < 0001-install-no-speaker-graphs.patch
}
check() {
  local root="$srcdir/check-root" wp f board
  make -C "asahi-audio-$_commit" install DESTDIR="$root" PREFIX=/usr
  wp="$root/usr/share/wireplumber/wireplumber.conf.d/99-asahi.conf"
  # No speaker graph, speaker FIR or speaker rule of the Asahi stack.
  test -z "$(find "$root/usr/share/asahi-audio" \( -name 'graph*.json' -o -name '*.wav' \) -print)"
  if grep -Eq 'graph[^"/]*\.json|RawSpeakers|asahi-lock-volume' "$wp"; then
    echo '99-asahi.conf still creates or locks a speaker path' >&2; return 1
  fi
  test ! -e "$root/usr/share/wireplumber/scripts/device/asahi-lock-volume.lua"
  # Every filter the rules create is installed: the microphone graphs.
  for f in $(grep -o '/usr/share/asahi-audio/[^"]*' "$wp"); do
    test -s "$root$f"
  done
  for board in j293 j313 j314 j316 j413 j415 j604 j614 j616 j700 j714; do
    test -s "$root/usr/share/asahi-audio/$board/mic.json"
  done
  rm -rf "$root"
}
package() {
  # The profile files can be packaged without installing the target audio stack.
  # speakerguardd v2 is the only speaker protection; aurora-speaker-upgrade
  # moves a Mac to it with its own tuning.
  depends=('alsa-ucm-conf-aurora' 'pipewire-audio' 'wireplumber>=0.5.16' 'bankstown' 'triforce-lv2'
           'lsp-plugins-lv2' 'alsa-utils-aurora'
           'speakerguardd-v2>=1.0.0alpha.2-13' 'aurora-speaker-upgrade>=0.1-0.29')
  make -C "asahi-audio-$_commit" install DESTDIR="$pkgdir" PREFIX=/usr
  install -Dm644 "asahi-audio-$_commit/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 90-aurora-audio.conf "$pkgdir/etc/mkinitcpio.conf.d/90-aurora-audio.conf"
  install -Dm644 aurora-audio.hook "$pkgdir/usr/share/libalpm/hooks/95-aurora-audio.hook"
  # MCA speaker PCMs wake on period interrupts: a chrony slew no longer re-prepares the sink.
  install -Dm644 99-aurora-speaker-irq.conf "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/99-aurora-speaker-irq.conf"
}
