pkgname=aurora-audio
pkgver=4.1.aurora2
pkgrel=2
pkgdesc='Aurora Apple Silicon PipeWire/WirePlumber DSP profiles including J700'
arch=('any')
groups=('aurora-platform-apple-silicon')
url='https://github.com/aurora-silicon/asahi-audio'
license=('MIT')
_commit=b2da7512e9bfcd5837355d2393f3c43219acf6b9
makedepends=('git' 'make')
provides=("asahi-audio=$pkgver" "asahi-audio-aurora=$pkgver")
conflicts=('asahi-audio' 'asahi-audio-aurora')
replaces=('asahi-audio-aurora')
source=("asahi-audio::git+$url.git#commit=$_commit")
sha256sums=('SKIP')
package() {
  # The profile files can be packaged without installing the target audio stack.
  depends=('alsa-ucm-conf-aurora' 'pipewire-audio' 'wireplumber' 'bankstown' 'triforce-lv2'
           'lsp-plugins-lv2' 'speakersafetyd' 'speakerguardd')
  make -C asahi-audio install DESTDIR="$pkgdir" PREFIX=/usr
  install -Dm644 asahi-audio/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
