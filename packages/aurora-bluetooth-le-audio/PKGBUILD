            '811207d92b81da5b5e97cdfa52542769d8783325da5b422262ccecfa2d23c5a9')
package() {
  install -Dm644 le-audio.conf "$pkgdir/etc/bluetooth/le-audio.conf"
  install -Dm644 bluetooth.service.conf "$pkgdir/usr/lib/systemd/system/bluetooth.service.d/50-aurora-le-audio.conf"
  install -Dm644 50-aurora-le-audio.conf "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/50-aurora-le-audio.conf"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
