source=(le-audio.conf bluetooth.service.conf 50-aurora-le-audio.conf README.md LICENSE)
sha256sums=('99c6f168f978fe885229cd65d1f8f2e285c95d0202487eb1c74219e82c1d644e'
            '9d7034521d4e60a75324afc5e159ef1ff1ae7f9845cb2b45002fbb64e476c9b0'
            '6bc3e900b3be3a526853756529452db70dcdf78973d8ec2139a758cca592c2d8'
