# Open replacement firmware for the Apple Video Decoder.
# Built from the pinned Aurora source, without extracting proprietary firmware.

pkgname=avd-fw
pkgver=0.1.aurora2
_commit=66c3911bbaebdca90a179aa74c7addde9b2963ce
pkgrel=1
pkgdesc='Open replacement firmware for the Apple Video Decoder (AVD) on Apple Silicon'
# This recipe uses the native ARM linker and serves Apple Silicon systems.
# Restrict both builds and publication to aarch64.
arch=('aarch64')
groups=('aurora-platform-apple-silicon')
url='https://github.com/aurora-silicon/avd-fw'
license=('MIT')
# clang cross-compiles to arm-none-eabi out of the box, so no arm-none-eabi
# toolchain is required; llvm supplies llvm-objcopy, which meson.build looks
# up by name to turn each linked ELF into a padded raw image.
# LLVM 23 changes image bytes; the shared hash manifest requires LLVM 22.
makedepends=('meson' 'clang22' 'llvm22' 'lld22' 'python')
# !buildflags is load-bearing: makepkg's CFLAGS/LDFLAGS target the aarch64 host
# and would be injected into a bare-metal Cortex-M3 build. !strip keeps makepkg
# from running the host strip over raw firmware images.
options=('!strip' '!debug' '!buildflags' '!lto')
source=("$pkgname-$_commit.tar.gz::https://codeload.github.com/aurora-silicon/avd-fw/tar.gz/$_commit")
sha256sums=('b7353f5fefea60b2d3aa63a1424fade72c87f27159685c30234e1b310b97af88')

build() {
  export PATH="/usr/lib/llvm22/bin:$PATH"
  # The cross file selects clang, pins the host machine to cortex-m3 and sets
  # libdir=lib, which lands the images in /usr/lib/firmware/apple.
  #
  # Upstream defaults match Make (-O2, no debug) for reproducible images.
  meson setup \
    --cross-file "$pkgname-$_commit/llvm.ini" \
    --prefix=/usr \
    "$pkgname-$_commit" build

  meson compile -C build
}

check() {
  export PATH="/usr/lib/llvm22/bin:$PATH"
  python - <<'CHECK'
from pathlib import Path
import hashlib
import struct
# clang 22, upstream Make and Meson defaults must produce these exact images.
expected = [
    ('v2-t0', 0xc000, '2f6e5cc57c25e1a80720e514326e10a25c4afc013670aacce89d9a9dd3439aef'),
    ('v3-t0', 0x10000, '5d26b2d170de7782f05268207e7fcb73eef3a4d240b5a4fd4f0a76d0b60fe12b'),
    ('v3-t1', 0x10000, 'f49ebf15cdccdd9d76b15695157fe27dfef93087d406639de0e126fef81300bd'),
    ('v4-t0', 0x12000, 'af6f7034ef40c897b22e8285138c839b0a568270c0fbb9521a43eb37e8a3020e'),
    ('v5-t0', 0x10000, '96f2189d39d751266c12401345daca333055da48f76293e4dcdbdbd705cd2d1a'),
    ('v5-t1', 0x12000, 'f5d516f3ce1ca8ebe850cf0428fff07e487662e7f7981b2991a0070449d82479'),
    ('v5-t2', 0x12000, '931f33bb99e68c7d8fccb2bbe976ddd9914f7235a98851d9ab8a9a1ba515526d'),
]
for name, size, expected_hash in expected:
    files = list(Path('build').rglob('avd-fw-' + name + '.bin'))
    assert len(files) == 1 and files[0].stat().st_size == size, name
    firmware = files[0].read_bytes()
    actual_hash = hashlib.sha256(firmware).hexdigest()
    print(f"{actual_hash}  {files[0].name}", flush=True)
    if actual_hash != expected_hash:
        raise SystemExit(f"{name}: expected {expected_hash}, got {actual_hash}; check the clang toolchain")
    elf = (Path('build') / ('avd-fw-' + name + '.elf')).read_bytes()
    assert elf[:6] == b'\x7fELF\x01\x01' and struct.unpack_from('<H', elf, 18)[0] == 40
    stack, reset = struct.unpack_from('<II', firmware)
    entry = struct.unpack_from('<I', elf, 24)[0]
    assert stack and stack % 8 == 0 and reset & 1 and reset == entry, name
    assert 0 < (reset & ~1) < size, name
CHECK
}

package() {
  export PATH="/usr/lib/llvm22/bin:$PATH"
  meson install -C build --destdir "$pkgdir"
  # Retain the exact linked symbols alongside the open firmware.
  for elf in build/avd-fw-*.elf; do
    install -Dm644 "$elf" "$pkgdir/usr/lib/debug/firmware/apple/${elf##*/}"
  done

  # meson installs custom_target outputs 0755; these are firmware blobs, not
  # programs, and every other firmware file on the system is 0644.
  chmod 644 "$pkgdir"/usr/lib/firmware/apple/*.bin

  install -Dm644 "$pkgname-$_commit/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
