pkgname=aurora-sep-luks
pkgver=0.2.0
pkgrel=1
pkgdesc='Unlock LUKS2 volumes with the Apple Secure Enclave (aurora-sep-cryptenroll + cryptsetup token)'
arch=('aarch64')
url='https://github.com/aurora-silicon/aurora-sep-userspace'
license=('MIT')
_commit=63d93436495a8e044d5e1536b4f06da27fbb8b5f
depends=('cryptsetup' 'json-c' 'aurora-sep')
makedepends=('gcc' 'make' 'pkgconf')
optdepends=('mkinitcpio: open SEP-sealed volumes, root included, in a systemd-based initramfs (aurora-sep hook)')
source=("aurora-sep-userspace-$_commit.tar.gz::https://codeload.github.com/aurora-silicon/aurora-sep-userspace/tar.gz/$_commit")
sha256sums=('0ba84822727c9d12373dd2e04dc753208f0c875039013adcd63e067251b06b2c')

build() {
  make -C "aurora-sep-userspace-$_commit/luks" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
}

check() {
  # 77: the build root blocks the kernel keyring (seccomp), skipped.
  make -C "aurora-sep-userspace-$_commit/luks" test/test-seal CFLAGS="$CFLAGS"
  "aurora-sep-userspace-$_commit/luks/test/test-seal" || [ $? = 77 ]
}

package() {
  # Nothing is enrolled by installing: aurora-sep-cryptenroll is run per volume.
  make -C "aurora-sep-userspace-$_commit/luks" install install-mkinitcpio DESTDIR="$pkgdir" PREFIX=/usr \
    TOKENDIR=/usr/lib/cryptsetup LIBEXECDIR=/usr/lib/aurora-sep
  install -Dm644 "aurora-sep-userspace-$_commit/docs/luks-sep-initrd.md" "$pkgdir/usr/share/doc/$pkgname/luks-sep-initrd.md"
  install -Dm644 "aurora-sep-userspace-$_commit/docs/luks-sep.md" "$pkgdir/usr/share/doc/$pkgname/luks-sep.md"
  install -Dm644 "aurora-sep-userspace-$_commit/LICENSES/MIT.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
