# Name Apple Silicon platform GPUs for switcheroo-control (which reads
# SWITCHEROO_CONTROL_{VENDOR,PRODUCT}_NAME on the DRM render node's parent
# platform device, matching how PCI GPUs get names from 20-pci-vendor-model.hwdb).

of:N*T*Capple,agx-*
 SWITCHEROO_CONTROL_VENDOR_NAME=Apple
 SWITCHEROO_CONTROL_PRODUCT_NAME=Silicon GPU

of:N*T*Capple,agx-t8103*
of:N*T*Capple,agx-g13g*
 SWITCHEROO_CONTROL_PRODUCT_NAME=M1 GPU

of:N*T*Capple,agx-t6000*
of:N*T*Capple,agx-g13s*
of:N*T*Capple,agx-g13x*
 SWITCHEROO_CONTROL_PRODUCT_NAME=M1 Pro GPU

of:N*T*Capple,agx-t6001*
of:N*T*Capple,agx-g13c*
 SWITCHEROO_CONTROL_PRODUCT_NAME=M1 Max GPU

of:N*T*Capple,agx-t6002*
of:N*T*Capple,agx-g13d*
 SWITCHEROO_CONTROL_PRODUCT_NAME=M1 Ultra GPU

of:N*T*Capple,agx-t8112*
of:N*T*Capple,agx-g14g*
 SWITCHEROO_CONTROL_PRODUCT_NAME=M2 GPU

of:N*T*Capple,agx-t6020*
of:N*T*Capple,agx-g14s*
of:N*T*Capple,agx-g14x*
 SWITCHEROO_CONTROL_PRODUCT_NAME=M2 Pro GPU

