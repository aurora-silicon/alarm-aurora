pkgname=aurora-system-fixes
pkgver=1
pkgrel=2
pkgdesc='Aurora systemd drop-ins awaiting named upstream fixes'
arch=('any')
url='https://github.com/aurora-silicon/alarm-aurora'
license=('MIT')
depends=('systemd' 'bluez>=5.87')
source=(malcontent-signal.conf malcontent-webd-update-signal.conf LICENSE 50-after-swapfile.conf)
sha256sums=('d4e37dcfda529120f3a0e24e8b60fea6e16e4fb115a91e77bf1d03565f2621c5' '866a2b6a4d7c7408a0a3b9d33a932c548c4fedec6917d414f237f0064e7aa6f1' '811207d92b81da5b5e97cdfa52542769d8783325da5b422262ccecfa2d23c5a9'
            '47f566640dbb31023b46db86695608adea7782e00f49f622e50be21491455a10')

package() {
  install -Dm644 50-after-swapfile.conf \
    "$pkgdir/usr/lib/systemd/system/var-swap-swapfile2.swap.d/50-after-swapfile.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  local unit
  for unit in malcontent-timerd malcontent-timer-extension-agent malcontent-webd; do
    install -Dm644 malcontent-signal.conf \
      "$pkgdir/usr/lib/systemd/system/$unit.service.d/50-aurora-signal.conf"
  done
  install -Dm644 malcontent-webd-update-signal.conf \
    "$pkgdir/usr/lib/systemd/system/malcontent-webd-update.service.d/50-aurora-signal.conf"
}
