package() {
  # Built in this repository, so not a build-time dependency.
  depends+=('aurora-panel-nits' 'aurora-nvram' 'aurora-btsync' 'aurora-wifisync')
  install -Dm644 50-after-swapfile.conf \
    "$pkgdir/usr/lib/systemd/system/var-swap-swapfile2.swap.d/50-after-swapfile.conf"
  install -Dm644 61-aurora-dmi-id.rules "$pkgdir/usr/lib/udev/rules.d/61-aurora-dmi-id.rules"
  # The GPU card only renders (the display is apple-drm); mutter leaves it alone.
  install -Dm644 62-aurora-gpu-render-only.rules "$pkgdir/usr/lib/udev/rules.d/62-aurora-gpu-render-only.rules"
  # Wake for network access follows the power adapter, as on macOS laptops.
  install -Dm755 aurora-wake-for-network "$pkgdir/usr/lib/aurora/aurora-wake-for-network"
  install -Dm644 63-aurora-wake-for-network.rules "$pkgdir/usr/lib/udev/rules.d/63-aurora-wake-for-network.rules"
  # Trackpad clicks from the host, as macOS does, where the MTP trackpad has a haptic actuator.
  install -Dm644 64-aurora-trackpad-clicks.rules "$pkgdir/usr/lib/udev/rules.d/64-aurora-trackpad-clicks.rules"
  # /dev/accel (the Neural Engine) for the accel group and the local session
  # user, instead of systemd's mode 0666. systemd's pacman hooks create the
  # group from sysusers.d and reload the rules; ours then sends existing
  # accel nodes an add event, which (unlike change) reapplies GROUP and MODE.
  install -Dm644 70-aurora-accel.rules "$pkgdir/usr/lib/udev/rules.d/70-aurora-accel.rules"
  install -Dm644 aurora-accel.sysusers "$pkgdir/usr/lib/sysusers.d/aurora-accel.conf"
  install -Dm644 36-aurora-accel-permissions.hook \
    "$pkgdir/usr/share/libalpm/hooks/36-aurora-accel-permissions.hook"
  # Trackpads whose kernel decides palms by size itself (T6041: J614c, J616c): no libinput palm size threshold.
  install -Dm644 60-aurora-trackpad-palms.quirks "$pkgdir/usr/share/libinput/60-aurora-trackpad-palms.quirks"
  # The Mission Control key (F3, XF86LaunchA) opens the GNOME overview, as on macOS.
  # glib2's pacman hook compiles it; without gnome-shell the override is ignored.
  install -Dm644 60_aurora-apple-keys.gschema.override \
    "$pkgdir/usr/share/glib-2.0/schemas/60_aurora-apple-keys.gschema.override"
  install -Dm644 60-aurora-dmi-vendor.hwdb "$pkgdir/usr/lib/udev/hwdb.d/60-aurora-dmi-vendor.hwdb"
  # A stalled reboot or kexec is reset within the Apple watchdog's ~178 s range (systemd default: 10 min).
  install -Dm644 90-aurora-reboot-watchdog.conf "$pkgdir/usr/lib/systemd/system.conf.d/90-aurora-reboot-watchdog.conf"
  # Apple silicon power defaults: PCIe ASPM substates, no realtime utilization floor.
  # Wanted by sysinit.target from the package itself, so upgrades get it too;
  # ConditionFirmware skips machines that are not Apple silicon Macs.
  install -Dm644 aurora-power-defaults.service "$pkgdir/usr/lib/systemd/system/aurora-power-defaults.service"
  install -d "$pkgdir/usr/lib/systemd/system/sysinit.target.wants"
  ln -s ../aurora-power-defaults.service "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/aurora-power-defaults.service"
  # Enable 802.11 power save on Apple Broadcom (brcmfmac) radios.
  install -Dm644 85-aurora-brcmfmac-powersave.conf \
    "$pkgdir/usr/lib/NetworkManager/conf.d/85-aurora-brcmfmac-powersave.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  local unit
  for unit in malcontent-timerd malcontent-timer-extension-agent malcontent-webd; do
    install -Dm644 malcontent-signal.conf \
      "$pkgdir/usr/lib/systemd/system/$unit.service.d/50-aurora-signal.conf"
  done
  install -Dm644 malcontent-webd-update-signal.conf \
    "$pkgdir/usr/lib/systemd/system/malcontent-webd-update.service.d/50-aurora-signal.conf"
  for unit in drkonqi-coredump-cleanup.timer drkonqi-sentry-postman.path; do
    install -Dm644 drkonqi-ordering.conf "$pkgdir/usr/lib/systemd/user/$unit.d/50-aurora-ordering.conf"
  done
  install -Dm644 nm-dispatcher-persist.conf \
    "$pkgdir/usr/lib/systemd/system/NetworkManager-dispatcher.service.d/50-aurora-persist.conf"
}
