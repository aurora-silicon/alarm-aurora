# pre_upgrade is read from the incoming package, so the first fixed upgrade
# also unmounts the read-only directory before pacman extracts its payload.
pre_upgrade() {
  if [ -d /run/systemd/system ] && systemctl -q is-active aurora-fex-mesa.service; then
    systemctl stop aurora-fex-mesa.service || return 1
    touch /run/aurora-fex-mesa.upgrade
  fi
}

post_upgrade() {
  if [ -e /run/aurora-fex-mesa.upgrade ]; then
    systemctl daemon-reload
    systemctl start aurora-fex-mesa.service || return 1
    rm -f /run/aurora-fex-mesa.upgrade
  fi
}

pre_remove() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable --now aurora-fex-mesa.service || return 1
  fi
}
