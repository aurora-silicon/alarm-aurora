#!/bin/bash
# aurora-flatpak-gl enable|disable|status
#
# enable:  install org.freedesktop.Platform.GL.aurora for every branch in the
#          packaged OSTree repository (system installation, pinned so
#          "flatpak uninstall --unused" keeps it), and set the system-wide
#          Flatpak override that points the Vulkan loader, glvnd and the DRI
#          loader at the merged GL driver files.
# disable: undo all of that. Override keys an administrator has changed are
#          left alone.
#
# The override paths are the GL extension point's merged directories, not a
# single extension's. GL.aurora has a higher priority than GL.default, so it
# owns those file names whenever it is installed for the app's runtime; for a
# runtime branch it was not built for, the same paths fall back to GL.default.
# Overrides cannot be per architecture, so each variable lists the aarch64 and
# the x86_64 files: a sandbox only has its own architecture's GL directory,
# and the loaders skip the other one's files.
set -u
repo=${AURORA_FLATPAK_GL_REPO:-/usr/share/aurora-flatpak-gl/repo}
remote=aurora-gl
id=org.freedesktop.Platform.GL.aurora
# The x86_64 extension trees, and the FEX bundle each of them carries as
# files/fex: Flatpak mounts it at the path where fex-emu installs it, so the
# loader and RPATH of the FEX that binfmt_misc starts resolve in the sandbox.
x86_trees=/usr/share/aurora-flatpak-gl/x86_64
fex=/usr/lib/x86_64-linux-gnu/GL/aurora/fex
x86_repo=/var/lib/aurora-flatpak-gl/repo
x86_remote=aurora-gl-x86_64
a64=/usr/lib/aarch64-linux-gnu/GL
x64=/usr/lib/x86_64-linux-gnu/GL
overrides=${AURORA_FLATPAK_GL_OVERRIDES:-/var/lib/flatpak/overrides/global}
env_vk="VK_DRIVER_FILES=$a64/vulkan/icd.d/asahi_icd.aarch64.json:$a64/vulkan/icd.d/lvp_icd.aarch64.json:$x64/vulkan/icd.d/asahi_icd.x86_64.json:$x64/vulkan/icd.d/lvp_icd.x86_64.json"
env_egl="__EGL_VENDOR_LIBRARY_FILENAMES=$a64/glvnd/egl_vendor.d/50_mesa.json:$x64/glvnd/egl_vendor.d/50_mesa.json"
env_dri="LIBGL_DRIVERS_PATH=$a64/lib/dri:$x64/lib/dri"
# FEX in an x86_64 sandbox maps this guest vDSO (no host library needed).
env_thunks="FEX_THUNKGUESTLIBS=$x64/aurora/fex/GuestThunks"
# Values earlier releases wrote; enable replaces them, disable removes them.
legacy=("VK_DRIVER_FILES=$a64/vulkan/icd.d/asahi_icd.aarch64.json:$a64/vulkan/icd.d/lvp_icd.aarch64.json"
        "__EGL_VENDOR_LIBRARY_FILENAMES=$a64/glvnd/egl_vendor.d/50_mesa.json"
        "LIBGL_DRIVERS_PATH=$a64/lib/dri")

repo_refs() {
  local d=$repo/refs/heads/runtime/$id/aarch64
  [ -d "$d" ] && ls -1 "$d" | sort | sed "s|^|runtime/$id/aarch64/|"
}

x86_branches() {
  [ -d "$x86_trees" ] || return 0
  local d
  for d in "$x86_trees"/*/; do
    [ -f "$d/metadata" ] && basename "$d"
  done | sort
}

installed_refs() {
  local refs
  refs=$(flatpak list --system --runtime --columns=ref) || {
    echo "aurora-flatpak-gl: failed to query installed runtimes" >&2
    return 1
  }
  printf '%s\n' "$refs" | grep "^$id/" | sed 's|^|runtime/|'
}

remote_names() {
  flatpak remotes --system --columns=name || {
    echo "aurora-flatpak-gl: failed to query remotes" >&2
    return 1
  }
}

# Add the remote, or point it at the repository if it exists. The caller
# passes the names it has already listed, so a failed query is not "absent".
add_remote() {
  local name=$1 url=$2 title=$3 remotes=$4
  if grep -qxF "$name" <<< "$remotes"; then
    flatpak remote-modify --system --url="$url" "$name"
  else
    flatpak remote-add --system --no-gpg-verify --no-enumerate --no-use-for-deps \
      --title="$title" "$name" "$url"
  fi
}

install_ref() {
  flatpak install --system --noninteractive -y --or-update "$1" "$2" || return 1
  # Unpinned, "flatpak uninstall --unused" would remove it.
  flatpak pin --system "$2" >/dev/null || return 1
}

# Export the x86_64 trees with this host's FEX bundle and guest vDSO thunk into
# a local repository and install them. Run again when fex-emu or the trees
# change (the package's pacman hook does).
enable_x86() {
  local remotes=$1 branches
  branches=$(x86_branches)
  [ -n "$branches" ] || return 0
  if [ ! -x "$fex/FEX" ] || [ ! -f "$fex/GuestThunks/libVDSO-guest.so" ]; then
    echo "aurora-flatpak-gl: no complete FEX bundle at $fex; the x86_64 GL extension needs fex-emu" >&2
    return 1
  fi
  local rc=0 branch work
  # flatpak build-export creates the repository; it must not exist empty.
  install -d -m755 "${x86_repo%/*}" || return 1
  for branch in $branches; do
    work=$(mktemp -d "${TMPDIR:-/var/tmp}/aurora-flatpak-gl.XXXXXX") || return 1
    if cp -a "$x86_trees/$branch/." "$work/" && cp -a "$fex" "$work/files/fex" &&
       flatpak build-export --runtime --files=files --arch=x86_64 \
         --subject="Aurora Mesa $(cat "$work/files/.aurora-mesa-commit") and fex-emu's FEX for $branch" \
         "$x86_repo" "$work" "$branch"; then
      :
    else
      rc=1
    fi
    rm -rf "$work"
  done
  flatpak build-update-repo "$x86_repo" || rc=1
  add_remote "$x86_remote" "file://$x86_repo" "Aurora Mesa x86_64 (local)" "$remotes" || return 1
  for branch in $branches; do
    install_ref "$x86_remote" "runtime/$id/x86_64/$branch" || rc=1
  done
  return $rc
}

enable() {
  [ -d "$repo/objects" ] || { echo "aurora-flatpak-gl: no repository at $repo" >&2; return 1; }
  local remotes
  remotes=$(remote_names) || return 1
  add_remote "$remote" "file://$repo" "Aurora Mesa (local)" "$remotes" || return 1
  local rc=0 ref
  for ref in $(repo_refs); do
    install_ref "$remote" "$ref" || rc=1
  done
  enable_x86 "$remotes" || rc=1
  # Replace values earlier releases wrote; the current ones are set below.
  remove_overrides "${legacy[@]}" || rc=1
  local line key
  for line in "$env_vk" "$env_egl" "$env_dri" "$env_thunks"; do
    key=${line%%=*}
    # An administrator's explicit loader choice wins over packaged policy.
    if [ -f "$overrides" ] && grep -q "^$key=" "$overrides"; then
      continue
    fi
    flatpak override --system --env="$line" || rc=1
  done
  return $rc
}

# Remove exactly the given lines from the overrides file.
remove_overrides() {
  [ -f "$overrides" ] || return 0
  local tmp output_fd filter_rc=0 content_rc pat pats=()
  for pat in "$@"; do pats+=(-e "$pat"); done
  # Work beside the target so replacement is a rename, never a partial copy.
  # mktemp owns a unique file; an unrelated overrides.tmp must stay untouched.
  tmp=$(mktemp -- "$overrides.XXXXXX") || {
    echo "aurora-flatpak-gl: cannot create override cleanup file for $overrides" >&2
    return 1
  }
  # Check the redirection separately: a shell open failure can also return 1,
  # whereas grep returning 1 means the filter validly selected no lines.
  if exec {output_fd}>"$tmp"; then
    grep -vxF "${pats[@]}" "$overrides" >&"$output_fd" || filter_rc=$?
    exec {output_fd}>&- || filter_rc=2
  else
    filter_rc=2
  fi
  if [ "$filter_rc" -gt 1 ]; then
    echo "aurora-flatpak-gl: cannot filter overrides in $overrides" >&2
  else
    # grep's no-selected-lines status is valid, including an empty result.
    grep -qvE '^(\[.*\]|[[:space:]]*)$' "$tmp"
    content_rc=$?
    case $content_rc in
      0)
        # Apply metadata only after writing, keeping restrictive modes and ACLs.
        if ! cp --attributes-only --preserve=mode,ownership,timestamps -- "$overrides" "$tmp"; then
          echo "aurora-flatpak-gl: cannot preserve override metadata for $overrides" >&2
        elif ! mv -fT -- "$tmp" "$overrides"; then
          echo "aurora-flatpak-gl: cannot replace overrides in $overrides" >&2
        else
          return 0
        fi
        ;;
      1)
        # Remove only after inspection succeeds, without first rewriting the
        # original: a failed final removal leaves all its content retryable.
        if ! rm -f -- "$tmp"; then
          echo "aurora-flatpak-gl: cannot remove override cleanup file $tmp" >&2
          return 1
        fi
        rm -f -- "$overrides" || {
          echo "aurora-flatpak-gl: cannot remove empty overrides in $overrides" >&2
          return 1
        }
        return 0
        ;;
      *) echo "aurora-flatpak-gl: cannot inspect override cleanup file $tmp" >&2 ;;
    esac
  fi
  # Every failed preparation leaves the original intact. Clean only our temp.
  rm -f -- "$tmp" || echo "aurora-flatpak-gl: cannot remove override cleanup file $tmp" >&2
  return 1
}

disable() {
  local refs remotes ref name rc=0
  # Query both before changing anything: failure is not an empty installation.
  refs=$(installed_refs) || return 1
  remotes=$(remote_names) || return 1
  remove_overrides "$env_vk" "$env_egl" "$env_dri" "$env_thunks" "${legacy[@]}" || return 1
  for ref in $refs; do
    # A ref that was never pinned has no pattern to remove; that is fine.
    flatpak pin --system --remove "$ref" >/dev/null 2>&1 || true
    flatpak uninstall --system --noninteractive -y "$ref" || rc=1
  done
  for name in "$remote" "$x86_remote"; do
    if grep -qxF "$name" <<< "$remotes"; then
      flatpak remote-delete --system --force "$name" || rc=1
    fi
  done
  rm -rf "$x86_repo" || rc=1
  return $rc
}

status() {
  local refs
  refs=$(installed_refs) || return 1
  echo "repository branches:"; repo_refs | sed 's/^/  /'
  echo "x86_64 trees:"; x86_branches | sed 's/^/  /'
  echo "FEX bundle: $( [ -x "$fex/FEX" ] && [ -f "$fex/GuestThunks/libVDSO-guest.so" ] && echo "$fex" || echo none)"
  echo "installed:"; printf '%s\n' "$refs" | sed 's/^/  /'
  echo "system override ($overrides):"; [ -f "$overrides" ] && sed 's/^/  /' "$overrides"
  echo "FLATPAK_GL_DRIVERS=${FLATPAK_GL_DRIVERS-}"
}

case ${1-} in
  enable) enable ;;
  disable) disable ;;
  status) status ;;
  *) echo "usage: $0 enable|disable|status" >&2; exit 2 ;;
esac
