pkgname=aurora-flatpak-gl
epoch=1
pkgver=26.3.0_devel.202611260351.36623c0a4a5
pkgrel=2
pkgdesc='Aurora Mesa Flatpak GL extension for Freedesktop 25.08 and 26.08 (aarch64, and x86_64 apps under FEX)'
arch=('aarch64')
url='https://github.com/aurora-silicon/alarm-aurora'
license=('MIT')
depends=('flatpak')
makedepends=('flatpak-builder' 'dbus' 'python')
options=('!strip' '!debug')
install=aurora-flatpak-gl.install
backup=('etc/profile.d/aurora-flatpak-gl.sh')
_commit=36623c0a4a5a3e2a94fedd5f0874258d8126648d
_sha256=7906acc54411e0c61b6c4a5539d555cc0831b95603c80d37311a2bcd49313336
source=(aurora-flatpak-gl 60-aurora-flatpak-gl.conf aurora-flatpak-gl.sh
        build-extension.sh org.freedesktop.Platform.GL.aurora.yml.in validate-repo.sh validate-repository.py LICENSE
        70-aurora-flatpak-gl-x86_64.hook aurora-flatpak-x86-exports aurora-flatpak-x86-exports.path
        aurora-flatpak-x86-exports.service 61-aurora-flatpak-x86-exports zz-aurora-flatpak-x86-exports.sh)
