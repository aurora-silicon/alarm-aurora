build() {
  export AURORA_MESA_COMMIT=$_commit AURORA_MESA_SHA256=$_sha256
  # Build in makepkg's isolated home. Never use a host Flatpak installation.
  export XDG_DATA_HOME="$srcdir/flatpak-data" XDG_CACHE_HOME="$srcdir/flatpak-cache"
  export XDG_RUNTIME_DIR="$srcdir/flatpak-runtime"
  install -d -m700 "$XDG_RUNTIME_DIR"
  dbus-run-session -- bash -euo pipefail -c '
    flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
    for branch in 25.08 26.08; do
      flatpak install --user --noninteractive --no-related -y flathub \
        "org.freedesktop.Platform/aarch64/$branch" \
        "org.freedesktop.Sdk/aarch64/$branch" \
        "org.freedesktop.Sdk.Extension.llvm22/aarch64/$branch"
      bash ./build-extension.sh "$branch" "$PWD/repo" "$PWD/work-$branch"
    done
  '
}

check() {
  bash validate-repo.sh "$srcdir/repo" "$_commit"
}

package() {
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  depends+=("mesa-aurora=$epoch:$pkgver-$pkgrel" "vulkan-aurora=$epoch:$pkgver-$pkgrel")
  # Refuse a stale cache even when makepkg is run with --nocheck.
  bash validate-repo.sh "$srcdir/repo" "$_commit"
  install -Dm755 aurora-flatpak-gl "$pkgdir/usr/lib/aurora-flatpak-gl/aurora-flatpak-gl"
  install -Dm644 60-aurora-flatpak-gl.conf "$pkgdir/usr/lib/environment.d/60-aurora-flatpak-gl.conf"
  install -Dm644 aurora-flatpak-gl.sh "$pkgdir/etc/profile.d/aurora-flatpak-gl.sh"
  install -d "$pkgdir/usr/share/aurora-flatpak-gl"
  cp -a "$srcdir/repo" "$pkgdir/usr/share/aurora-flatpak-gl/repo"
  # enable also exports and installs the x86_64 extension, so x86_64 apps
  # find the files the override lists for their architecture; the hook does
  # it again when the trees or the FEX bundle change.
  depends+=("aurora-flatpak-gl-x86_64=$epoch:$pkgver-$pkgrel" 'aurora-userpages')
  install -Dm644 70-aurora-flatpak-gl-x86_64.hook "$pkgdir/usr/share/libalpm/hooks/70-aurora-flatpak-gl-x86_64.hook"
  # Stopgap until FEX starts itself in a 4 KiB page tree: x86_64 app entries
  # start their app through userpages 4k. Wanted by paths.target from the
  # package, so upgrades get it too.
  install -Dm755 aurora-flatpak-x86-exports "$pkgdir/usr/lib/aurora-flatpak-gl/aurora-flatpak-x86-exports"
  install -Dm644 aurora-flatpak-x86-exports.path "$pkgdir/usr/lib/systemd/system/aurora-flatpak-x86-exports.path"
  install -Dm644 aurora-flatpak-x86-exports.service "$pkgdir/usr/lib/systemd/system/aurora-flatpak-x86-exports.service"
  install -d "$pkgdir/usr/lib/systemd/system/paths.target.wants"
  ln -s ../aurora-flatpak-x86-exports.path "$pkgdir/usr/lib/systemd/system/paths.target.wants/aurora-flatpak-x86-exports.path"
  install -Dm755 61-aurora-flatpak-x86-exports "$pkgdir/usr/lib/systemd/user-environment-generators/61-aurora-flatpak-x86-exports"
  install -Dm644 zz-aurora-flatpak-x86-exports.sh "$pkgdir/etc/profile.d/zz-aurora-flatpak-x86-exports.sh"
}
