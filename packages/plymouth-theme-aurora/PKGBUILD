pkgname=plymouth-theme-aurora
pkgver=1
pkgrel=4
pkgdesc='Aurora boot splash: the bootloader logo, kept in place, with the distribution branding'
arch=('any')
url='https://github.com/aurora-silicon/alarm-aurora'
license=('MIT')
depends=('plymouth' 'plymouth-script-keyboard-lifetime>=1' 'cantarell-fonts' 'coreutils')
makedepends=('python')
install=plymouth-theme-aurora.install
source=(aurora.plymouth aurora.script aurora-logo-128.png aurora-logo-256.png LICENSE aurora-plymouth aurora-plymouth.conf initcpio-install initcpio-hook mkinitcpio.conf test_geometry.py)
sha256sums=('cd63992c49351e91b71aee8d49202b1b127be05cfc34f017476969c81b92550d'
            'f5a7f29f1c529e6cc6ca6b06996019abb4d7635875a67179dd278c66cf7696df'
            '11fbf034968b516aa410aa30d66f06dcf4998b39b1ec192ec1b25ea762fb1b1d'
            'fa5d7331716eca34b7f6e4613f6a2b42a18134fdd65eb6c8dcf21fd6bed6f630'
            'd74b21234e71d54dec84a84c255644ec63a209f564296d5903b1607779697175'
            '19517b71055f61c6a6e1f1951fb6f01d9f8153f7d22095ff69bb392feec74d01'
