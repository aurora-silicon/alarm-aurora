# SPDX-License-Identifier: MIT
pkgname=plymouth-theme-aurora
pkgver=1
pkgrel=2
pkgdesc='Aurora boot splash: the bootloader logo, kept in place, with the distribution branding'
arch=('any')
url='https://github.com/aurora-silicon/alarm-aurora'
license=('MIT')
depends=('plymouth' 'cantarell-fonts')
install=plymouth-theme-aurora.install
source=(aurora.plymouth aurora.script aurora-logo-128.png aurora-logo-256.png LICENSE)
sha256sums=('7924104877a470d065c9b2feaf19ba08aeef5b4d5e9964ad8d5f5d594f8ad8c1'
            '45b152a389005c3ad03197379d32233da6d30f150b361568f83aa557148a342b'
            '11fbf034968b516aa410aa30d66f06dcf4998b39b1ec192ec1b25ea762fb1b1d'
            'fa5d7331716eca34b7f6e4613f6a2b42a18134fdd65eb6c8dcf21fd6bed6f630'
            'd74b21234e71d54dec84a84c255644ec63a209f564296d5903b1607779697175')

package() {
  local d="$pkgdir/usr/share/plymouth/themes/aurora"
  install -Dm644 aurora.plymouth "$d/aurora.plymouth"
  install -Dm644 aurora.script "$d/aurora.script"
  # Byte-identical to aura's data/aurora_128.png and aurora_256.png. The spinner,
  # password entry and watermark come from the plymouth package's spinner theme,
  # the theme's ImageDir, which the plymouth initcpio hook copies with it.
  install -Dm644 aurora-logo-128.png "$d/aurora-logo-128.png"
  install -Dm644 aurora-logo-256.png "$d/aurora-logo-256.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
