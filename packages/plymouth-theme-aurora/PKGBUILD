check() {
  python3 test_geometry.py .
}

package() {
  local d="$pkgdir/usr/share/plymouth/themes/aurora"
  install -Dm644 aurora.plymouth "$d/aurora.plymouth"
  install -Dm644 aurora.script "$d/aurora.script"
  # Byte-identical to aura's data/aurora_128.png and aurora_256.png. The spinner,
  # password entry and watermark come from the plymouth package's spinner theme,
  # the theme's ImageDir, which the plymouth initcpio hook copies with it.
  install -Dm644 aurora-logo-128.png "$d/aurora-logo-128.png"
  install -Dm644 aurora-logo-256.png "$d/aurora-logo-256.png"
  install -Dm755 aurora-plymouth "$pkgdir/usr/libexec/aurora-plymouth"
  install -Dm644 aurora-plymouth.conf "$pkgdir/usr/lib/systemd/system/plymouth-start.service.d/aurora-plymouth.conf"
  install -Dm755 initcpio-install "$pkgdir/usr/lib/initcpio/install/aurora-plymouth"
  install -Dm755 initcpio-hook "$pkgdir/usr/lib/initcpio/hooks/aurora-plymouth"
  install -Dm644 mkinitcpio.conf "$pkgdir/etc/mkinitcpio.conf.d/96-aurora-plymouth.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
