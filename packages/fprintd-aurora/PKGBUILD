pkgname=fprintd-aurora
pkgver=1.94.5
pkgrel=5
pkgdesc='D-Bus fingerprint service with Aurora enrolment and durable-delete handling'
arch=('aarch64')
license=('GPL-2.0-or-later' 'GFDL-1.1-or-later')
url='https://github.com/aurora-silicon/aurora-sep-userspace'
provides=("fprintd=$pkgver")
conflicts=('fprintd')
replaces=('fprintd')
depends=('libfprint' 'dbus' 'glib2' 'polkit' 'systemd-libs' 'pam')
makedepends=('meson' 'ninja' 'gettext' 'gtk-doc' 'glib2-devel' 'systemd' 'python' 'perl')
checkdepends=('python-dbus' 'python-gobject')
source=('https://gitlab.freedesktop.org/libfprint/fprintd/-/archive/v1.94.5/fprintd-v1.94.5.tar.gz'
        '0001-preserve-print-on-device-delete-failure.patch' 'test_account_gate.py'
        '0002-report-lockout-and-fall-back-to-the-password.patch'
        '0003-say-why-the-reader-needs-the-password.patch'
        '0004-dont-ask-for-a-finger-the-reader-will-not-take.patch'
        '0005-opt-in-polkit-fingerprint-cancellation.patch' 'test_password_switch.py' 'pam-test.c' 'mock-fprintd.py')
sha256sums=('a026ef34c31b25975275cc29a5e4eba2b54524769672095a5228098a08acd82c'
            'ea41766b42cfd259e32ce37cf84c5557b2f31eb9db4b63160c54ddb5c6a11e7a'
            '9d09fd49cb988b4b70784151d9d6757a40fa60b19c85048067598decd480bb83'
            'b29df6766dafadbdc2dac34b5fc0396ac24a7628e822018285189cf30f52c34e'
            '1db338603ce2bbf15688c909d4c24120c7933755ca390358b940ac4579cb82d3'
            'ca498a36e63e39450e8bd7bb090134093942e4ffc7919bd8748a579e1669db1a'
            '1ab4c5de74555b51c1995f66190db86bf955616506179a77e4855c458a37e492'
            '5d4639fec7bb498f508d51aa49ff26d511b3ac0460db4b34fb791a41e6789670'
            '43cc8710668fcd3aac406e3068ca608e4a3b4f2a4e0f6d67a70ea0eab79c073c'
            'a1a57e28ea75530bc9e107a57f164a0f538ceee80d81f70a446d87a1c0e9caf7')

prepare() {
  cd "fprintd-v$pkgver"
  patch -Np1 -i "$srcdir/0001-preserve-print-on-device-delete-failure.patch"
  patch -Np1 -i "$srcdir/0002-report-lockout-and-fall-back-to-the-password.patch"
  patch -Np1 -i "$srcdir/0003-say-why-the-reader-needs-the-password.patch"
  patch -Np1 -i "$srcdir/0004-dont-ask-for-a-finger-the-reader-will-not-take.patch"
  patch -Np1 -i "$srcdir/0005-opt-in-polkit-fingerprint-cancellation.patch"
}

build() {
  # 0002 matches libfprint-aurora's FP_DEVICE_ERROR_LOCKED_OUT (0008, pkgrel 6),
  # the value after FP_DEVICE_ERROR_TOO_HOT. Each package builds in its own clean
  # ALARM root with stock libfprint headers, which lack it; package() requires
  # libfprint-aurora>=1.94.100-8, so the daemon always runs on the library
  # that reports it.
  if ! grep -q FP_DEVICE_ERROR_LOCKED_OUT /usr/include/libfprint-2/fp-device.h; then
    export CFLAGS="$CFLAGS -DFP_DEVICE_ERROR_LOCKED_OUT=(FP_DEVICE_ERROR_TOO_HOT+1)"
  fi
  # 0003 likewise matches 0009 (pkgrel 7): the two password reasons follow it.
  if ! grep -q FP_DEVICE_ERROR_PASSWORD_REQUIRED_AFTER_BOOT /usr/include/libfprint-2/fp-device.h; then
    export CFLAGS="$CFLAGS -DFP_DEVICE_ERROR_PASSWORD_REQUIRED=(FP_DEVICE_ERROR_TOO_HOT+2)"
    export CFLAGS="$CFLAGS -DFP_DEVICE_ERROR_PASSWORD_REQUIRED_AFTER_BOOT=(FP_DEVICE_ERROR_TOO_HOT+3)"
  fi
  # 0004 looks fp_device_get_password_required() (0010, pkgrel 8) up at run
  # time, so it needs no stock-header fallback.
  arch-meson "fprintd-v$pkgver" build -Dgtk_doc=true -Dpam=true -Dpam_modules_dir=/usr/lib/security
  meson compile -C build
}

check() {
  python "$srcdir/test_account_gate.py" "$srcdir/fprintd-v$pkgver/src/device.c"
  local test_dir="$srcdir/password-switch-tests"
  mkdir -p "$test_dir"
  cp "$srcdir/test_password_switch.py" "$srcdir/mock-fprintd.py" "$test_dir/"
  ln -sf "$srcdir/build/pam/pam_fprintd.so" "$test_dir/pam_fprintd-switch.so"
  cc -DMOCK_PASSWORD -fPIC -shared -o "$test_dir/pam_mock_password.so" "$srcdir/pam-test.c" -lpam
  cc -o "$test_dir/pam-test" "$srcdir/pam-test.c" -lpam
  python "$test_dir/test_password_switch.py"
  grep -q 'verify-lockout' "$srcdir/fprintd-v$pkgver/src/device.c"
  grep -q 'verify-lockout' "$srcdir/fprintd-v$pkgver/pam/pam_fprintd.c"
  grep -q 'verify-password-required-after-boot' "$srcdir/fprintd-v$pkgver/src/device.c"
  grep -q 'Your password is required to enable Touch ID.' "$srcdir/fprintd-v$pkgver/pam/pam_fprintd.c"
  grep -q 'fp_device_get_password_required' "$srcdir/fprintd-v$pkgver/src/device.c"
}

package() {
  depends=('libfprint-aurora>=1.94.100-8' 'dbus' 'glib2' 'polkit' 'systemd-libs' 'pam')
  meson install -C build --destdir "$pkgdir"
}
