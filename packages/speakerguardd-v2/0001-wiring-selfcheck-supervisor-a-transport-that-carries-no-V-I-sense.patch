From fb71278f9b0fb8122726687b07063e686efc6daf Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Thu, 19 Nov 2026 10:22:03 -0500
Subject: [PATCH] wiring, selfcheck, supervisor: a transport that carries no
 V/I sense

The T6041/T8132 AOP speaker service carries the amps' V/I sense as its
own "sense" DMA channel. A Mac whose AOP takes playback only (the M4
Mac mini, J773g: one SN012776, and its speaker node has a TX channel
and no sense) names no such channel, and opening the speaker card's
sense PCM fails. The derivation still gave its SN012776 a V/I pair from
the amp's slot properties, so the self-check refused the Mac ("no
'Speaker VSENSE Switch' control", then no speaker format: the sense
capture never opened).

Record each speaker back-end's dma-names and give the aop-spkr transport
a "sense_dma" name. Where the back-ends name their channels without it,
the amps' sense is not read: the wiring has no sense map and says
"no_sense_path". Such a Mac is proven like a family without sense (the
speaker PCM only) and its record says method=derived-nosense, which the
supervisor takes for a sense family only with no sense channels; a sense
family recorded derived-static is still refused. A tuning whose unit
reads sense (spp3) on such a transport is refused.

A back-end without dma-names, and every other transport, keeps today's
behaviour.

Signed-off-by: Diljit Singh <hey@djdev.me>
---
 crates/sgv2-supervisor/src/selfcheck.rs   | 21 ++++++++--
 packaging/session/speakerguardd-selfcheck |  8 ++--
 packaging/session/wiring.py               | 47 ++++++++++++++++++++---
 3 files changed, 64 insertions(+), 12 deletions(-)

diff --git a/crates/sgv2-supervisor/src/selfcheck.rs b/crates/sgv2-supervisor/src/selfcheck.rs
index ab4c07f..3507967 100644
--- a/crates/sgv2-supervisor/src/selfcheck.rs
+++ b/crates/sgv2-supervisor/src/selfcheck.rs
@@ -114,8 +114,11 @@ pub fn covers(bind: &Bind, board: &str, kernel: &str, params_sha256: &str) -> Re
 /// count and the amp family the self-check derived from this Mac's device
 /// tree and proved on its card. There is no table of boards: a new Mac
 /// runs on its own record. A family with V/I sense must have been proven
-/// with it (`method=derived`, two sense channels an amp); one without has
-/// nothing to prove silently (`method=derived-static`, no sense).
+/// with it (`method=derived`, two sense channels an amp), unless the
+/// self-check found that this Mac's speaker transport carries no sense
+/// (`method=derived-nosense`, no sense: the J773g's AOP, whose device tree
+/// names no sense DMA). One without has nothing to prove silently
+/// (`method=derived-static`, no sense).
 pub fn machine_for(board: &str, bind: &Bind) -> Result<&'static Machine, String> {
     if bind.board != board {
         return Err(format!("the self-check ran on {}, this Mac is {board}", bind.board));
@@ -126,7 +129,11 @@ pub fn machine_for(board: &str, bind: &Bind) -> Result<&'static Machine, String>
     if bind.amps == 0 {
         return Err(format!("{board}: the self-check found no amps"));
     }
-    let (method, sense) = if amp.has_sense() { ("derived", 2 * bind.amps) } else { ("derived-static", 0) };
+    let (method, sense) = match (amp.has_sense(), bind.method.as_str()) {
+        (true, "derived-nosense") => ("derived-nosense", 0),
+        (true, _) => ("derived", 2 * bind.amps),
+        (false, _) => ("derived-static", 0),
+    };
     if bind.method != method {
         return Err(format!("{board}: {} amps need a {method} wiring, the record says {}", bind.family, bind.method));
     }
@@ -209,6 +216,12 @@ mod tests {
             Bind { amps: 2, sense: 0, family: "max98360a".into(), method: "derived-static".into(), ..new.clone() };
         assert_eq!(machine_for("j999", &pair).unwrap().amp, Amp::Max98360a);
         assert!(machine_for("j999", &Bind { sense: 4, ..pair.clone() }).is_err());
-        assert!(machine_for("j999", &Bind { method: "derived".into(), ..pair }).is_err());
+        assert!(machine_for("j999", &Bind { method: "derived".into(), ..pair.clone() }).is_err());
+        assert!(machine_for("j999", &Bind { method: "derived-nosense".into(), ..pair }).is_err());
+        // a sense family on a transport without sense (the J773g): no sense
+        let mono = Bind { amps: 1, sense: 0, method: "derived-nosense".into(), ..new.clone() };
+        assert_eq!(machine_for("j999", &mono).unwrap().amp, Amp::Sn012776);
+        assert!(machine_for("j999", &Bind { sense: 2, ..mono.clone() }).is_err());
+        assert!(machine_for("j999", &Bind { method: "derived-static".into(), ..mono }).is_err());
     }
 }
diff --git a/packaging/session/speakerguardd-selfcheck b/packaging/session/speakerguardd-selfcheck
index dc7d1a0..30e2c55 100755
--- a/packaging/session/speakerguardd-selfcheck
+++ b/packaging/session/speakerguardd-selfcheck
@@ -906,7 +906,7 @@ def derive_live(args):
     dump = wiring.tuning_dump(args.tuning, args.tuning_cli, strict=True)
     units = wiring.roles(dump)["channels"]
     w = wiring.derive(hw, dump)
-    w["method"] = "derived" if w["sense"] else "derived-static"
+    w["method"] = "derived" if w["sense"] else "derived-nosense" if w.get("no_sense_path") else "derived-static"
     desc = wiring.describe(hw, w)
     return hw, w, desc, wiring.role_errors(w, units)
 
@@ -1001,7 +1001,7 @@ def run_locked(args):
                 return 0
             # The cheap checks failed already: the record fails now, before
             # login, without the switch test.
-        elif w["method"] == "derived-static":
+        elif w["method"] in ("derived-static", "derived-nosense"):
             errs += static(idx, w, report)
         elif w["method"] == "derived":
             try:
@@ -1044,7 +1044,9 @@ def static(idx, w, report):
     """A board without V/I sense (the J700's MAX98360As): no register and
     no sense to read, so nothing about its channel order is observable
     with zero samples. The map is the device tree's and the tuning's, and
-    the record says "derived-static". Only the PCM is checked."""
+    the record says "derived-static". A family with sense on a transport
+    that carries none (the J773g's AOP) has none to read either: the
+    record says "derived-nosense". Only the PCM is checked."""
     ids = pcm_ids(idx)
     if ids.get(("Secondary", "p")) != 1:
         raise wiring.Refused(f"the speaker PCM is {ids.get(('Secondary', 'p'))}; the graph expects 1")
diff --git a/packaging/session/wiring.py b/packaging/session/wiring.py
index 07009e1..883e8ee 100644
--- a/packaging/session/wiring.py
+++ b/packaging/session/wiring.py
@@ -119,8 +119,11 @@ TRANSPORTS = {
     # sound/soc/apple/aop_spkr.rs (T6040 speaker service): S24_LE playback, S16_LE sense.
     # Its PCMs have one width on every Mac, whatever the number of amps: six
     # playback channels and twelve sense channels (see PCM widths below).
+    # Its sense is the back-end's "sense" DMA channel: a Mac whose AOP
+    # carries no V/I sense (the J773g's ADT audio-speaker has a TX channel
+    # only) names none, and its amps' sense is not read (transport_senses).
     "apple,t6041-aop-audio": {"transport": "aop-spkr", "formats": ["S24_LE"], "sense_batch": False, "speaker_headroom": 256,
-                              "speaker_irq": True, "speaker_channels": 6, "sense_channels": 12},
+                              "speaker_irq": True, "speaker_channels": 6, "sense_channels": 12, "sense_dma": "sense"},
     # sound/soc/apple/aop_t8140.rs: S32_LE playback, no sense
     "apple,t8140-aop-audio": {"transport": "aop-t8140", "formats": ["S32_LE"], "sense_batch": True, "speaker_headroom": 0,
                               "speaker_irq": True},
@@ -273,12 +276,15 @@ def _links(snd, root, phandles, sysfs):
             if i2c:
                 c["i2c"] = i2c
             codecs.append(c)
-        cpu_compat = []
+        cpu_compat, cpu_dmas = [], []
         for node in cpu:
             f = os.path.join(node, "compatible")
             cpu_compat.append(_strs(_read(f)) if os.path.exists(f) else [])
+            f = os.path.join(node, "dma-names")
+            cpu_dmas.append(_strs(_read(f)) if os.path.exists(f) else None)
         links.append(
-            {"name": _str(_read(os.path.join(p, "link-name"))), "cpus": len(cpu), "cpu_compatible": cpu_compat, "codecs": codecs}
+            {"name": _str(_read(os.path.join(p, "link-name"))), "cpus": len(cpu), "cpu_compatible": cpu_compat,
+             "cpu_dma_names": cpu_dmas, "codecs": codecs}
         )
     return links
 
@@ -509,6 +515,24 @@ def tdm_slots(n_codecs, n_bes):
     return slots
 
 
+def transport_senses(hw):
+    """Whether the speaker link's transport carries the amps' V/I sense on
+    this Mac. A transport whose sense is a named DMA channel ("sense_dma")
+    carries none when its back-end nodes name their channels without it.
+    A back-end with no dma-names, or a device-tree read from before they
+    were recorded, keeps the sense the amps' family offers. (transport()
+    refuses unknown or mixed back-ends; this only reads the ones it knows.)"""
+    link = _speaker_link(hw)
+    dmas = link.get("cpu_dma_names")
+    if not dmas or any(d is None for d in dmas):
+        return True
+    for compat, names in zip(link.get("cpu_compatible") or [], dmas):
+        t = next((TRANSPORTS[c] for c in compat if c in TRANSPORTS), None)
+        if t and t.get("sense_dma") and t["sense_dma"] not in names:
+            return False
+    return True
+
+
 def hardware(hw):
     """The speaker amps in physical (speaker PCM) order, each with its
     side, role, ordinal, slot and sense channels."""
@@ -517,6 +541,10 @@ def hardware(hw):
     if not codecs:
         raise Refused("the speaker dai-link lists no amps")
     slots = tdm_slots(len(codecs), link["cpus"])
+    # An amp family's V/I sense counts only where the transport carries it:
+    # without, the amps are wired without it, and the record says why
+    # ("no_sense_path", method "derived-nosense").
+    sensed = transport_senses(hw)
     amps, families = [], set()
     # A lone amp with no sound-name-prefix is the one full-range speaker of
     # a desktop Mac (J274, J375, J473, J474, J475: macaudio's mono speaker
@@ -535,7 +563,9 @@ def hardware(hw):
         a = {"prefix": c["prefix"], "family": fam[0], "slot": slot, "side": side, "role": role, "ordinal": ordinal}
         if c.get("i2c"):
             a["i2c"] = c["i2c"]
-        if fam[1]:
+        if fam[1] and not sensed:
+            a["no_sense_path"] = True
+        elif fam[1]:
             for k in ("vmon", "imon"):
                 if k not in c:
                     raise Refused(f"amp {c['prefix']} has V/I sense but no ti,{k}-slot-no")
@@ -567,7 +597,7 @@ def hardware(hw):
     keys = [(a["side"], a["role"], a["ordinal"]) for a in amps]
     if len(set(keys)) != len(keys):
         raise Refused(f"two amps share a side, role and ordinal: {[a['prefix'] for a in amps]}")
-    if next(iter(families))[1]:
+    if next(iter(families))[1] and sensed:
         chans = sorted(ch for a in amps for ch in (a["v_ch"], a["i_ch"]))
         if chans != list(range(2 * len(amps))):
             raise Refused(f"the sense slots give channels {chans}, not 0..{2 * len(amps) - 1} once each")
@@ -799,6 +829,9 @@ def derive(hw, dump, key=None):
     the sense map."""
     amps = hardware(hw)
     rl = roles(dump)
+    no_sense_path = any(a.get("no_sense_path") for a in amps)
+    if no_sense_path and rl["kind"] in SENSE_UNITS:
+        raise Refused(f"the tuning's {rl['kind']} protection reads V/I sense, and this Mac's speaker transport carries none")
     units = rl["channels"]
     if len(units) != len(amps):
         raise Refused(f"the tuning's unit has {len(units)} channels, the board {len(amps)} amps")
@@ -838,6 +871,10 @@ def derive(hw, dump, key=None):
         "unit_channels": [a["unit"] for a in amps],
         "sense": sense,
         "sense_ports": [s["port"] for s in sense],
+        # A sense-capable amp family on a transport that carries no sense
+        # (transport_senses): proven like a family without sense, and the
+        # record says why (method "derived-nosense").
+        "no_sense_path": no_sense_path,
     }
     if rl.get("sense_companion"):
         if len(sense) != 2 * len(amps):
