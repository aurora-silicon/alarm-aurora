pkgname=alsa-ucm-conf-aurora
pkgver=10.aurora2
pkgrel=2
pkgdesc='Aurora Apple Silicon ALSA profiles including J700'
arch=('any')
groups=('aurora-platform-apple-silicon')
url='https://github.com/aurora-silicon/alsa-ucm-conf-asahi'
license=('BSD-3-Clause')
_commit=777d7048c444bf20b11830380cfd846cd2744ee0
makedepends=('git')
depends=('alsa-ucm-conf')
provides=("alsa-ucm-conf-asahi=$pkgver" "alsa-ucm-conf-asahi-aurora=$pkgver")
conflicts=('alsa-ucm-conf-asahi' 'alsa-ucm-conf-asahi-aurora')
replaces=('alsa-ucm-conf-asahi-aurora')
source=("ucm::git+$url.git#commit=$_commit")
sha256sums=('SKIP')
package() {
  install -d "$pkgdir/usr/share/alsa"
  cp -a ucm/ucm2 "$pkgdir/usr/share/alsa/"
  install -Dm644 ucm/LICENSE.asahi "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
