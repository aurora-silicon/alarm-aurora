# Aurora Mesa as the x86_64 Flatpak GL driver extension, for x86_64 apps that
# run under FEX on Apple silicon.
#
# Same Mesa commit as packages/mesa-aurora, built against the x86_64
# Freedesktop runtime @BRANCH@ on an x86_64 builder. The drivers are built
# without LLVM (asahi and zink GL, asahi Vulkan); GL.default stays the
# software fallback. The CL compilers that precompile the asahi kernels still
# need LLVM, LLVMSPIRVLib and libclc: they are built here for the build only,
# from the same Mesa tree, and cleaned out with everything else the extension
# does not need.
id: org.freedesktop.Platform.GL.aurora
branch: '@BRANCH@'
runtime: org.freedesktop.Platform
runtime-version: '@BRANCH@'
sdk: org.freedesktop.Sdk
sdk-extensions:
  - org.freedesktop.Sdk.Extension.llvm22
build-extension: true
separate-locales: false
appstream-compose: false
build-options:
  prefix: /usr/lib/x86_64-linux-gnu/GL/aurora
  libdir: /usr/lib/x86_64-linux-gnu/GL/aurora/lib
  prepend-path: /usr/lib/x86_64-linux-gnu/GL/aurora/bin:/usr/lib/sdk/llvm22/bin
  prepend-ld-library-path: /usr/lib/x86_64-linux-gnu/GL/aurora/lib:/usr/lib/sdk/llvm22/lib
  prepend-pkg-config-path: /usr/lib/x86_64-linux-gnu/GL/aurora/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/GL/aurora/share/pkgconfig
  # Built without -g; Mesa is stripped in the sandbox (post-install below),
  # as for the aarch64 extension.
  cflags: -O2 -pipe
  cflags-override: true
  cxxflags: -O2 -pipe
  cxxflags-override: true
  no-debuginfo: true
  strip: false
cleanup:
  - /bin
  - /include
  - /lib/cmake
  - /lib/pkgconfig
  - /share/pkgconfig
  - /share/clc
  - /share/build-python
  - /share/build-tools
  - /share/doc
  - /share/man
  - '*.a'
  - '*.la'
  - /lib/libSPIRV-Tools-shared.so
modules:
  - name: spirv-headers
    buildsystem: cmake-ninja
    builddir: true
    sources:
      - type: git
        url: https://github.com/KhronosGroup/SPIRV-Headers.git
        tag: vulkan-sdk-1.4.341.0
        commit: 04f10f650d514df88b76d25e83db360142c7b174

  - name: spirv-tools
    buildsystem: cmake-ninja
    builddir: true
    config-opts:
      - -DCMAKE_BUILD_TYPE=Release
      - -DSPIRV-Headers_SOURCE_DIR=/usr/lib/x86_64-linux-gnu/GL/aurora
      - -DSPIRV_SKIP_TESTS=ON
      - -DSPIRV_SKIP_EXECUTABLES=ON
      - -DSPIRV_WERROR=OFF
      - -DBUILD_SHARED_LIBS=OFF
      - -DCMAKE_POSITION_INDEPENDENT_CODE=ON
    sources:
      - type: git
        url: https://github.com/KhronosGroup/SPIRV-Tools.git
        tag: vulkan-sdk-1.4.341.0
        commit: fbe4f3ad913c44fe8700545f8ffe35d1382b7093

  - name: spirv-llvm-translator
    buildsystem: cmake-ninja
    builddir: true
    config-opts:
      - -DCMAKE_BUILD_TYPE=Release
      - -DLLVM_DIR=/usr/lib/sdk/llvm22/lib/cmake/llvm
      # The translator needs the newer headers named in its
      # spirv-headers-tag.conf.
      - -DLLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR=/run/build/spirv-llvm-translator/spirv-headers
      - -DLLVM_SPIRV_INCLUDE_TESTS=OFF
      - -DBUILD_SHARED_LIBS=OFF
      - -DCMAKE_POSITION_INDEPENDENT_CODE=ON
    sources:
      - type: git
        url: https://github.com/KhronosGroup/SPIRV-LLVM-Translator.git
        tag: v22.1.7
        commit: b4c9189bcba7ed9a1189d6a2c27edc3d9a3d5277
      - type: git
        url: https://github.com/KhronosGroup/SPIRV-Headers.git
        commit: 575b6512579ebde466ed3dfc04e413439d14d95d
        dest: spirv-headers

  - name: libclc
    buildsystem: cmake-ninja
    builddir: true
    subdir: libclc
    config-opts:
      - -DCMAKE_BUILD_TYPE=Release
      - -DLLVM_DIR=/usr/lib/sdk/llvm22/lib/cmake/llvm
      - -DLIBCLC_TARGETS_TO_BUILD=spirv-mesa3d-;spirv64-mesa3d-
      - -DLLVM_SPIRV=/usr/lib/x86_64-linux-gnu/GL/aurora/bin/llvm-spirv
    sources:
      - type: archive
        url: https://github.com/llvm/llvm-project/releases/download/llvmorg-22.1.8/llvm-project-22.1.8.src.tar.xz
        sha256: 922f1817a0df7b1489272d18134ee0087a8b068828f87ac63b9861b1a9965888

  # Mesa's code generators need PyYAML, which the SDK does not ship. The pure
  # Python package is enough; it is on PYTHONPATH for the Mesa build only.
  - name: pyyaml
    buildsystem: simple
    build-commands:
      - mkdir -p ${FLATPAK_DEST}/share/build-python
      - cp -r lib/yaml ${FLATPAK_DEST}/share/build-python/
    sources:
      - type: archive
        url: https://files.pythonhosted.org/packages/05/8e/961c0007c59b8dd7729d542c61a4d537767a59645b82a0b521206e1e25c2/pyyaml-6.0.3.tar.gz
        sha256: d76623373421df22fb4cf8817020cbb7ef15c725b9d5e45f17e189bfc384190f

  # mesa_clc, vtn_bindgen2 and asahi_clc for this builder, from the same
  # Mesa tree with LLVM. The drivers below use them through a native file and
  # link no LLVM themselves.
  - name: mesa-clc
    buildsystem: simple
    build-options:
      env:
        MESA_GIT_SHA1_OVERRIDE: '@COMMIT@'
        PYTHONPATH: /usr/lib/x86_64-linux-gnu/GL/aurora/share/build-python
    build-commands:
      - >-
        meson setup tools --prefix=${FLATPAK_DEST} --buildtype=release -Db_ndebug=true
        -Dplatforms=x11,wayland -Dgallium-drivers=asahi -Dvulkan-drivers=asahi
        -Dvulkan-layers= -Dgallium-va=disabled -Dgallium-rusticl=false -Dteflon=false
        -Dllvm=enabled -Dshared-llvm=enabled -Dspirv-tools=enabled -Dmicrosoft-clc=disabled
        -Dbuild-tests=false -Dvalgrind=disabled -Dlibunwind=disabled -Dlmsensors=disabled
        -Dc_link_args=-L/usr/lib/x86_64-linux-gnu/GL/aurora/lib
        -Dcpp_link_args=-L/usr/lib/x86_64-linux-gnu/GL/aurora/lib
      - ninja -C tools src/compiler/clc/mesa_clc src/compiler/spirv/vtn_bindgen2 src/asahi/clc/asahi_clc
      - install -Dm755 -t ${FLATPAK_DEST}/share/build-tools tools/src/compiler/clc/mesa_clc tools/src/compiler/spirv/vtn_bindgen2 tools/src/asahi/clc/asahi_clc
      - >-
        printf '%s\n' '[binaries]'
        "mesa_clc = '${FLATPAK_DEST}/share/build-tools/mesa_clc'"
        "vtn_bindgen2 = '${FLATPAK_DEST}/share/build-tools/vtn_bindgen2'"
        "asahi_clc = '${FLATPAK_DEST}/share/build-tools/asahi_clc'"
        > ${FLATPAK_DEST}/share/build-tools/clc.ini
    sources:
      - type: archive
        url: https://codeload.github.com/aurora-silicon/mesa/tar.gz/@COMMIT@
        dest-filename: mesa-@COMMIT@.tar.gz
        sha256: '@SHA256@'

  - name: mesa
    buildsystem: meson
    builddir: true
    build-options:
      env:
        MESA_GIT_SHA1_OVERRIDE: '@COMMIT@'
        PYTHONPATH: /usr/lib/x86_64-linux-gnu/GL/aurora/share/build-python
    config-opts:
      - --buildtype=release
      - -Db_ndebug=true
      - -Dplatforms=x11,wayland
      - -Dgallium-drivers=asahi,zink
      - -Dvulkan-drivers=asahi
      - -Dvulkan-layers=
      - -Dgallium-va=disabled
      - -Dgallium-rusticl=false
      - -Dteflon=false
      - -Dgles1=disabled
      - -Dgles2=enabled
      - -Dopengl=true
      - -Dgbm=enabled
      - -Dglx=dri
      - -Degl=enabled
      - -Dglvnd=enabled
      - -Dllvm=disabled
      - -Dspirv-tools=disabled
      - -Dmesa-clc=system
      - -Dprecomp-compiler=system
      - --native-file=/usr/lib/x86_64-linux-gnu/GL/aurora/share/build-tools/clc.ini
      - -Dmicrosoft-clc=disabled
      - -Dintel-rt=disabled
      - -Dvalgrind=disabled
      - -Dlibunwind=disabled
      - -Dlmsensors=disabled
      - -Dandroid-libbacktrace=disabled
      - -Dbuild-tests=false
    sources:
      - type: archive
        url: https://codeload.github.com/aurora-silicon/mesa/tar.gz/@COMMIT@
        dest-filename: mesa-@COMMIT@.tar.gz
        sha256: '@SHA256@'
    post-install:
      # The GL extension point merges vulkan/icd.d, glvnd/egl_vendor.d and
      # lib/dri from every enabled driver, highest priority first. Use the
      # same file names as GL.default so ours take those slots.
      - mkdir -p ${FLATPAK_DEST}/vulkan ${FLATPAK_DEST}/glvnd
      - mv ${FLATPAK_DEST}/share/vulkan/icd.d ${FLATPAK_DEST}/vulkan/icd.d
      - mv ${FLATPAK_DEST}/share/glvnd/egl_vendor.d ${FLATPAK_DEST}/glvnd/egl_vendor.d
      - sed -i "s|\"libEGL_mesa.so.0\"|\"${FLATPAK_DEST}/lib/libEGL_mesa.so.0\"|" ${FLATPAK_DEST}/glvnd/egl_vendor.d/50_mesa.json
      - find ${FLATPAK_DEST}/lib -name '*.so*' -type f -exec strip --strip-unneeded {} +
      - install -Dm644 ../docs/license.rst ${FLATPAK_DEST}/share/licenses/mesa/license.rst
