source=("fex-$_commit.tar.gz::https://codeload.github.com/aurora-silicon/fex/tar.gz/$_commit")
for _b in "${_bundled[@]}"; do
  read -r _n _r _c _p <<<"$_b"
  source+=("$_n-$_c.tar.gz::https://codeload.github.com/$_r/tar.gz/$_c")
done
source+=(README.aurora fex-guest-rootfs.mount 50-aurora-fex-rootfs.conf aurora-fex-provider-up 70-aurora-fex-provider.hook compatibilitytool.vdf
         Config.json 0001-FEXInterpreter-name-the-distribution-RootFS-package.patch
         0002-FEXServer-run-the-RootFS-image-FUSE-helper-with-native-pages.patch)
