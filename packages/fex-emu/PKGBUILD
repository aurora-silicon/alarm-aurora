noextract=()
for _b in "${_bundled[@]}"; do
  read -r _n _r _c _p <<<"$_b"
  noextract+=("$_n-$_c.tar.gz")
done

prepare() {
  cd "fex-$_commit"
  local _b _n _r _c _p
  for _b in "${_bundled[@]}"; do
    read -r _n _r _c _p <<<"$_b"
    mkdir -p "$_p"
    tar -xzf "$srcdir/$_n-$_c.tar.gz" --strip-components=1 -C "$_p"
  done
  # Names fex-emu-rootfs-arch when the RootFS is missing.
  patch -Np1 -i "$srcdir/0001-FEXInterpreter-name-the-distribution-RootFS-package.patch"
  # erofsfuse can't serve /dev/fuse from a 4 KiB page tree; FEXServer starts
  # it with native pages.
  patch -Np1 -i "$srcdir/0002-FEXServer-run-the-RootFS-image-FUSE-helper-with-native-pages.patch"
  # /run/fex-emu/Config.json overrides the global config: aurora-fex-rootfs
  # names the Aurora Mesa provider there while it is mounted.
  patch -Np1 -i "$srcdir/0003-Config-read-a-runtime-system-config-over-the-global-one.patch"
  # Isolate Flatpak sandboxes' default FEXServer socket and Server.lock per
  # instance while preserving per-UID isolation (including with --filesystem=home).
  patch -Np1 -i "$srcdir/0004-FEXServerClient-isolate-flatpak-sandbox-socket.patch"
}

build() {
  # FEX tunes for the build machine by default (-mcpu from its /proc/cpuinfo),
  # which crashes with SIGILL on Apple CPUs when CI builds on Neoverse.
  cmake -S "fex-$_commit" -B build -G Ninja \
    -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ \
    -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
    -DUSE_LINKER=lld -DENABLE_LTO=ON -DENABLE_CCACHE=OFF -DTUNE_CPU=none \
    -DENABLE_OFFLINE_TELEMETRY=OFF -DBUILD_TESTING=OFF -DBUILD_THUNKS=OFF \
    -DOVERRIDE_VERSION="$_describe" -DOVERRIDE_HASH="$_commit" \
    -DROOTFS_PACKAGE=fex-emu-rootfs-arch
  cmake --build build
  # The Steam compatibility tool, as a separate portable build. It builds the
  # bundled fmt, whose directory asks for CMake 3.28 policies: C++20 module
  # scanning is on there, and CMake 4.5 then offers `import std`. It finds
  # libstdc++.modules.json through clang as /lib/..., resolves its relative
  # path to /include/c++/16.1.1/bits/std.cc (Arch's /lib is a link to
  # usr/lib) and fails to generate. Nothing here uses modules.
  cmake -S "fex-$_commit" -B steam-build -G Ninja \
    -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ \
    -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DUSE_LINKER=lld -DENABLE_CCACHE=OFF -DTUNE_CPU=none \
    -DBUILD_STEAM_SUPPORT=ON -DBUILD_THUNKS=OFF -DBUILD_TESTING=OFF -DBUILD_FEXCONFIG=OFF -DENABLE_OFFLINE_TELEMETRY=OFF \
    -DOVERRIDE_VERSION="$_describe" -DOVERRIDE_HASH="$_commit" \
    -DFMT_MODULE=OFF -DCMAKE_CXX_SCAN_FOR_MODULES=OFF
  cmake --build steam-build
  # Only the guest vDSO thunk (libVDSO-guest.so): x86_64 code that calls into
  # FEX itself and needs no host library. Shipping it inside fex-emu's bundle
  # keeps FEX and its guest vDSO in lockstep across fex-emu updates. thunkgen
  # runs natively on aarch64; VDSO-guest cross-compiles to x86_64 with clang
  # and lld (-nostdlib) using a build-local sysroot that exposes the host's
  # C/C++ headers (plus an empty gnu/stubs-64.h if absent) under the
  # x86_64-linux-gnu triple so clang and libclang resolve libstdc++ headers.
  local fex="$srcdir/fex-$_commit"
  mkdir -p thunkgen
  cat > thunkgen/CMakeLists.txt <<CMAKE
cmake_minimum_required(VERSION 3.14)
project(aurora-thunkgen C CXX)
set(CMAKE_CXX_STANDARD 20)
find_package(fmt REQUIRED)
add_subdirectory("$fex/ThunkLibs/Generator" generator)
CMAKE
  cmake -S thunkgen -B thunkgen-build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ \
    -DCMAKE_CXX_SCAN_FOR_MODULES=OFF
  cmake --build thunkgen-build --target thunkgen

  local gcc_dir gcc_ver host_triple sysroot="$srcdir/x86_64-sysroot" _p
  gcc_dir=$(dirname "$(gcc -print-libgcc-file-name)")
  gcc_ver=$(basename "$gcc_dir")
  host_triple=$(basename "$(dirname "$gcc_dir")")
  rm -rf "$sysroot"
  mkdir -p "$sysroot/usr/lib/gcc/x86_64-linux-gnu/$gcc_ver" \
           "$sysroot/usr/include/c++/$gcc_ver" \
           "$sysroot/usr/include/gnu"
  : > "$sysroot/usr/lib/gcc/x86_64-linux-gnu/$gcc_ver/crtbegin.o"
  for _p in /usr/include/*; do
    case "${_p##*/}" in
      c++|gnu) continue ;;
    esac
    ln -s "$_p" "$sysroot/usr/include/${_p##*/}"
  done
  for _p in "/usr/include/c++/$gcc_ver"/*; do
    ln -s "$_p" "$sysroot/usr/include/c++/$gcc_ver/${_p##*/}"
  done
  ln -sfn "/usr/include/c++/$gcc_ver/$host_triple" \
    "$sysroot/usr/include/c++/$gcc_ver/x86_64-linux-gnu"
  for _p in /usr/include/gnu/*; do
    ln -s "$_p" "$sysroot/usr/include/gnu/${_p##*/}"
  done
  [[ -e "$sysroot/usr/include/gnu/stubs-64.h" ]] || : > "$sysroot/usr/include/gnu/stubs-64.h"

  env -u CFLAGS -u CXXFLAGS -u CPPFLAGS -u LDFLAGS \
    cmake -S "$fex/ThunkLibs/GuestLibs" -B guest-thunks -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_SYSTEM_NAME=Linux -DCMAKE_SYSTEM_PROCESSOR=x86_64 \
    -DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY \
    -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ \
    -DCMAKE_C_COMPILER_TARGET=x86_64-linux-gnu \
    -DCMAKE_CXX_COMPILER_TARGET=x86_64-linux-gnu \
    -DCMAKE_SYSROOT="$sysroot" -DCMAKE_CXX_SCAN_FOR_MODULES=OFF \
    -DENABLE_CLANG_THUNKS=ON -DBITNESS=64 \
    -DFEX_PROJECT_SOURCE_DIR="$fex" -DX86_DEV_ROOTFS="$sysroot" \
    -DGENERATOR_EXE="$srcdir/thunkgen-build/generator/thunkgen"
  cmake --build guest-thunks --target VDSO-guest
}

check() {
  [[ $(build/Bin/FEXGetConfig --version) == "$_describe" ]]
  grep -qaF fex-emu-rootfs-arch build/Bin/FEX
  # FEX reads the runtime config aurora-fex-rootfs writes.
  grep -qaF /run/fex-emu/Config.json build/Bin/FEX
  # Flatpak sandboxes use isolated per-instance FEXServer sockets and lock files.
  grep -qaF .flatpak- build/Bin/FEX
  grep -qaF .flatpak- build/Bin/FEXServer
  grep -qaF 'Server{}.lock' build/Bin/FEXServer
  # Verify the cross-compiled guest vDSO thunk is a 64-bit x86-64 ELF.
  python3 -c 'import struct, sys
h = open(sys.argv[1], "rb").read(20)
assert len(h) == 20 and h[:6] == b"\x7fELF\x02\x01" and struct.unpack("<H", h[18:20])[0] == 62, h
' guest-thunks/libVDSO-guest.so
  readelf -d guest-thunks/libVDSO-guest.so | grep -qE 'Library soname: \[linux-vdso\.so\.1\]'
}

package_fex-emu() {
  # The global config's RootFS is fex-emu-rootfs-arch's image, which FEXServer
  # mounts with erofsfuse. pacman installs no optional dependencies, so both
  # are required for FEXBash to work after `pacman -S fex-emu`.
  # aurora-fex-rootfs mounts and checks the provider's bind (util-linux).
  depends=('glibc' 'gcc-libs' 'fmt' 'xxhash' 'squashfuse' 'squashfs-tools' 'erofs-utils'
           'erofsfuse' 'fex-emu-rootfs-arch' 'util-linux')
  install=fex-emu.install
  backup=('usr/share/fex-emu/Config.json')
  # Aurora's images carry mesa-aurora-fex-guest; it must match mesa-aurora, so
  # it can't be a dependency of fex-emu on systems with Arch's own Mesa.
  optdepends=('aurora-userpages: run FEX in 4 KiB page process trees on 16 KiB kernels'
              'mesa-aurora-fex-guest: Aurora x86 Mesa, the default RootFS while mounted'
              'qt6-declarative: FEXConfig'
              'sdl2-compat: FEXConfig')
  # Takes over the Asahi ALARM FEX-Emu package: pacman -Syu replaces it, and
  # anything that asks for FEX-Emu gets this build. No transitional FEX-Emu
  # package: its file name differs from fex-emu's only in case, and release
  # assets are case-insensitive, so the testing snapshot cannot carry both.
  provides=("FEX-Emu=$pkgver-$pkgrel")
  conflicts=('FEX-Emu')
  replaces=('FEX-Emu')
  DESTDIR="$pkgdir" cmake --install build
  # One FEX for every x86 program: a copy with its own loader and libraries at
  # the path where the x86_64 GL.aurora Flatpak extension carries the same
  # tree, so it also starts inside x86_64 sandboxes. These are the only
  # binfmt_misc registrations for x86 and x86-64; with flag F the kernel opens
  # the interpreter when it registers, so the path need not exist in the
  # sandbox for the kernel, only for FEX's loader and libraries.
  bash fex-bundle build "$pkgdir/usr/lib/x86_64-linux-gnu/GL/aurora/fex"
  install -Dm644 guest-thunks/libVDSO-guest.so \
    "$pkgdir/usr/lib/x86_64-linux-gnu/GL/aurora/fex/GuestThunks/libVDSO-guest.so"
  install -Dm644 FEX-x86.conf "$pkgdir/usr/lib/binfmt.d/FEX-x86.conf"
  install -Dm644 FEX-x86_64.conf "$pkgdir/usr/lib/binfmt.d/FEX-x86_64.conf"
  install -dm755 "$pkgdir/usr/share/fex-emu/RootFS" "$pkgdir/usr/share/fex-emu/overlays"
  # The global config (a user's own Config.json overrides it).
  install -Dm644 Config.json "$pkgdir/usr/share/fex-emu/Config.json"
  install -Dm644 "fex-$_commit/LICENSE" "$pkgdir/usr/share/licenses/fex-emu/LICENSE"
  install -Dm644 README.aurora "$pkgdir/usr/share/doc/fex-emu/README.aurora"
  # The stock guest root filesystem below mesa-aurora-fex-guest's Aurora Mesa
  # layer (the Steam FEX graphics provider); no package provided that tree.
  # makepkg mishandles the escaped unit name as a source file name.
  install -Dm644 fex-guest-rootfs.mount "$pkgdir/usr/lib/systemd/system/usr-share-guestos-fex\x2dmesa.mount"
  install -Dm644 50-aurora-fex-rootfs.conf "$pkgdir/usr/lib/systemd/system/aurora-fex-mesa.service.d/50-aurora-fex-rootfs.conf"
  install -Dm755 aurora-fex-provider-up "$pkgdir/usr/lib/fex-emu/aurora-fex-provider-up"
  install -Dm644 70-aurora-fex-provider.hook "$pkgdir/usr/share/libalpm/hooks/70-aurora-fex-provider.hook"
  # FEX's global RootFS follows the provider (see README.aurora).
  install -Dm755 aurora-fex-rootfs "$pkgdir/usr/lib/fex-emu/aurora-fex-rootfs"
  install -Dm644 71-aurora-fex-rootfs.hook "$pkgdir/usr/share/libalpm/hooks/71-aurora-fex-rootfs.hook"
  install -d "$pkgdir/usr/share/guestos/fex-mesa"
}

package_fex-emu-steam() {
  pkgdesc='FEX as a Steam compatibility tool, "FEX (Aurora)" (Aurora build)'
  depends=('glibc' 'gcc-libs')
  local tool="$pkgdir/usr/share/steam/compatibilitytools.d/fex-aurora"
  DESTDIR="$tool" cmake --install steam-build
  install -Dm644 compatibilitytool.vdf "$tool/compatibilitytool.vdf"
  # toolmanifest.vdf starts /fex-compat-tool in the tool's root.
  ln -s FEXCompatTool "$tool/fex-compat-tool"
  install -Dm644 "fex-$_commit/LICENSE" "$pkgdir/usr/share/licenses/fex-emu-steam/LICENSE"
}
