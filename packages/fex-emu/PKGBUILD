noextract=()
for _b in "${_bundled[@]}"; do
  read -r _n _r _c _p <<<"$_b"
  noextract+=("$_n-$_c.tar.gz")
done

prepare() {
  cd "fex-$_commit"
  local _b _n _r _c _p
  for _b in "${_bundled[@]}"; do
    read -r _n _r _c _p <<<"$_b"
    mkdir -p "$_p"
    tar -xzf "$srcdir/$_n-$_c.tar.gz" --strip-components=1 -C "$_p"
  done
  # Names fex-emu-rootfs-arch when the RootFS is missing.
  patch -Np1 -i "$srcdir/0001-FEXInterpreter-name-the-distribution-RootFS-package.patch"
  # erofsfuse can't serve /dev/fuse from a 4 KiB page tree; FEXServer starts
  # it with native pages.
  patch -Np1 -i "$srcdir/0002-FEXServer-run-the-RootFS-image-FUSE-helper-with-native-pages.patch"
}

build() {
  # FEX tunes for the build machine by default (-mcpu from its /proc/cpuinfo),
  # which crashes with SIGILL on Apple CPUs when CI builds on Neoverse.
  cmake -S "fex-$_commit" -B build -G Ninja \
    -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ \
    -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
    -DUSE_LINKER=lld -DENABLE_LTO=ON -DENABLE_CCACHE=OFF -DTUNE_CPU=none \
    -DENABLE_OFFLINE_TELEMETRY=OFF -DBUILD_TESTING=OFF -DBUILD_THUNKS=OFF \
    -DOVERRIDE_VERSION="$_describe" -DOVERRIDE_HASH="$_commit" \
    -DROOTFS_PACKAGE=fex-emu-rootfs-arch
  cmake --build build
  # The Steam compatibility tool, as a separate portable build.
  cmake -S "fex-$_commit" -B steam-build -G Ninja \
    -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ \
    -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DUSE_LINKER=lld -DENABLE_CCACHE=OFF -DTUNE_CPU=none \
    -DBUILD_STEAM_SUPPORT=ON -DBUILD_THUNKS=OFF -DBUILD_TESTING=OFF -DBUILD_FEXCONFIG=OFF -DENABLE_OFFLINE_TELEMETRY=OFF \
    -DOVERRIDE_VERSION="$_describe" -DOVERRIDE_HASH="$_commit"
  cmake --build steam-build
}

check() {
  [[ $(build/Bin/FEXGetConfig --version) == "$_describe" ]]
  grep -qaF fex-emu-rootfs-arch build/Bin/FEX
}

package_fex-emu() {
  # The global config's RootFS is fex-emu-rootfs-arch's image, which FEXServer
  # mounts with erofsfuse. pacman installs no optional dependencies, so both
  # are required for FEXBash to work after `pacman -S fex-emu`.
  depends=('glibc' 'gcc-libs' 'fmt' 'xxhash' 'squashfuse' 'squashfs-tools' 'erofs-utils'
           'erofsfuse' 'fex-emu-rootfs-arch')
  install=fex-emu.install
  backup=('usr/share/fex-emu/Config.json')
  optdepends=('aurora-userpages: run FEX in 4 KiB page process trees on 16 KiB kernels'
              'qt6-declarative: FEXConfig'
              'sdl2-compat: FEXConfig')
  # Takes over the Asahi ALARM FEX-Emu package: pacman -Syu replaces it, and
  # anything that asks for FEX-Emu gets this build. No transitional FEX-Emu
  # package: its file name differs from fex-emu's only in case, and release
  # assets are case-insensitive, so the testing snapshot cannot carry both.
  provides=("FEX-Emu=$pkgver-$pkgrel")
  conflicts=('FEX-Emu')
  replaces=('FEX-Emu')
  DESTDIR="$pkgdir" cmake --install build
  install -dm755 "$pkgdir/usr/share/fex-emu/RootFS" "$pkgdir/usr/share/fex-emu/overlays"
  # The global config (a user's own Config.json overrides it).
  install -Dm644 Config.json "$pkgdir/usr/share/fex-emu/Config.json"
  install -Dm644 "fex-$_commit/LICENSE" "$pkgdir/usr/share/licenses/fex-emu/LICENSE"
  install -Dm644 README.aurora "$pkgdir/usr/share/doc/fex-emu/README.aurora"
  # The stock guest root filesystem below mesa-aurora-fex-guest's Aurora Mesa
  # layer (the Steam FEX graphics provider); no package provided that tree.
  # makepkg mishandles the escaped unit name as a source file name.
  install -Dm644 fex-guest-rootfs.mount "$pkgdir/usr/lib/systemd/system/usr-share-guestos-fex\x2dmesa.mount"
  install -Dm644 50-aurora-fex-rootfs.conf "$pkgdir/usr/lib/systemd/system/aurora-fex-mesa.service.d/50-aurora-fex-rootfs.conf"
  install -Dm755 aurora-fex-provider-up "$pkgdir/usr/lib/fex-emu/aurora-fex-provider-up"
  install -Dm644 70-aurora-fex-provider.hook "$pkgdir/usr/share/libalpm/hooks/70-aurora-fex-provider.hook"
  install -d "$pkgdir/usr/share/guestos/fex-mesa"
}

package_fex-emu-steam() {
  pkgdesc='FEX as a Steam compatibility tool, "FEX (Aurora)" (Aurora build)'
  depends=('glibc' 'gcc-libs')
  local tool="$pkgdir/usr/share/steam/compatibilitytools.d/fex-aurora"
  DESTDIR="$tool" cmake --install steam-build
  install -Dm644 compatibilitytool.vdf "$tool/compatibilitytool.vdf"
  # toolmanifest.vdf starts /fex-compat-tool in the tool's root.
  ln -s FEXCompatTool "$tool/fex-compat-tool"
  install -Dm644 "fex-$_commit/LICENSE" "$pkgdir/usr/share/licenses/fex-emu-steam/LICENSE"
}
