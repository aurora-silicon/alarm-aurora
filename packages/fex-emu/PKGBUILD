# FEX from Aurora's fork. Replaces the Asahi ALARM FEX-Emu package; the
# fork's submodules are pinned at its gitlinks (sources.json extra_sources).
pkgbase=fex-emu
pkgname=(fex-emu fex-emu-steam)
pkgver=2610.r202611250455.05d2618882d
pkgrel=3
pkgdesc='Fast usermode x86 and x86-64 emulator for ARM64 (Aurora build)'
arch=('aarch64')
url='https://github.com/aurora-silicon/fex'
license=('MIT' 'Apache-2.0' 'BSL-1.0' 'BSD-3-Clause' 'GPL-2.0-only')
_commit=05d2618882d41bca4492ccb0385919121bee20cd
_sha256=b93abcd9f2fa3e2fc1e2ce8a1dc8e84e9ebd510ddd01ea739ad23f890f91a3a1
_describe=FEX-${pkgver%%.r*}-aurora-g${_commit::7}
makedepends=('cmake' 'ninja' 'clang' 'lld' 'llvm' 'openssl' 'patchelf' 'python' 'python-setuptools' 'python-packaging'
             'fmt' 'xxhash' 'catch2' 'libepoxy' 'sdl2-compat' 'qt6-declarative' 'pkgconf')
_bundled=(
  'cpp-optparse Sonicadvance1/cpp-optparse 9f94388a339fcbb0bc95c17768eb786c85988f6e Source/Common/cpp-optparse'
  'drm-headers FEX-Emu/drm-headers 3e49836995c1dcb3df709440ad2f270b569c6a5f External/drm-headers'
  'jemalloc FEX-Emu/jemalloc 8436195ad5e1bc347d9b39743af3d29abee59f06 External/jemalloc_glibc'
  'range-v3 ericniebler/range-v3 ca1388fb9da8e69314dda222dc7b139ca84e092f External/range-v3'
  'rpmalloc FEX-Emu/rpmalloc ed227446afce6ff505b312bae1e10a3daaeeea39 External/rpmalloc'
  'Vulkan-Headers KhronosGroup/Vulkan-Headers ee2ec5fd83dafce291024683b50dc89219333076 External/Vulkan-Headers'
  'vixl FEX-Emu/vixl 6561d40650885ad24fbd0aa0cdb20ccb4808d444 External/vixl'
  'unordered_dense martinus/unordered_dense 3234af2c03549bc85656bfd3a86993bf1cd8aef1 External/unordered_dense'
  # The Steam compatibility tool build bundles fmt and xxHash.
  'fmt fmtlib/fmt c07e2aa4b130b4fd359a1c6455a5201b17af01fa External/fmt'
  'xxHash Cyan4973/xxHash e626a72bc2321cd320e953a0ccf1584cad60f363 External/xxhash'
)
source=("fex-$_commit.tar.gz::https://codeload.github.com/aurora-silicon/fex/tar.gz/$_commit")
for _b in "${_bundled[@]}"; do
  read -r _n _r _c _p <<<"$_b"
  source+=("$_n-$_c.tar.gz::https://codeload.github.com/$_r/tar.gz/$_c")
done
source+=(README.aurora fex-guest-rootfs.mount 50-aurora-fex-rootfs.conf aurora-fex-provider-up 70-aurora-fex-provider.hook compatibilitytool.vdf
         Config.json 0001-FEXInterpreter-name-the-distribution-RootFS-package.patch
         0002-FEXServer-run-the-RootFS-image-FUSE-helper-with-native-pages.patch
         0003-Config-read-a-runtime-system-config-over-the-global-one.patch
         0004-FEXServerClient-isolate-flatpak-sandbox-socket.patch
         aurora-fex-rootfs 71-aurora-fex-rootfs.hook
         fex-bundle FEX-x86.conf FEX-x86_64.conf)
