  'rpmalloc FEX-Emu/rpmalloc ed227446afce6ff505b312bae1e10a3daaeeea39 External/rpmalloc'
  'Vulkan-Headers KhronosGroup/Vulkan-Headers ee2ec5fd83dafce291024683b50dc89219333076 External/Vulkan-Headers'
  'vixl FEX-Emu/vixl 6561d40650885ad24fbd0aa0cdb20ccb4808d444 External/vixl'
  'unordered_dense martinus/unordered_dense 3234af2c03549bc85656bfd3a86993bf1cd8aef1 External/unordered_dense'
  # The Steam compatibility tool build bundles fmt and xxHash.
  'fmt fmtlib/fmt c07e2aa4b130b4fd359a1c6455a5201b17af01fa External/fmt'
  'xxHash Cyan4973/xxHash e626a72bc2321cd320e953a0ccf1584cad60f363 External/xxhash'
