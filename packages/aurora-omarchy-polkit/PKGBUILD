pkgname=aurora-omarchy-polkit
pkgver=1
pkgrel=1
pkgdesc='Optional Omarchy polkit password-switch companion for Aurora'
arch=('aarch64')
url='https://github.com/aurora-silicon/alarm-aurora'
license=('MIT')
# Clean ALARM builders have stock fprintd, not the unpublished PR package.
depends=('fprintd' 'qt6-declarative' 'qt6-base' 'python' 'quickshell')
makedepends=('make')
source=('fingerprintcancel.cpp' 'fingerprintcancel.pro' 'qmldir' 'aurora-polkit-pam' 'aurora-omarchy-polkit.hook' 'README.md' 'LICENSE' 'PolkitAgent.qml' 'PolkitModel.js' 'FingerprintCancelSender.qml' 'manifest.json')
sha256sums=('76812d7c2611d98a016393719397aae8c1c9d20f9d9a4159758b963c7600c325'
            '9f1456390ee6995067ab997308a7892b29ecac530a0dd41da5a7ae241d999850'
            'f1141cd355267931a465610ef72ec1aea89c3b2ca931214bebc70a210c946577'
            '5c78172e3189e1ab710401259810f46d9d4338d0a95f6b52b50ff231125c2ad1'
            '02ad577ce7f3fc2d6592c8269d4fc771880c8f8503497816f813bad93b5f588f'
            '3dfbd504b3dfa4e32d80b868bf82199ff4455020e156f965f405ae07ed0b2193'
            '717ba1949502290f8e47688ae2e323acd06c8ca47aec9f7596b15f678c1af4a2'
            '13cba73efa59de72c94c83f1a48ec51095752a797496c48e6d25075b80ef90c3'
            '29c0b96b25fea18d8dcc1e61912f8906ff75c599b07f9bf8b0f8cc4f6fb985c9'
            '5aeaa0c56cb5f803848e0f10f0e5178aeb012fab47d90acffa8bb12f7b911cd4'
            '70cab3efcda0c01335d29c1746e1824b208f55758af044702ed800d99dbddcae')

build() {
  mkdir -p build
  cd build
  qmake6 "$srcdir/fingerprintcancel.pro"
  make
}

package() {
  # The installed bridge requires the patched PAM module from this PR.
  depends=('fprintd-aurora>=1.94.5-5' 'qt6-declarative' 'qt6-base' 'python' 'quickshell')
  install -Dm755 build/libaurorapasswordswitch.so "$pkgdir/usr/lib/qt6/qml/Aurora/PasswordSwitch/libaurorapasswordswitch.so"
  install -Dm644 qmldir "$pkgdir/usr/lib/qt6/qml/Aurora/PasswordSwitch/qmldir"
  install -Dm755 aurora-polkit-pam "$pkgdir/usr/bin/aurora-polkit-pam"
  install -Dm644 aurora-omarchy-polkit.hook "$pkgdir/usr/share/libalpm/hooks/aurora-omarchy-polkit.hook"
  for file in PolkitAgent.qml PolkitModel.js FingerprintCancelSender.qml manifest.json; do
    install -Dm644 "$file" "$pkgdir/usr/share/aurora-omarchy-polkit/plugin/$file"
  done
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
