post_install() {
  # Listen now: touchid-pam has put the module after pam_unix already.
  systemctl preset aurora-touchid-rearm.socket >/dev/null 2>&1 || :
  if [ -d /run/systemd/system ] && systemctl -q is-enabled aurora-touchid-rearm.socket 2>/dev/null; then
    systemctl start aurora-touchid-rearm.socket >/dev/null 2>&1 || :
  fi
}

pre_remove() {
  systemctl disable --now aurora-touchid-rearm.socket >/dev/null 2>&1 || :
}
