# Maintainer: Daniel Bermond <dbermond@archlinux.org>
# Arch's VMAF 3.2.1-1 recipe for ALARM, with required model embedding.

pkgname=vmaf
pkgver=3.2.1
pkgrel=1.1
pkgdesc='Perceptual video quality assessment algorithm based on multi-method fusion'
arch=('aarch64')
url='https://github.com/Netflix/vmaf/'
license=('BSD-2-Clause-Patent')
depends=(
    'glibc'
    'libgcc'
    'libstdc++')
makedepends=(
    'meson'
    'xxd')
source=("https://github.com/Netflix/vmaf/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz"
        'check-default-model.c')
sha256sums=('5df7386911bc15fd1ca783132528748d219768ae4fc5f8e0b61184f041648092'
            '69da883c09f640e4f4579425d36072e4ed6fb28ddaea33c3e7d08441b67049db')

build() {
    arch-meson -Denable_avx512='false' "${pkgname}-${pkgver}/libvmaf" build
    meson compile -C build
}

check() {
    meson test -C build

    # Load by version from this build, without a JSON path or installed libvmaf.
    cc $CFLAGS $CPPFLAGS -I"${pkgname}-${pkgver}/libvmaf/include" \
        check-default-model.c -o build/check-default-model \
        $LDFLAGS -Wl,-rpath,"$srcdir/build/src" build/src/libvmaf.so
    build/check-default-model
}

package() {
    meson install -C build --destdir "$pkgdir"
    install -D -m644 "${pkgname}-${pkgver}/LICENSE" -t "${pkgdir}/usr/share/licenses/${pkgname}"
    cp -dr --no-preserve='ownership' "${pkgname}-${pkgver}/model" "${pkgdir}/usr/share"
}
