# Maintainer: Maxime Gauduin <alucryd@archlinux.org>
# Contributor: Bartłomiej Piotrowski <bpiotrowski@archlinux.org>
# Contributor: Ionut Biru <ibiru@archlinux.org>
# Contributor: Tom Newsom <Jeepster@gmx.co.uk>
# Contributor: Paul Mattal <paul@archlinux.org>

# ALARM: Kevin Mihelich <kevin@archlinuxarm.org>
#  - set --enable-nvenc, --enable-nvdec for AArch64 only
#  - remove optdepends on intel-media-sdk, onevpl-intel-gpu
#  - remove depends on onevpl, remove --enable-libvpl
#  - remove depends on vmaf, remove --enable-vmaf
#  - remove depends on rav1e, remove --enable-librav1e
#  - remove depends on svt-av1, remove --enable-libsvtav1
#  - remove --enable-lto
#
# Arch Linux ARM's FFmpeg recipe (archlinuxarm/PKGBUILDs extra/ffmpeg at
# ec02fa994e769d6a1ebd4c5bd92834d4c0a9665e, 2:9.0.2-5) for aarch64 with the
# Aurora V4L2 mem2mem ProRes decoder and encoder (prores_v4l2m2m, for the
# ProRes engine of Apple silicon Macs) and the V4L2 buffer and raw format
# fixes it needs; fedora-aurora's ffmpeg carries the same patches. V4L2
# mem2mem is enabled explicitly, so configure fails instead of building
# without it.
# pkgrel 5.1 sorts above ALARM's 5 and [aurora] precedes [extra] in
# pacman.conf, so pacman keeps this build even after ALARM rebuilds FFmpeg;
# rebuild it here when ALARM moves (a new release or a library soname).
# The source is the tag ALARM builds, pinned by its checksum; makepkg does
# not verify the tag signature (?signed), as the builders have no keyring
# for it.

pkgname=ffmpeg
pkgver=9.0.2
pkgrel=5.1
epoch=2
pkgdesc='Complete solution to record, convert and stream audio and video'
arch=(aarch64)
url=https://ffmpeg.org
license=(GPL-3.0-only)
depends=(
  alsa-lib
  aom
  bzip2
  cairo
  dav1d
  fontconfig
  freetype2
  fribidi
  glib2
  glibc
  gmp
  gnutls
  gsm
  harfbuzz
  jack
  lame
  lcms2
  libass
  libavc1394
  libbluray
  libbs2b
  libdrm
  libdvdnav
  libdvdread
  libgcc
  libgl
  libiec61883
  libjxl
  libmodplug
  libopenmpt
  libplacebo
  libpulse
  libraw1394
  librsvg
  libsoxr
  libssh
  libtheora
  libva
  libvdpau
  libvorbis
  libvpx
  libwebp
  libx11
  libxcb
  libxext
  libxml2
  libxv
  ocl-icd
  opencore-amr
  openjpeg2
  opus
  rubberband
  sdl2
  snappy
  sndio
  speex
  srt
  v4l-utils
  vapoursynth
  vid.stab
  vulkan-icd-loader
  x264
  x265
  xvidcore
  xz
  zeromq
  zimg
  zlib
)
makedepends=(
  amf-headers
  avisynthplus
  clang
  ffnvcodec-headers
  frei0r-plugins
  git
  ladspa
  mesa
  nasm
  opencl-headers
  spirv-headers
  vulkan-headers
)
optdepends=(
  'avisynthplus: AviSynthPlus support'
  'frei0r-plugins: Frei0r video effects support'
  'ladspa: LADSPA filters'
  'nvidia-utils: Nvidia NVDEC/NVENC support'
)
provides=(
  libavcodec.so
  libavdevice.so
  libavfilter.so
  libavformat.so
  libavutil.so
  libswresample.so
  libswscale.so
)
source=(
  git+https://git.ffmpeg.org/ffmpeg.git#tag=n${pkgver}
  0001-Add-av_stream_get_first_dts-for-Chromium.patch
  # Aurora: V4L2 mem2mem ProRes (prores_v4l2m2m) and the V4L2 fixes it needs
  0001-avcodec-v4l2_buffers-use-the-driver-s-strides-for-si.patch
  0002-avcodec-v4l2_context-pick-the-raw-V4L2-format-the-dr.patch
  0003-avcodec-v4l2_m2m-add-ProRes-decoder-and-encoder.patch
)
b2sums=('97bd244a79088e862f349ef91ae75f7a02c1a0c8c1e21601abf6fa5acae1d721d104c2afa4e6e955d7caf18ffd511c175b1a3965b99cc1122754f191b9098bc5'
        'e5f7b79f7731be9ee5a7280a9221fb531ac5a2d9820fc5870b68b0eabea667dfbe8f39f41c1e1763a4c84982896afaa54c81ff57847d203b70afafd726689e5d'
        '42de05640ab20be1d00677d0f4c0f926d3af611131eb10dc041160c32224b05dd1c42ccc7ac28ff0e29921b32a4ad5f5ed69eced54c3f83531dbc643cafedbe8'
        '53261ef3d469f6cfca2af1950efc3947c03bca6e772f882a64c4a5d67668773b204c14ccb580e1cfe04569f63c5ccaf42ce8a1645da8d7ee3db98929dbbfd6bf'
        '2aebdc37b5634068cbb6e9d3b68aef15f5e44c53a1c767558fd86b33a7f78883ec559a1589d9a78190902c18b99908f21f4f5c5f073dc4caac3de183d65b89f0')

prepare() {
  cd ffmpeg

  # https://crbug.com/1251779
  git apply -3 ../0001-Add-av_stream_get_first_dts-for-Chromium.patch

  # Aurora: V4L2 mem2mem ProRes decoder and encoder (prores_v4l2m2m)
  git apply -3 ../0001-avcodec-v4l2_buffers-use-the-driver-s-strides-for-si.patch
  git apply -3 ../0002-avcodec-v4l2_context-pick-the-raw-V4L2-format-the-dr.patch
  git apply -3 ../0003-avcodec-v4l2_m2m-add-ProRes-decoder-and-encoder.patch
}

build() {
  export PKG_CONFIG_PATH='/usr/lib/mbedtls2/pkgconfig'
  cd ffmpeg
  ./configure \
    --prefix=/usr \
    --disable-debug \
    --disable-static \
    --disable-stripping \
    --enable-amf \
    --enable-avisynth \
    --enable-cuda-llvm \
    --enable-fontconfig \
    --enable-frei0r \
    --enable-gmp \
    --enable-gnutls \
    --enable-gpl \
    --enable-ladspa \
    --enable-libaom \
    --enable-libass \
    --enable-libbluray \
    --enable-libbs2b \
    --enable-libdav1d \
    --enable-libdrm \
    --enable-libdvdnav \
    --enable-libdvdread \
    --enable-libfreetype \
    --enable-lcms2 \
    --enable-libfribidi \
    --enable-libgsm \
    --enable-libharfbuzz \
    --enable-libiec61883 \
    --enable-libjack \
    --enable-libjxl \
    --enable-libmodplug \
    --enable-libmp3lame \
    --enable-libopencore_amrnb \
    --enable-libopencore_amrwb \
    --enable-libopenjpeg \
    --enable-libopenmpt \
    --enable-libopus \
    --enable-libplacebo \
    --enable-libpulse \
    --enable-librsvg \
    --enable-librubberband \
    --enable-libsnappy \
    --enable-libsoxr \
    --enable-libspeex \
    --enable-libsrt \
    --enable-libssh \
    --enable-libtheora \
    --enable-libv4l2 \
    --enable-libvidstab \
    --enable-libvorbis \
    --enable-libvpx \
    --enable-libwebp \
    --enable-libx264 \
    --enable-libx265 \
    --enable-libxcb \
    --enable-libxml2 \
    --enable-libxvid \
    --enable-libzimg \
    --enable-libzmq \
    $([[ $CARCH == aarch64 ]] && echo "--enable-nvdec --enable-nvenc") \
    --enable-opencl \
    --enable-opengl \
    --enable-shared \
    --enable-v4l2-m2m \
    --enable-vapoursynth \
    --enable-version3 \
    --enable-vulkan \
    --disable-decoder=magicyuv # pixelsmash
  make
  make tools/qt-faststart
  make doc/ff{mpeg,play}.1
}

package() {
  depends+=(
    libass.so
#   libbluray.so
    libbs2b.so
    libdav1d.so
    libfreetype.so
    libharfbuzz.so
#   libjxl.so
    libopenmpt.so
#    libplacebo.so
    librsvg-2.so
    librubberband.so
    libva.so
    libva-drm.so
    libva-x11.so
    libvidstab.so
    libvorbisenc.so
    libvorbis.so
    libvpx.so
    libx264.so
#   libx265.so
    libxvidcore.so
    libzimg.so
    libzmq.so
  )

  make DESTDIR="${pkgdir}" -C ffmpeg install install-man
  install -Dm 755 ffmpeg/tools/qt-faststart "${pkgdir}"/usr/bin/
}

