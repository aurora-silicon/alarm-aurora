# Maintainer: Matthias Kurz <m.kurz@irregular.at>

# asahi-alarm's recipe (asahi-alarm/PKGBUILDs 8648855) with the unit mode fix
# from AsahiLinux/asahi-scripts#75 and Aurora's update-m1n1, which replaces the
# tag's copy: on Mach-O Macs it writes boot-ctxr.bin and never touches boot.bin.
# The aurora repository is listed first, so this shadows asahi-alarm's updates.
#
# update-m1n1 is Fedora's trial-then-commit Stage 2 updater
# (aurora-silicon/fedora-aurora#193, #207, #232, #251): bootchain.py and test_bootchain.py are
# fedora-aurora's packages/update-m1n1 files byte for byte, as are the units and
# the preset; bootchain_arch.py only gives them Arch's paths. A kernel update
# composes <stage2>.next, arms aura's one-shot aura-try and keeps the live image
# until aurora-stage2-commit.service accepts the trial boot. The hook replaces
# the tag's 95-m1n1-install.hook so that a kernel removal runs it too. Each
# composed Stage 2 goes through aurora-secboot's "stage2 hook" when that is
# installed, which signs it with the owner's Stage 2 key for an owner-key
# Stage 1; the stage2-sign-hook marker tells aurora-secboot stage1 build so.
pkgname=asahi-scripts
pkgver=20261023
pkgrel=10
pkgdesc='Asahi Linux maintenance scripts'
arch=('any')
url='http://asahilinux.org'
license=('MIT')
depends=('bash' 'coreutils' 'dtc' 'gzip' 'python' 'util-linux')
checkdepends=('dtc' 'python')
# aura requires aurora-stage2-ctxr-slot: an aura without the monitor must never
# reach boot.bin through a stock update-m1n1, whatever its version. The kernel,
# aura and U-Boot require aurora-stage2-trial, this trial-aware updater.
provides=('aurora-stage2-ctxr-slot=1' 'aurora-stage2-trial=1')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/asahi-alarm/${pkgname}/archive/refs/tags/${pkgver}.tar.gz"
        0001-Makefile-Install-macsmc-battery-systemd-units-with-mode-0644.patch
        0002-macsmc-battery-debounce-persistence.patch
        battery-charge-limit-save
        update-m1n1
        95-m1n1-install.hook
        bootchain.py
        bootchain_arch.py
        test_bootchain.py
        test_bootchain_arch.py
        aurora-stage2-commit
        aurora-stage2-commit.service
        aurora-stage2-guard.service
        aurora-stage2-guard.timer
        90-aurora-stage2.preset)
install=asahi-scripts.install
sha256sums=('64c7e8d50f7ad37d58a64d1f1bc7c8848d7507093f40172e6dbce75c72b26ce4'
