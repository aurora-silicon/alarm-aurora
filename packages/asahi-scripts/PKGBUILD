prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  # systemd warns on every boot about unit files marked executable.
  patch -p1 < "${srcdir}/0001-Makefile-Install-macsmc-battery-systemd-units-with-mode-0644.patch"
  install -m755 "${srcdir}/update-m1n1" update-m1n1
  install -m644 "${srcdir}/95-m1n1-install.hook" libalpm/hooks/95-m1n1-install.hook
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make PREFIX=/usr DESTDIR=${pkgdir} all
}

check() {
  cd "${srcdir}"

  python3 test_bootchain.py
  python3 test_bootchain_arch.py
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make PREFIX=/usr DESTDIR=${pkgdir} install-arch
  install -Dm644 "$srcdir/${pkgname}-${pkgver}/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  cd "${srcdir}"
  install -Dm644 -t "$pkgdir/usr/libexec/aurora" bootchain.py bootchain_arch.py
  install -Dm755 aurora-stage2-commit "$pkgdir/usr/libexec/aurora/aurora-stage2-commit"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" aurora-stage2-commit.service \
    aurora-stage2-guard.service aurora-stage2-guard.timer
  install -Dm644 90-aurora-stage2.preset "$pkgdir/usr/lib/systemd/system-preset/90-aurora-stage2.preset"
}
