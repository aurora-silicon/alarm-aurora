# Aurora's copy of asahi-scripts' hook: it also runs after a kernel removal,
# so dropping a kernel that needs an older DT ABI generation lets the newest
# kernel's trees through, as Fedora's kernel-install remove does.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/modules/*/dtbs/*
Target = usr/lib/modules/*/dtb-abi
Target = usr/lib/asahi-boot/*

[Action]
Description = Updating m1n1 image...
When = PostTransaction
Exec = /usr/bin/update-m1n1
