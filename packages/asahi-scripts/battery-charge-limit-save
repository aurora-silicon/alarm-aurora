#!/bin/sh
set -eu

value=$(cat /sys/class/power_supply/macsmc-battery/charge_control_end_threshold)
case "$value" in
    80|100) ;;
    *) exit 1 ;;
esac
line="CHARGE_CONTROL_END_THRESHOLD=$value"
saved=/etc/udev/macsmc-battery.conf
if [ "$(cat "$saved" 2>/dev/null || :)" = "$line" ]; then
    exit 0
fi

# Publish on the same filesystem; never persist an empty or partial value.
umask 022
tmp=$(mktemp /etc/udev/.macsmc-battery.conf.XXXXXX)
trap 'rm -f "$tmp"' 0
trap 'exit 1' HUP INT TERM
printf '%s\n' "$line" > "$tmp"
chmod 644 "$tmp"
mv -f "$tmp" "$saved"
